@page
@model ExternalLoginModel
@{
    ViewData["Title"] = "Konto verknüpfen";
}
<header>
    <link rel="stylesheet" href="css/login.css"/>
</header>
<div class="auth-card-container">
    <div class="auth-card">
        
        <div class="status-icon">
            🤝
        </div>

        <h1>@ViewData["Title"]</h1>
        
        <div class="status-message-wrapper">
            <p>
                Du hast dich erfolgreich mit <strong>@Model.ProviderDisplayName</strong> authentifiziert.<br /><br />
                Bitte bestätige oder ändere die E-Mail-Adresse für dein lokales Profil und klicke auf Registrieren, um den Vorgang abzuschließen.
            </p>
        </div>

        <form asp-page-handler="Confirmation" asp-route-returnUrl="@Model.ReturnUrl" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger mb-3" role="alert"></div>
            
            <div class="form-floating mb-4 text-start">
                <input asp-for="Input.Email" class="form-control" autocomplete="email" placeholder="Bitte gib deine E-Mail ein." />
                <label asp-for="Input.Email" class="text-muted">E-Mail-Adresse</label>
                <span asp-validation-for="Input.Email" class="text-danger small"></span>
            </div>
            
            <button type="submit" class="btn-primary w-100 border-0">Registrierung abschließen</button>
        </form>

    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}