@page
@model LoginModel

@{
    ViewData["Title"] = "Login";
}

<link rel="stylesheet" href="~/css/areas/login.css" asp-append-version="true"/>

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-title">@ViewData["Title"]</h1>

        <div class="auth-layout">
            <div class="auth-local">
                <section>
                    <form id="account" method="post">
                        <h2 class="auth-subtitle">Verwenden ein lokales Konto</h2>

                        <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                        <div class="form-group">
                            <label asp-for="Input.Email" class="form-label">E-mail Adresse</label>
                            <input asp-for="Input.Email" class="form-input" autocomplete="username" aria-required="true"
                                   placeholder="name@example.com"/>
                            <span asp-validation-for="Input.Email" class="validation-error"></span>
                        </div>

                        <div class="form-group">
                            <label asp-for="Input.Password" class="form-label">Passwort</label>
                            <input asp-for="Input.Password" class="form-input" autocomplete="current-password"
                                   aria-required="true" placeholder="••••••••"/>
                            <span asp-validation-for="Input.Password" class="validation-error"></span>
                        </div>

                        <div class="checkbox-group">
                            <label asp-for="Input.RememberMe" class="checkbox-label">
                                <input class="checkbox-input" asp-for="Input.RememberMe"/>
                                @Html.DisplayNameFor(m => m.Input.RememberMe)
                            </label>
                        </div>

                        <button id="login-submit" type="submit" class="btn-submit">Login</button>

                        <div class="auth-links">
                            <a id="forgot-password" asp-page="./ForgotPassword">Passwort vergessen?</a>
                            <a asp-page="./Register" asp-route-returnUrl="@Model.ReturnUrl">Zur Registrierung</a>
                            @* <a id="resend-confirmation" asp-page="./ResendEmailConfirmation">Resend email *@
                            @*     confirmation</a> *@
                        </div>
                    </form>
                </section>
            </div>

            <div class="auth-external">
                <section>
                    <h2 class="auth-subtitle">Nutze einen anderen Dienst</h2>
                    @{
                        if ((Model.ExternalLogins?.Count ?? 0) == 0)
                        {
                            <div class="external-empty">
                                <p>Es sind keine externen Authentifizierungsdienste konfiguriert.</p>
                                <a href="https://go.microsoft.com/fwlink/?LinkID=532715">Erfahre wie dies einzurichten ist.</a>.
                            </div>
                        }
                        else
                        {
                            <form id="external-account" asp-page="./ExternalLogin"
                                  asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <div class="external-buttons">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" class="btn-external" name="provider"
                                                value="@provider.Name"
                                                title="Log in using your @provider.DisplayName account">
                                            Weiter mit @provider.DisplayName
                                        </button>
                                    }
                                </div>
                            </form>
                        }
                    }
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}