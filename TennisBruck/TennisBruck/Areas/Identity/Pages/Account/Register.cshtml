@page
@model RegisterModel
@{
    ViewData["Title"] = "Register";
}

<link rel="stylesheet" href="~/css/areas/login.css" asp-append-version="true"/>

<div class="auth-wrapper">
    <div class="auth-card">
        <h1 class="auth-title">@ViewData["Title"]</h1>

        <div class="auth-layout">
            <div class="auth-local">
                <form id="registerForm" asp-route-returnUrl="@Model.ReturnUrl" method="post">
                    <h2 class="auth-subtitle">Neuen Account erstellen</h2>

                    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

                    <div class="form-group">
                        <label asp-for="Input.Firstname" class="form-label">Vorname</label>
                        <input asp-for="Input.Firstname" class="form-input" autocomplete="given-name"
                               aria-required="true" placeholder="Vorname"/>
                        <span asp-validation-for="Input.Firstname" class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Lastname" class="form-label">Nachname</label>
                        <input asp-for="Input.Lastname" class="form-input" autocomplete="family-name"
                               aria-required="true" placeholder="Nachname"/>
                        <span asp-validation-for="Input.Lastname" class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Email" class="form-label">E-Mail</label>
                        <input asp-for="Input.Email" class="form-input" autocomplete="username" aria-required="true"
                               placeholder="name@example.com"/>
                        <span asp-validation-for="Input.Email" class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.Password" class="form-label">Passwort</label>
                        <input asp-for="Input.Password" class="form-input" autocomplete="new-password"
                               aria-required="true" placeholder="••••••••"/>
                        <span asp-validation-for="Input.Password" class="validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Input.ConfirmPassword" class="form-label">Passwort bestätigen</label>
                        <input asp-for="Input.ConfirmPassword" class="form-input" autocomplete="new-password"
                               aria-required="true" placeholder="••••••••"/>
                        <span asp-validation-for="Input.ConfirmPassword" class="validation-error"></span>
                    </div>

                    <button id="registerSubmit" type="submit" class="btn-submit">Registrieren</button>
                </form>
            </div>

            <div class="auth-external">
                <section>
                    <h2 class="auth-subtitle">Anderen Anbieter nutzen</h2>
                    @{
                        if ((Model.ExternalLogins?.Count ?? 0) == 0)
                        {
                            <div class="external-empty">
                                <p>Es sind keine externen Authentifizierungsdienste konfiguriert.</p>
                                <a href="https://go.microsoft.com/fwlink/?LinkID=532715">Erfahre, wie man diese aufsetzt</a>.
                            </div>
                        }
                        else
                        {
                            <form id="external-account" asp-page="./ExternalLogin"
                                  asp-route-returnUrl="@Model.ReturnUrl" method="post">
                                <div class="external-buttons">
                                    @foreach (var provider in Model.ExternalLogins!)
                                    {
                                        <button type="submit" class="btn-external" name="provider"
                                                value="@provider.Name"
                                                title="Log in using your @provider.DisplayName account">
                                            Weiter mit @provider.DisplayName
                                        </button>
                                    }
                                </div>
                            </form>
                        }
                    }
                </section>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}