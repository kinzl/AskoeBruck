@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Registrierung fast abgeschlossen!";
}

<div class="auth-card-container">
    <div class="auth-card">
        
        <div class="status-icon">
            📬
        </div>

        <h1>@ViewData["Title"]</h1>
        
        <div class="status-message-wrapper">
            @if (@Model.DisplayConfirmAccountLink)
            {
                <div class="dev-warning">
                    <strong>Entwickler-Modus:</strong> Es ist aktuell kein echter E-Mail-Versand konfiguriert.
                </div>
                <p>Normalerweise würdest du jetzt eine E-Mail bekommen. Für den Moment kannst du hier klicken:</p>
                <a id="confirm-link" href="@Model.EmailConfirmationUrl" class="btn-primary">Konto jetzt bestätigen</a>
            }
            else
            {
                <p>
                    Wir haben dir gerade eine E-Mail geschickt. <br /><br />
                    <strong>Bitte überprüfe dein Postfach (und deinen Spam-Ordner)</strong> und klicke auf den Link darin, um dein Konto zu aktivieren.
                </p>
            }
        </div>

        @if (!@Model.DisplayConfirmAccountLink)
        {
            <a href="~/" class="btn-secondary">Zurück zur Startseite</a>
        }

    </div>
</div>

<style>
    /* Das exakt gleiche Design wie bei der ConfirmEmail-Seite für einen einheitlichen Look */
    .auth-card-container {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 60vh;
        font-family: Arial, sans-serif;
    }

    .auth-card {
        background: #ffffff;
        padding: 40px;
        border-radius: 12px;
        box-shadow: 0 8px 24px rgba(0, 0, 0, 0.1);
        text-align: center;
        max-width: 450px;
        width: 100%;
        border-top: 5px solid #28a745; /* Eine grüne Erfolgs-Linie oben */
    }

    .status-icon {
        font-size: 52px;
        margin-bottom: 15px;
    }

    .auth-card h1 {
        font-size: 22px;
        color: #333333;
        margin-bottom: 20px;
        margin-top: 0;
        line-height: 1.4;
    }

    .status-message-wrapper {
        margin-bottom: 30px;
        font-size: 16px;
        color: #555555;
        line-height: 1.5;
    }

    .dev-warning {
        background-color: #fff3cd;
        color: #856404;
        padding: 10px;
        border-radius: 6px;
        margin-bottom: 20px;
        font-size: 14px;
        border: 1px solid #ffeeba;
    }

    .btn-primary {
        display: inline-block;
        padding: 12px 24px;
        background-color: #007bff;
        color: #ffffff;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        transition: background-color 0.3s ease;
        margin-top: 10px;
    }

    .btn-primary:hover {
        background-color: #0056b3;
        color: #ffffff;
    }

    .btn-secondary {
        display: inline-block;
        padding: 12px 24px;
        background-color: #e9ecef;
        color: #333333;
        text-decoration: none;
        border-radius: 6px;
        font-weight: bold;
        transition: background-color 0.3s ease;
    }

    .btn-secondary:hover {
        background-color: #dde2e6;
        color: #111111;
    }
</style>