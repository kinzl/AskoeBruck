@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Registrierung fast abgeschlossen!";
}

<div class="auth-card-container">
    <div class="auth-card">

        <div class="status-icon">
            📬
        </div>

        <h1>@ViewData["Title"]</h1>

        <div class="status-message-wrapper">

            <p>
                Wir haben dir gerade eine E-Mail geschickt. <br/><br/>
                <strong>Bitte überprüfe dein Postfach (und deinen Spam-Ordner)</strong> und klicke auf den Link darin,
                um dein Konto zu aktivieren.
            </p>
            
        </div>

        @if (!@Model.DisplayConfirmAccountLink)
        {
            <a href="~/" class="btn-secondary">Zurück zur Startseite</a>
        }

    </div>
</div>
