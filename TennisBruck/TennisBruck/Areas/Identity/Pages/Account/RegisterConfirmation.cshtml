@page
@model RegisterConfirmationModel
@{
    ViewData["Title"] = "Registrierung fast abgeschlossen!";
}

<link rel="stylesheet" href="~/css/areas/login.css" asp-append-version="true"/>

<div class="auth-wrapper">
    <div class="auth-card auth-card--centered">

        <div class="confirm-icon">📬</div>

        <h1 class="auth-title">@ViewData["Title"]</h1>

        <p class="confirm-message">
            Wir haben dir gerade eine E-Mail geschickt.<br/><br/>
            <strong>Bitte überprüfe dein Postfach (und deinen Spam-Ordner)</strong> und klicke auf den
            Link darin, um dein Konto zu aktivieren.
        </p>

        @if (!Model.DisplayConfirmAccountLink)
        {
            <a href="~/" class="btn-submit btn-submit--secondary">← Zurück zur Startseite</a>
        }

    </div>
</div>
