@page
@model ResetPasswordModel
@{
    ViewData["Title"] = "Reset password";
}

<link rel="stylesheet" href="~/css/areas/login.css" asp-append-version="true"/>

<div class="auth-wrapper">
    <div class="auth-card" style="max-width: 500px;">
        <h1 class="auth-title">@ViewData["Title"]</h1>
        <p class="auth-subtitle" style="text-align: center;">Geben Sie unten Ihr neues Passwort ein.</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>

            <input asp-for="Input.Code" type="hidden"/>

            <div class="form-group">
                <label asp-for="Input.Email" class="form-label">E-Mail</label>
                <input asp-for="Input.Email" class="form-input" autocomplete="username" aria-required="true"
                       placeholder="name@example.com"/>
                <span asp-validation-for="Input.Email" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password" class="form-label">Neues Passwort</label>
                <input asp-for="Input.Password" class="form-input" autocomplete="new-password" aria-required="true"
                       placeholder="••••••••"/>
                <span asp-validation-for="Input.Password" class="validation-error"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword" class="form-label">Passwort bestätigen</label>
                <input asp-for="Input.ConfirmPassword" class="form-input" autocomplete="new-password"
                       aria-required="true" placeholder="••••••••"/>
                <span asp-validation-for="Input.ConfirmPassword" class="validation-error"></span>
            </div>

            <button type="submit" class="btn-submit">Zurücksetzen</button>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial"/>
}