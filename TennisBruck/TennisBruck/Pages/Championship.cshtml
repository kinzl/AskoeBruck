@page
@model TennisBruck.Pages.Championship

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vereinsmeisterschaft</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-1.8.3.min.js"></script>
    <script src="https://underscorejs.org/underscore-min.js"></script>
    <link rel="stylesheet" href="~/css/championship.css" asp-append-version="true"/>
    <script src="js/toggleVisibility.js"></script>
    <script src="js/tournament.js"></script>
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <form method="post" class="inline-form-zero">
            <button type="submit" asp-page-handler="Back" class="btn-back-header">
                ← Übersicht
            </button>
        </form>
    </div>
    <h1 class="app-title">Vereinsmeisterschaft Bruck</h1>

    <form method="post" asp-page-handler="CompetitionChanged">
        @{
            var currentYear = CityTime.GetViennaTimeZone().Year;
            var currentCompetitions = Model.Competitions.Where(c => c.RegistrationUntil.Year >= currentYear).ToList();
            var oldCompetitions = Model.Competitions.Where(c => c.RegistrationUntil.Year < currentYear).ToList();
            var isOldActive = oldCompetitions.Any(c => c.Id == Model.SelectedCompetition?.Id);
        }
        <div class="competition-pills">
            @foreach (var competition in currentCompetitions)
            {
                var isActive = Model.SelectedCompetition?.Id == competition.Id;
                <button type="submit" name="selectedCompetitionId" value="@competition.Id"
                        class="pill-btn @(isActive ? "active" : "")">
                    @competition.Name
                </button>
            }

            @if (oldCompetitions.Any())
            {
                <select name="selectedCompetitionId" class="pill-btn pill-select @(isOldActive ? "active" : "")"
                        onchange="this.form.submit()">
                    <option value="" disabled selected="@(!isOldActive)">Vergangene Turniere</option>
                    @foreach (var competition in oldCompetitions)
                    {
                        var isActive = Model.SelectedCompetition?.Id == competition.Id;
                        <option value="@competition.Id" selected="@isActive">
                            @competition.Name
                        </option>
                    }
                </select>
            }
        </div>
    </form>
</header>

<main class="main-container">
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-success">
            @Model.Message
        </div>
    }

    @if (Model.SelectedCompetition != null)
    {
        <section class="modern-card">
            <div class="competition-info-flex">
                <div>
                    <h2 class="competition-title">@Model.SelectedCompetition.Name</h2>
                    <p class="registration-text">
                        Anmeldeschluss: <strong
                            class="text-dark">@Model.SelectedCompetition.RegistrationUntil.ToString("dd.MM.yyyy HH:mm")</strong>
                    </p>
                </div>
                @{
                    var registrationOpen = Model.SelectedCompetition.RegistrationUntil >= CityTime.GetViennaTimeZone();
                }

                @if (registrationOpen)
                {
                    <form method="post" class="competition-action-form">
                        <input type="hidden" name="selectedCompetition" value="@Model.SelectedCompetition.Id"/>
                        <button class="btn-action btn-large-shadow @(Model.IsRegistered ? "btn-danger" : "btn-accent")"
                                asp-page-handler="@(Model.IsRegistered ? "Unregister" : "Register")">
                            @(Model.IsRegistered ? "❌ Wieder abmelden" : "🎾 Jetzt Teilnehmen")
                        </button>
                        <span class="badge-count">Spieler: @Model.RegisteredCompetitionPlayers.Count</span>
                    </form>

                    @if (User.IsInRole("Admin"))
                    {
                        <form method="post" class="admin-time-form">
                            <span class="text-sm text-muted">Admin-Anpassung:</span>
                            <input type="date" name="newDate"
                                   value="@Model.SelectedCompetition.RegistrationUntil.ToString("yyyy-MM-dd")"
                                   class="input-auto"/>
                            <input type="time" name="newTime"
                                   value="@Model.SelectedCompetition.RegistrationUntil.ToString("HH:mm")"
                                   class="input-auto"/>
                            <button asp-page-handler="SaveNewDate" class="btn-action btn-sm">Anmeldefrist aktualisieren
                            </button>
                        </form>
                    }
                }
                else
                {
                    <div class="registration-closed-row">
                        <div class="registration-closed-badges">
                            <span class="badge-closed">Anmeldung geschlossen</span>
                            <span class="badge-count">Spieler: @Model.RegisteredCompetitionPlayers.Count</span>
                        </div>

                        @if (User.IsInRole("Admin"))
                        {
                            <form method="post" class="admin-time-form admin-time-form--inline">
                                <span class="text-sm text-muted">Admin-Anpassung:</span>
                                <input type="date" name="newDate"
                                       value="@Model.SelectedCompetition.RegistrationUntil.ToString("yyyy-MM-dd")"
                                       class="input-auto"/>
                                <input type="time" name="newTime"
                                       value="@Model.SelectedCompetition.RegistrationUntil.ToString("HH:mm")"
                                       class="input-auto"/>
                                <button asp-page-handler="SaveNewDate" class="btn-action btn-sm">Anmeldefrist aktualisieren
                                </button>
                            </form>
                        }

                        @if (Model.IsRegistered)
                        {
                            <form method="post" class="m-0">
                                <input type="hidden" name="selectedCompetition" value="@Model.SelectedCompetition.Id"/>
                                <button class="btn-action btn-danger" asp-page-handler="SelfWithdraw"
                                        onclick="return confirm('Möchtest du das Turnier wirklich komplett abbrechen? ALLE deine noch offenen Matches werden als Sieg (w.o.) für deine Gegner gewertet. Das kann nicht rückgängig gemacht werden!');">
                                    Turnier abbrechen (w.o.)
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>

        </section>

        @if (!Model.SelectedCompetition.IsSingle)
        {
            <section class="modern-card">
                <div class="card-header">
                    <h2>👥 Doppel-Paare Konfigurieren</h2>
                    @if (User.IsInRole("Admin") && Model.SelectedCompetition.RegistrationUntil < CityTime.GetViennaTimeZone())
                    {
                        <form method="post" class="m-0">
                            <input type="hidden" name="ChampionshipId" value="@Model.SelectedCompetition.Id"/>

                            <button type="submit" asp-page-handler="GeneratePairs" class="btn-action"
                                    onclick="return confirm('Bisherige Doppel Paare werden gelöscht und neu zugeordnet. Möchtest du das wirklich?');">
                                🔀 Doppel-Paare zufällig auslosen
                            </button>
                        </form>
                    }
                </div>

                @{
                    int totalPairs = Model.RegisteredCompetitionPlayers.Count / 2;
                }

                <form method="post">
                    <input type="hidden" name="ChampionshipId" value="@Model.SelectedCompetition?.Id"/>

                    <div class="pairs-grid-container">
                        @for (int i = 0; i < totalPairs; i++)
                        {
                            var currentTeam = Model.RegisteredTeams != null && i < Model.RegisteredTeams.Count ? Model.RegisteredTeams[i] : null;
                            var firstPlayer = currentTeam?.TeamPlayers.ElementAtOrDefault(0)?.Player;
                            var secondPlayer = currentTeam?.TeamPlayers.ElementAtOrDefault(1)?.Player;
                            var pairIndex = i + 1;

                            <div class="pair-card">
                                <div class="border-divider d-flex justify-content-between align-items-center">
                                    <span>Paar @pairIndex</span>
                                    @if (currentTeam != null && User.IsInRole("Admin"))
                                    {
                                        <form method="post" asp-page-handler="DeleteTeam" class="m-0 p-0"
                                              style="display:inline;">
                                            <input type="hidden" name="teamId" value="@currentTeam.Id"/>
                                            <button type="submit" class="btn-delete-icon" title="Team löschen"
                                                    onclick="return confirm('Möchtest du dieses Team wirklich löschen?');">
                                                🗑️
                                            </button>
                                        </form>
                                    }
                                </div>

                                @if (currentTeam != null && User.IsInRole("Admin"))
                                {
                                    <input type="hidden" name="pairs[@i].TeamId" value="@currentTeam.Id"/>
                                }

                                <div class="players-flex-row">
                                    <div class="player-column">
                                        <label class="player-label">Spieler A</label>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <select name="pairs[@i].SinglePlayerId" class="player-select">
                                                <option value="">Auswählen...</option>
                                                @foreach (var registration in Model.RegisteredCompetitionPlayers)
                                                {
                                                    bool isSelected = firstPlayer != null && registration.Player.Id == firstPlayer.Id;
                                                    <option value="@registration.Player.Id" selected="@isSelected">
                                                        @registration.Player.ToStringWithItn()
                                                    </option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <div class="player-select disabled-look">
                                                @(firstPlayer != null ? firstPlayer.ToStringWithItn() : "Offen")
                                            </div>
                                        }
                                    </div>

                                    <div class="plus-symbol">+</div>

                                    <div class="player-column">
                                        <label class="player-label">Spieler B</label>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <select name="pairs[@i].DoublePlayerId" class="player-select">
                                                <option value="">Auswählen...</option>
                                                @foreach (var registration in Model.RegisteredCompetitionPlayers)
                                                {
                                                    bool isSelected = (secondPlayer != null && registration.Player.Id == secondPlayer.Id);
                                                    <option value="@registration.Player.Id" selected="@isSelected">
                                                        @registration.Player.ToStringWithItn()
                                                    </option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <div class="player-select disabled-look">
                                                @(secondPlayer != null ? secondPlayer.ToStringWithItn() : "Offen")
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </form>
                @if (User.IsInRole("Admin") && Model.SelectedCompetition.RegistrationUntil < CityTime.GetViennaTimeZone())
                {
                    <div class="d-flex justify-content-center align-items-center gap-3 mt-4 mb-5">
                        <form method="post" asp-page-handler="SavePairs">
                            <div class="group-save-wrapper m-0">
                                <button type="submit" class="btn-action btn-accent">
                                    💾 Paare Speichern
                                </button>
                            </div>
                        </form>

                    </div>
                }

            </section>
        }

        <partial name="Partials/_GroupTables" model="Model"/>

        <partial name="Partials/_BracketView" model="Model"/>

        <partial name="Partials/_PersonalMatches" model="Model"/>

        <div class="toggle-info-wrapper">
            <button type="button" onclick="toggleInfo()" id="infoButton" class="btn-action btn-outline-muted">
                ⬇️ Teilnehmer & Alle Spiele einblenden
            </button>
        </div>

        <div id="infoBox" style="display: none;">
            <section class="modern-card mb-24">
                <div class="card-header">
                    <h2>📋 Teilnehmerliste (@Model.RegisteredCompetitionPlayers.Count)</h2>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <table class="participant-table">
                        <thead>
                        <tr>
                            <th>Teilnehmer</th>
                            <th>W.O.</th>
                            <th>Löschen</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var registered in Model.RegisteredCompetitionPlayers)
                        {
                            var playerTeam = Model.RegisteredTeams.FirstOrDefault(t => t.TeamPlayers.Any(tp => tp.Player.Id == registered.Player.Id));
                            <tr>
                                <td>@registered.Player.ToString()</td>
                                <td>
                                    <form method="post" class="inline-form-zero">
                                        <input type="hidden" name="playerId" value="@registered.Player.Id"/>
                                        <input type="hidden" name="competitionId"
                                               value="@Model.SelectedCompetition.Id"/>
                                        <button asp-page-handler="WithdrawPlayer"
                                                class="btn-warning btn-xs btn-action-micro"
                                                title="Spieler w.o. abmelden"
                                                onclick="return confirm('Soll dieser Spieler wirklich verletzungsbedingt/w.o. abgemeldet werden? ALLE seine offenen Matches in diesem Bewerb werden sofort als Sieg für die Gegner gewertet!');">
                                            Alles W.O.
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="RemoveRegistration" class="inline-form-zero">
                                        <input type="hidden" name="playerId" value="@registered.Player.Id"/>
                                        <input type="hidden" name="competitionId"
                                               value="@Model.SelectedCompetition.Id"/>
                                        <button class="btn-danger btn-xs btn-action-micro"
                                                title="Teilnehmer löschen"
                                                onclick="return confirm('Möchtest du diesen Teilnehmer wirklich aus dem Bewerb löschen? Alle zugehörigen Teams und Matches werden ebenfalls gelöscht!');">
                                            Löschen
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="participants-wrapper">
                        @foreach (var registered in Model.RegisteredCompetitionPlayers)
                        {
                            <div class="participant-badge">
                                @registered.Player.ToString()
                            </div>
                        }
                    </div>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div class="manual-add-wrapper">
                        <h4 class="manual-add-title">Spieler hinzufügen</h4>
                        <form method="post" class="manual-add-form flex-grow-1 m-0">
                            <select name="playerId" required>
                                <option value="">Spieler auswählen...</option>
                                @foreach (var player in Model.UnregisteredPlayers)
                                {
                                    <option value="@player.Id">@player.ToString()</option>
                                }
                            </select>
                            <button asp-page-handler="Register" class="btn-action btn-accent white-space-nowrap">
                                Hinzufügen
                            </button>
                        </form>
                    </div>
                }
            </section>

            <section class="modern-card mb-24">
                <div class="card-header">
                    <h2>🎾 Alle Matches in diesem Bewerb</h2>
                </div>
                @foreach (var match in Model.AllMatches)
                {
                    @if (match.Team1 != null && match.Team2 != null)
                    {
                        bool isMyMatch = Model.CurrentPlayer != null &&
                                         (match.Team1.TeamPlayers.Any(p => p.PlayerId == Model.CurrentPlayer.Id) ||
                                          match.Team2.TeamPlayers.Any(p => p.PlayerId == Model.CurrentPlayer.Id));

                        <div class="match-scorecard">
                            <div class="match-players text-sm">
                                <span
                                    class="@(match.IsWalkover && match.WalkoverTeamId == match.Team1?.Id ? "team-walkover" : (match.IsWalkover && match.WalkoverTeamId == match.Team2?.Id ? "team-walkover-winner" : (match.Winner?.Id == match.Team1?.Id ? "winner-highlight" : (match.Winner != null ? "loser-highlight" : ""))))">
                                    @match.Team1?.PlayersToString()
                                </span>

                                <span class="text-vs">vs</span>

                                <span
                                    class="@(match.IsWalkover && match.WalkoverTeamId == match.Team2?.Id ? "team-walkover" : (match.IsWalkover && match.WalkoverTeamId == match.Team1?.Id ? "team-walkover-winner" : (match.Winner?.Id == match.Team2?.Id ? "winner-highlight" : (match.Winner != null ? "loser-highlight" : ""))))">
                                    @match.Team2?.PlayersToString()
                                </span>
                                <span class="badge-phase">
                                    @(match.Group != null ? match.Group.Competition.Name : "K.O Phase")
                                </span>
                            </div>

                            @if (User.IsInRole("Admin"))
                            {
                                <form method="post" class="match-action-form">
                                    <input type="hidden" name="matchId" value="@match.Id"/>

                                    @if (match.IsWalkover)
                                    {
                                        var winnerName = match.WalkoverTeamId == match.Team1?.Id ? match.Team2?.PlayersToString() : match.Team1?.PlayersToString();
                                        <div class="match-score text-warning fw-bold">w.o. (Sieger: @winnerName)</div>
                                        <button class="btn-action btn-danger btn-xs" asp-page-handler="DeleteMatch">
                                            Löschen
                                        </button>
                                    }
                                    else if (match.Sets == null || !match.Sets.Any())
                                    {
                                        <div class="flex-center-gap">
                                            <input type="text" name="score" placeholder="6:4 6:2"
                                                   class="input-score-sm"/>
                                            <button class="btn-action btn-xs" asp-page-handler="SaveMatch">Speichern
                                            </button>

                                            <button type="submit" class="btn-action btn-warning btn-xs"
                                                    asp-page-handler="AdminWalkover" name="walkoverTeamId"
                                                    value="@if (match.Team1 != null) { @match.Team1.Id }"
                                                    title="T1 aufgeben">
                                                W.O. T1
                                            </button>
                                            <button type="submit" class="btn-action btn-warning btn-xs"
                                                    asp-page-handler="AdminWalkover" name="walkoverTeamId"
                                                    value="@if (match.Team2 != null) { @match.Team2.Id }"
                                                    title="T2 aufgeben">
                                                W.O. T2
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="match-score">@match.SetToString()</div>
                                        <button class="btn-action btn-danger btn-xs" asp-page-handler="DeleteMatch">
                                            Löschen
                                        </button>
                                    }
                                </form>
                            }
                            else if (isMyMatch)
                            {
                                <form method="post" class="match-action-form">
                                    <input type="hidden" name="matchId" value="@match.Id"/>

                                    @if (match.IsWalkover)
                                    {
                                        var winnerName = match.WalkoverTeamId == match.Team1?.Id ? match.Team2?.PlayersToString() : match.Team1?.PlayersToString();
                                        <div class="match-score text-warning fw-bold">w.o. (Sieger: @winnerName)</div>
                                        <button class="btn-action btn-danger btn-xs" asp-page-handler="DeleteMatch">
                                            Rückgängig
                                        </button>
                                    }
                                    else if (match.Sets == null || !match.Sets.Any())
                                    {
                                        <div class="flex-center-gap">
                                            <input type="text" name="score" placeholder="6:4 6:2"
                                                   class="input-score-sm"/>
                                            <button class="btn-action btn-xs" asp-page-handler="SaveMatch">Speichern
                                            </button>
                                            <button type="submit" class="btn-action btn-warning btn-xs"
                                                    asp-page-handler="GiveWalkover"
                                                    onclick="return confirm('Möchtest du dieses Match wirklich aufgeben? Dein Gegner gewinnt durch w.o.');">
                                                W.O. geben
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="match-score">@match.SetToString()</div>
                                        <button class="btn-action btn-danger btn-xs" asp-page-handler="DeleteMatch">
                                            Rückgängig
                                        </button>
                                    }
                                </form>
                            }
                            else
                            {
                                @if (match.IsWalkover)
                                {
                                    var winnerName = match.WalkoverTeamId == match.Team1?.Id ? match.Team2?.PlayersToString() : match.Team1?.PlayersToString();
                                    <div class="match-score text-warning fw-bold">w.o. (Sieger: @winnerName)</div>
                                }
                                else
                                {
                                    <div
                                        class="match-score">@(match.Sets != null && match.Sets.Any() ? match.SetToString() : "Offen")</div>
                                }
                            }
                        </div>
                    }
                }
            </section>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">🎾</div>
            <h2>Wähle oben einen Bewerb aus</h2>
            <p>Um die Gruppen, das Raster und deine Spiele zu sehen.</p>
        </div>
    }

    @if (User.IsInRole("Admin"))
    {
        <section class="admin-strip">
            <h3 class="admin-strip-title">⚠️ Admin Bereich</h3>
            <div class="admin-strip-flex">

                <form method="post" class="admin-create-form">
                    <input type="text" name="competitionName" placeholder="Neuer Bewerb Name" required
                           class="flex-1"/>
                    <div class="admin-radio-wrapper">
                        <input id="radioSingle" type="radio" name="isSingle" value="true" checked/>
                        <label for="radioSingle" class="admin-radio-label">Einzel</label>
                        <input id="radioDouble" type="radio" name="isSingle" value="false"/>
                        <label for="radioDouble" class="admin-radio-label">Doppel</label>
                    </div>
                    <button class="btn-action" asp-page-handler="CreateCompetition">Erstellen</button>
                </form>

                @if (Model.SelectedCompetition != null)
                {
                    <form method="post">
                        <input type="hidden" name="competitionId" value="@Model.SelectedCompetition!.Id"/>
                        <button class="btn-action btn-danger" asp-page-handler="DeleteCompetition"
                                onclick="return confirm('Diesen Bewerb wirklich unwiderruflich löschen?');">
                            Aktuellen Bewerb löschen
                        </button>
                    </form>
                }
            </div>
        </section>
    }

</main>

<script>
    window.existingTournamentPhases = @Html.Raw(Json.Serialize(Model.Matches.Select(m => m.PhaseName ?? "A-Bewerb").Distinct().ToList()));
</script>
</body>
</html>