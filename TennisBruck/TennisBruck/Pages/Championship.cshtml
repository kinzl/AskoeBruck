@page
@model TennisBruck.Pages.Championship

@functions {

    string GetRowClass(TennisDb.Match match, Team team)
    {
        if (team == null) return "";
        if (match.Winner != null)
        {
            if (match.IsWalkover)
            {
                return match.WalkoverTeamId == team.Id ? "walkover-loser" : "winner";
            }

            return match.Winner.Id == team.Id ? "winner" : "loser";
        }

        return "";
    }

}

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vereinsmeisterschaft</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="https://code.jquery.com/jquery-1.8.3.min.js"></script>
    <script src="https://underscorejs.org/underscore-min.js"></script>
    <link rel="stylesheet" href="~/css/tournaments.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/championship.css" asp-append-version="true"/>
    <script src="js/toggleVisibility.js"></script>
    <script src="js/tournament.js"></script>
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <form method="post" class="inline-form-zero">
            <button type="submit" asp-page-handler="Back" class="btn-back-header">
                ← Übersicht
            </button>
        </form>
    </div>
    <h1 class="app-title">Vereinsmeisterschaft Bruck</h1>

    <form method="post" asp-page-handler="CompetitionChanged">
        @{
            var currentYear = CityTime.GetViennaTimeZone().Year;
            var currentCompetitions = Model.Competitions.Where(c => c.RegistrationUntil.Year >= currentYear).ToList();
            var oldCompetitions = Model.Competitions.Where(c => c.RegistrationUntil.Year < currentYear).ToList();
            var isOldActive = oldCompetitions.Any(c => c.Id == Model.SelectedCompetition?.Id);
        }
        <div class="competition-pills">
            @if (currentCompetitions.Count < 4)
            {
                <button type="submit" name="selectedCompetitionId" value="0"
                        class="pill-btn @(Model.SelectedCompetition == null ? "active" : "")">
                    Aktuelle Turniere
                </button>
                @foreach (var competition in currentCompetitions)
                {
                    var isActive = Model.SelectedCompetition?.Id == competition.Id;
                    <button type="submit" name="selectedCompetitionId" value="@competition.Id"
                            class="pill-btn @(isActive ? "active" : "")">
                        @competition.Name
                    </button>
                }
            }
            else
            {
                var isCurrentActive = currentCompetitions.Any(c => c.Id == Model.SelectedCompetition?.Id);
                <select name="selectedCompetitionId" class="pill-btn pill-select @(isCurrentActive ? "active" : (Model.SelectedCompetition == null ? "active" : ""))"
                        onchange="this.form.submit()">
                    <option value="0" selected="@(Model.SelectedCompetition == null)">Aktuelle Turniere</option>
                    @foreach (var competition in currentCompetitions)
                    {
                        var isActive = Model.SelectedCompetition?.Id == competition.Id;
                        <option value="@competition.Id" selected="@isActive">
                            @competition.Name
                        </option>
                    }
                </select>
            }

            @if (oldCompetitions.Any())
            {
                <select name="selectedCompetitionId" class="pill-btn pill-select @(isOldActive ? "active" : "")"
                        onchange="this.form.submit()">
                    <option value="0" selected="@(!isOldActive)">Vergangene Turniere</option>
                    @foreach (var competition in oldCompetitions)
                    {
                        var isActive = Model.SelectedCompetition?.Id == competition.Id;
                        <option value="@competition.Id" selected="@isActive">
                            @competition.Name
                        </option>
                    }
                </select>
            }
        </div>
    </form>
</header>

@if (!string.IsNullOrEmpty(Model.Message))
{
    <div class="message-banner">
        <div class="message-banner-inner">
            @Model.Message
        </div>
    </div>
}

<main class="main-container @(!string.IsNullOrEmpty(Model.Message) ? "has-message" : "")">

    @if (Model.SelectedCompetition != null)
    {
        var registrationOpen = Model.SelectedCompetition.RegistrationUntil >= CityTime.GetViennaTimeZone();

        <section class="modern-card comp-header-card">
            <div class="comp-header-row">
                <div class="comp-title-area">
                    <h2 class="competition-title">@Model.SelectedCompetition.Name</h2>
                    <span class="badge-count">Spieler: @Model.RegisteredCompetitionPlayers.Count</span>
                </div>

                <div class="comp-meta-area">
                    <span class="registration-text" style="margin: 0;">
                        Anmeldeschluss: <strong class="text-dark">@Model.SelectedCompetition.RegistrationUntil.ToString("dd.MM.yyyy HH:mm")</strong>
                    </span>
                    @if (User.IsInRole("Admin"))
                    {
                        <button type="button" class="btn-pencil-edit" title="Anmeldefrist bearbeiten" onclick="openDateModal()">✏️</button>
                    }
                </div>

                <div class="comp-actions-area">
                    @if (Model.IsRegistered)
                    {
                        <form method="post" class="comp-action-form">
                            <input type="hidden" name="selectedCompetition" value="@Model.SelectedCompetition.Id"/>
                            <button class="btn-action btn-sm btn-danger" asp-page-handler="SelfWithdraw"
                                    onclick="return confirm('Möchtest du das Turnier wirklich komplett abbrechen? ALLE deine noch offenen Matches werden als Sieg (w.o.) für deine Gegner gewertet. Das kann nicht rückgängig gemacht werden!');">
                                Turnier abbrechen (w.o.)
                            </button>
                            @if (registrationOpen)
                            {
                                <button class="btn-action btn-sm btn-outline-muted" asp-page-handler="Unregister">
                                    ❌ Wieder abmelden
                                </button>
                            }
                        </form>
                    }
                    else if (registrationOpen)
                    {
                        <form method="post" class="comp-action-form">
                            <input type="hidden" name="selectedCompetition" value="@Model.SelectedCompetition.Id"/>
                            <button class="btn-action btn-sm btn-accent" asp-page-handler="Register">
                                🎾 Jetzt Teilnehmen
                            </button>
                        </form>
                    }
                </div>
            </div>
        </section>

        @if (!Model.SelectedCompetition.IsSingle)
        {
            <partial name="Partials/_DoublePairsConfig" model='new TennisBruck.Pages.Partials.DoublePairsConfigViewModel
            {
                CompetitionId = Model.SelectedCompetition.Id,
                RegistrationUntil = Model.SelectedCompetition.RegistrationUntil,
                IsAdmin = User.IsInRole("Admin"),
                RegisteredPlayers = Model.RegisteredCompetitionPlayers.Select(r => r.Player).ToList(),
                RegisteredTeams = Model.RegisteredTeams ?? new List<TennisDb.Team>()
            }' />
        }

        <partial name="Partials/_GroupTables" model="Model"/>

        <partial name="Partials/_BracketView" model="Model"/>

        <partial name="Partials/_PersonalMatches" model="Model"/>

        <div class="toggle-info-wrapper">
            <button type="button" onclick="toggleInfo()" id="infoButton" class="btn-action btn-outline-muted">
                ⬇️ Teilnehmer & Alle Spiele einblenden
            </button>
        </div>

        <div id="infoBox" style="display: none;">
            <section class="modern-card mb-24">
                <div class="card-header">
                    <h2>Teilnehmerliste (@Model.RegisteredCompetitionPlayers.Count)</h2>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <table class="participant-table">
                        <thead>
                        <tr>
                            <th>Teilnehmer</th>
                            <th>W.O.</th>
                            <th>Löschen</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var registered in Model.RegisteredCompetitionPlayers)
                        {
                            var playerTeam = Model.RegisteredTeams.FirstOrDefault(t => t.TeamPlayers.Any(tp => tp.Player.Id == registered.Player.Id));
                            <tr>
                                <td>@registered.Player.ToString()</td>
                                <td>
                                    <form method="post" class="inline-form-zero">
                                        <input type="hidden" name="playerId" value="@registered.Player.Id"/>
                                        <input type="hidden" name="competitionId"
                                               value="@Model.SelectedCompetition.Id"/>
                                        <button asp-page-handler="WithdrawPlayer"
                                                class="btn-warning btn-xs btn-action-micro"
                                                title="Spieler w.o. abmelden"
                                                onclick="return confirm('Soll dieser Spieler wirklich verletzungsbedingt/w.o. abgemeldet werden? ALLE seine offenen Matches in diesem Bewerb werden sofort als Sieg für die Gegner gewertet!');">
                                            Alles W.O.
                                        </button>
                                    </form>
                                </td>
                                <td>
                                    <form method="post" asp-page-handler="RemoveRegistration" class="inline-form-zero">
                                        <input type="hidden" name="playerId" value="@registered.Player.Id"/>
                                        <input type="hidden" name="competitionId"
                                               value="@Model.SelectedCompetition.Id"/>
                                        <button class="btn-danger btn-xs btn-action-micro"
                                                title="Teilnehmer löschen"
                                                onclick="return confirm('Möchtest du diesen Teilnehmer wirklich aus dem Bewerb löschen? Alle zugehörigen Teams und Matches werden ebenfalls gelöscht!');">
                                            Löschen
                                        </button>
                                    </form>
                                </td>
                            </tr>
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <div class="participants-wrapper">
                        @foreach (var registered in Model.RegisteredCompetitionPlayers)
                        {
                            <div class="participant-badge">
                                @registered.Player.ToString()
                            </div>
                        }
                    </div>
                }

                @if (User.IsInRole("Admin"))
                {
                    <div class="manual-add-wrapper">
                        <h4 class="manual-add-title">Spieler hinzufügen</h4>
                        <form method="post" class="manual-add-form flex-grow-1 m-0">
                            <select name="playerId" required>
                                <option value="">Spieler auswählen...</option>
                                @foreach (var player in Model.UnregisteredPlayers)
                                {
                                    <option value="@player.Id">@player.ToString()</option>
                                }
                            </select>
                            <button asp-page-handler="Register" class="btn-action btn-accent white-space-nowrap">
                                Hinzufügen
                            </button>
                        </form>
                    </div>
                }
            </section>

            <section class="modern-card mb-24">
                @{
                    var validMatches = Model.AllMatches.Where(m => m.Team1 != null && m.Team2 != null).ToList();
                    var filterGroups = validMatches
                        .Select(m => m.Group != null ? m.Group.GroupName : ((m as KnockoutMatch)?.PhaseName ?? "K.O Phase"))
                        .Distinct()
                        .OrderBy(g => g)
                        .ToList();
                }

                <div class="card-header card-header-flex">
                    <h2>Alle Matches in diesem Bewerb</h2>
                    @if (filterGroups.Count > 1)
                    {
                        <div class="match-filter-select-wrapper">
                            <select id="matchGroupFilterSelect" class="pill-btn pill-select"
                                    onchange="filterAllMatches(this.value, null)">
                                <option value="all">Alle Gruppen & K.O. Phasen (@validMatches.Count)</option>
                                @foreach (var grp in filterGroups)
                                {
                                    var grpCount = validMatches.Count(m => (m.Group != null ? m.Group.GroupName : ((m as KnockoutMatch)?.PhaseName ?? "K.O Phase")) == grp);
                                    <option value="@grp">@grp (@grpCount)</option>
                                }
                            </select>
                        </div>
                    }
                </div>

                @if (filterGroups.Count > 1)
                {
                    <div class="match-filter-pills">
                        <button type="button" class="match-filter-btn active" data-filter="all"
                                onclick="filterAllMatches('all', this)">
                            Alle (@validMatches.Count)
                        </button>
                        @foreach (var grp in filterGroups)
                        {
                            var grpCount = validMatches.Count(m => (m.Group != null ? m.Group.GroupName : ((m as KnockoutMatch)?.PhaseName ?? "K.O Phase")) == grp);
                            <button type="button" class="match-filter-btn" data-filter="@grp"
                                    onclick="filterAllMatches('@grp', this)">
                                @grp (@grpCount)
                            </button>
                        }
                    </div>
                }

                <div id="allMatchesList">
                    @foreach (var match in Model.AllMatches)
                    {
                        @if (match.Team1 != null && match.Team2 != null)
                        {
                            var groupCategory = match.Group != null ? match.Group.GroupName : ((match as KnockoutMatch)?.PhaseName ?? "K.O Phase");
                            bool isMyMatch = Model.CurrentPlayer != null &&
                                             (match.Team1.TeamPlayers.Any(p => p.PlayerId == Model.CurrentPlayer.Id) ||
                                              match.Team2.TeamPlayers.Any(p => p.PlayerId == Model.CurrentPlayer.Id));

                            string team1Score = "";
                            string team2Score = "";
                            if (match.IsWalkover)
                            {
                                team1Score = match.WalkoverTeamId == match.Team1.Id ? "w.o." : "";
                                team2Score = match.WalkoverTeamId == match.Team2.Id ? "w.o." : "";
                            }
                            else if (match.Sets != null && match.Sets.Any())
                            {
                                team1Score = string.Join(" ", match.Sets.OrderBy(s => s.SetNumber).Select(s => s.Player1GamesWon));
                                team2Score = string.Join(" ", match.Sets.OrderBy(s => s.SetNumber).Select(s => s.Player2GamesWon));
                            }

                            bool isDecided = match.IsWalkover || (match.Sets != null && match.Sets.Any());
                            bool canDelete = isDecided && (User.IsInRole("Admin") || isMyMatch);

                            var cardVm = new TennisBruck.Pages.MatchCardViewModel
                            {
                                MatchId = match.Id,
                                Team1Name = match.Team1.PlayersToString(),
                                Team2Name = match.Team2.PlayersToString(),
                                Team1Score = team1Score,
                                Team2Score = team2Score,
                                IsTeam1Winner = match.Winner?.Id == match.Team1.Id,
                                IsTeam2Winner = match.Winner?.Id == match.Team2.Id,
                                IsWalkover = match.IsWalkover,
                                WalkoverTeamId = match.WalkoverTeamId,
                                Team1Id = match.Team1.Id,
                                Team2Id = match.Team2.Id,
                                BadgeText = groupCategory,
                                DataGroup = groupCategory,
                                IsDecided = isDecided,
                                IsMyMatch = isMyMatch,
                                IsAdmin = User.IsInRole("Admin"),
                                CanDelete = canDelete,
                                DeleteHandler = "DeleteMatch",
                                DeleteButtonText = User.IsInRole("Admin") ? "Löschen" : "Rückgängig"
                            };

                            <partial name="_MatchScorecard" model="cardVm" />
                        }
                    }
                </div>

                <div id="noMatchesFilteredMsg"
                     style="display: none; text-align: center; padding: 20px; color: var(--color-gray);">
                    Keine Matches für diese Auswahl gefunden.
                </div>
            </section>
        </div>
    }
    else
    {
        <div class="overview-container">
            <section class="modern-card card-accent-border mb-24">
                <div class="card-header">
                    <div class="overview-card-title-group">
                        <span class="overview-trophy-icon">🏆</span>
                        <div>
                            <h2>Vereinsmeisterschaft — Information & Regeln</h2>
                            <p class="text-muted" style="margin: 2px 0 0 0; font-size: 0.88rem;">Allgemeine Informationen, Spielmodus und Turnierordnung</p>
                        </div>
                    </div>
                    @if (User.IsInRole("Admin"))
                    {
                        <button type="button" class="btn-action btn-outline-nav btn-sm" onclick="openInfoModal()">
                            ✏️ Text / PDF bearbeiten
                        </button>
                    }
                </div>

                <div class="overview-body">
                    @if (!string.IsNullOrWhiteSpace(Model.ChampionshipInfo?.Text))
                    {
                        <div class="championship-info-text">
                            @foreach (var paragraph in Model.ChampionshipInfo.Text.Split(new[] { "\r\n\r\n", "\n\n" }, StringSplitOptions.RemoveEmptyEntries))
                            {
                                <p>@Html.Raw(Html.Encode(paragraph).Replace("\n", "<br />").Replace("\r", ""))</p>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="info-text-empty">
                            <p style="font-size: 1.05rem; font-weight: 700; color: var(--nav-bg); margin-bottom: 6px;">🎾 Willkommen zur Vereinsmeisterschaft!</p>
                            <p class="text-muted" style="margin: 0;">Hier findest du alle wichtigen Informationen, Termine und Regeln zum heurigen Turnier. Wähle oben einen Bewerb aus, um Teilnehmer, Gruppen und Spielpläne einzusehen.</p>
                            @if (User.IsInRole("Admin"))
                            {
                                <div style="margin-top: 15px;">
                                    <button type="button" class="btn-action btn-accent btn-sm" onclick="openInfoModal()">
                                        ➕ Jetzt Informationen oder PDF-Regelwerk hinzufügen
                                    </button>
                                </div>
                            }
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ChampionshipInfo?.ImageFileName))
                    {
                        <div class="championship-image-container">
                            <a href="@Model.ChampionshipInfo.ImageFileName" target="_blank" title="Bild in voller Größe öffnen">
                                <img src="@Model.ChampionshipInfo.ImageFileName" alt="@(Model.ChampionshipInfo.ImageOriginalName ?? "Turnierbild")" class="championship-uploaded-img" />
                            </a>
                        </div>
                    }

                    @if (!string.IsNullOrWhiteSpace(Model.ChampionshipInfo?.PdfFileName))
                    {
                        <div class="pdf-document-card">
                            <div class="pdf-icon-wrapper">
                                <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="#dc2626" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"></path>
                                    <polyline points="14 2 14 8 20 8"></polyline>
                                    <line x1="16" y1="13" x2="8" y2="13"></line>
                                    <line x1="16" y1="17" x2="8" y2="17"></line>
                                    <polyline points="10 9 9 9 8 9"></polyline>
                                </svg>
                            </div>
                            <div class="pdf-info">
                                <div class="pdf-title">@(Model.ChampionshipInfo.PdfOriginalName ?? "Turnierregeln.pdf")</div>
                                <div class="pdf-subtitle">Offizielles Regelwerk / Turnierausschreibung (PDF)</div>
                            </div>
                            <div class="pdf-actions">
                                <a href="@Model.ChampionshipInfo.PdfFileName" target="_blank" class="btn-action btn-accent btn-sm" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                                    <span>👁️ PDF ansehen</span>
                                </a>
                                <a href="@Model.ChampionshipInfo.PdfFileName" download="@(Model.ChampionshipInfo.PdfOriginalName ?? "Turnierregeln.pdf")" class="btn-action btn-outline-nav btn-sm" style="display: inline-flex; align-items: center; gap: 6px; text-decoration: none;">
                                    <span>⬇️ Herunterladen</span>
                                </a>
                            </div>
                        </div>
                    }
                </div>
            </section>

            @{
                var currentYearCompetitions = Model.Competitions.Where(c => c.RegistrationUntil.Year >= CityTime.GetViennaTimeZone().Year).ToList();
            }
            @if (currentYearCompetitions.Any())
            {
                <section class="modern-card mb-24">
                    <div class="card-header">
                        <h2>Aktuelle Bewerbe (@CityTime.GetViennaTimeZone().Year)</h2>
                        <span class="badge-count">@currentYearCompetitions.Count @(currentYearCompetitions.Count == 1 ? "Bewerb" : "Bewerbe")</span>
                    </div>
                    <div class="overview-competitions-grid">
                        @foreach (var comp in currentYearCompetitions)
                        {
                            bool isClosed = comp.RegistrationUntil < CityTime.GetViennaTimeZone();
                            <form method="post" asp-page-handler="CompetitionChanged" class="overview-comp-card-form">
                                <input type="hidden" name="selectedCompetitionId" value="@comp.Id" />
                                <button type="submit" class="overview-comp-card">
                                    <div class="overview-comp-card-header">
                                        <span class="overview-comp-name">@comp.Name</span>
                                        <span class="badge-phase">@(comp.IsSingle ? "Einzel" : "Doppel")</span>
                                    </div>
                                    <div class="overview-comp-card-footer">
                                        <span class="comp-status @(isClosed ? "status-closed" : "status-open")">
                                            @(isClosed ? "🔒 Anmeldung beendet" : $"⏳ Bis {comp.RegistrationUntil:dd.MM.yyyy}")
                                        </span>
                                        <span class="comp-arrow">Zum Bewerb →</span>
                                    </div>
                                </button>
                            </form>
                        }
                    </div>
                </section>
            }
        </div>
    }

    @if (User.IsInRole("Admin"))
    {
        <div id="editInfoModal" class="modal-overlay" onclick="if(event.target === this) closeInfoModal();">
            <div class="modal-card modal-card-lg">
                <div class="modal-header">
                    <h3>✏️ Turnier-Informationen, Regeln & Medien bearbeiten</h3>
                    <button type="button" class="modal-close" onclick="closeInfoModal()">✕</button>
                </div>
                <form method="post" asp-page-handler="SaveChampionshipInfo" enctype="multipart/form-data">
                    <div class="modal-body" style="display: flex; flex-direction: column; gap: 16px;">
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label for="infoText" style="font-weight: 600; font-size: 0.9rem;">Informationstext & Regeln:</label>
                            <textarea id="infoText" name="infoText" rows="7" class="form-control-custom"
                                      placeholder="Erkläre hier die Turnierregeln, Spielzeiten, Gruppenmodus, Tiebreak-Regeln, etc...">@Model.ChampionshipInfo?.Text</textarea>
                            <span class="text-muted" style="font-size: 0.75rem;">Absätze und Zeilenumbrüche werden automatisch formatiert.</span>
                        </div>

                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label for="imageFile" style="font-weight: 600; font-size: 0.9rem;">Bild hochladen (z.B. Turnierplakat / Infografik / Foto):</label>
                            <input type="file" id="imageFile" name="imageFile" accept="image/*,.jpg,.jpeg,.png,.webp,.gif,.svg" class="form-control-custom" />
                            <span class="text-muted" style="font-size: 0.75rem;">Erlaubt: JPG, PNG, WEBP, GIF, SVG (max. 15 MB)</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.ChampionshipInfo?.ImageFileName))
                        {
                            <div class="modal-existing-media">
                                <div style="display: flex; align-items: center; gap: 12px;">
                                    <img src="@Model.ChampionshipInfo.ImageFileName" alt="Vorschau" class="modal-media-thumb" />
                                    <div>
                                        <div>🖼️ <strong>@(Model.ChampionshipInfo.ImageOriginalName ?? "Bild")</strong></div>
                                        <span class="text-muted" style="font-size: 0.75rem;">Aktuell hinterlegtes Bild</span>
                                    </div>
                                </div>
                                <label class="delete-media-label" style="display: flex; align-items: center; gap: 6px; margin-top: 8px; cursor: pointer; color: #dc2626; font-size: 0.85rem; font-weight: 600;">
                                    <input type="checkbox" name="deleteImage" value="true" />
                                    <span>Aktuelles Bild löschen / entfernen</span>
                                </label>
                            </div>
                        }

                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label for="pdfFile" style="font-weight: 600; font-size: 0.9rem;">PDF-Dokument hochladen (Regeln / Ausschreibung):</label>
                            <input type="file" id="pdfFile" name="pdfFile" accept=".pdf,application/pdf" class="form-control-custom" />
                            <span class="text-muted" style="font-size: 0.75rem;">Erlaubt: .pdf (max. 15 MB)</span>
                        </div>

                        @if (!string.IsNullOrWhiteSpace(Model.ChampionshipInfo?.PdfFileName))
                        {
                            <div class="modal-existing-media">
                                <div style="display: flex; align-items: center; gap: 8px;">
                                    <span>📄 Aktuelles PDF:</span>
                                    <strong style="color: var(--nav-bg);">@(Model.ChampionshipInfo.PdfOriginalName ?? "Turnierregeln.pdf")</strong>
                                </div>
                                <label class="delete-media-label" style="display: flex; align-items: center; gap: 6px; margin-top: 8px; cursor: pointer; color: #dc2626; font-size: 0.85rem; font-weight: 600;">
                                    <input type="checkbox" name="deletePdf" value="true" />
                                    <span>Aktuelles PDF löschen / entfernen</span>
                                </label>
                            </div>
                        }
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-action btn-outline-muted" onclick="closeInfoModal()">Abbrechen</button>
                        <button type="submit" class="btn-action btn-accent">💾 Speichern</button>
                    </div>
                </form>
            </div>
        </div>
    }

    @if (User.IsInRole("Admin") && Model.SelectedCompetition != null)
    {
        <div id="editDeadlineModal" class="modal-overlay" onclick="if(event.target === this) closeDateModal();">
            <div class="modal-card">
                <div class="modal-header">
                    <h3>✏️ Anmeldefrist bearbeiten</h3>
                    <button type="button" class="modal-close" onclick="closeDateModal()">✕</button>
                </div>
                <form method="post" asp-page-handler="SaveNewDate">
                    <div class="modal-body">
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label for="modalNewDate" style="font-weight: 600; font-size: 0.9rem;">Datum:</label>
                            <input type="date" id="modalNewDate" name="newDate"
                                   value="@Model.SelectedCompetition.RegistrationUntil.ToString("yyyy-MM-dd")"
                                   required/>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 6px;">
                            <label for="modalNewTime" style="font-weight: 600; font-size: 0.9rem;">Uhrzeit:</label>
                            <input type="time" id="modalNewTime" name="newTime"
                                   value="@Model.SelectedCompetition.RegistrationUntil.ToString("HH:mm")"
                                   required/>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn-action btn-outline-muted" onclick="closeDateModal()">Abbrechen</button>
                        <button type="submit" class="btn-action btn-accent">Speichern</button>
                    </div>
                </form>
            </div>
        </div>
    }

    <partial name="_AdminStrip" model='(Model.SelectedCompetition?.Id, "Neuer Bewerb Name")' />

</main>

<script>
    window.existingTournamentPhases = @Html.Raw(Json.Serialize(Model.Matches.Select(m => m.PhaseName ?? "A-Bewerb").Distinct().ToList()));

    function openInfoModal() {
        const modal = document.getElementById('editInfoModal');
        if (modal) modal.style.display = 'flex';
    }

    function closeInfoModal() {
        const modal = document.getElementById('editInfoModal');
        if (modal) modal.style.display = 'none';
    }

    function openDateModal() {
        const modal = document.getElementById('editDeadlineModal');
        if (modal) modal.style.display = 'flex';
    }

    function closeDateModal() {
        const modal = document.getElementById('editDeadlineModal');
        if (modal) modal.style.display = 'none';
    }

    function filterAllMatches(groupName, btn) {
        // Sync active state of filter pills
        const pillsContainer = document.querySelector('.match-filter-pills');
        if (pillsContainer) {
            pillsContainer.querySelectorAll('.match-filter-btn').forEach(b => {
                const f = b.getAttribute('data-filter');
                if (f === groupName) {
                    b.classList.add('active');
                } else {
                    b.classList.remove('active');
                }
            });
        }

        // Sync select dropdown
        const select = document.getElementById('matchGroupFilterSelect');
        if (select && select.value !== groupName) {
            select.value = groupName;
        }

        // Show/hide matches
        const matches = document.querySelectorAll('#allMatchesList .match-scorecard');
        let visibleCount = 0;

        matches.forEach(card => {
            const grp = card.getAttribute('data-group');
            if (groupName === 'all' || grp === groupName) {
                card.style.display = 'flex';
                visibleCount++;
            } else {
                card.style.display = 'none';
            }
        });

        const msg = document.getElementById('noMatchesFilteredMsg');
        if (msg) {
            msg.style.display = visibleCount === 0 ? 'block' : 'none';
        }
    }
</script>
</body>
</html>