@page
@model TennisBruck.Pages.Championship

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8"/>
    <title>Vereinsmeisterschaft Bruck</title>
    <script src="https://code.jquery.com/jquery-1.8.3.min.js"></script>
    <script src="https://underscorejs.org/underscore-min.js"></script>
    <link rel="stylesheet" href="~/css/championship/app.css"/>
    <link rel="stylesheet" href="~/css/tournament.css"/>
    <script src="js/toggleVisibility.js"></script>
    <script src="js/tournament.js"></script>
</head>
<body>
<div class="championship-container">
    <header class="championship-header">
        <i class="icon">🏆</i>
        <h1>Vereinsmeisterschaft Bruck</h1>
        <i class="icon">🏆</i>
    </header>
    <main>
        <label>@Model.Message</label>
        <!-- Competition Selector -->
        <section class="competition-selector">
            <form method="post" asp-page-handler="CompetitionChanged">
                <div class="select-wrapper">
                    <select class="competition-select" name="selectedCompetitionId" onchange="this.form.submit()">
                        <option value="">Bewerb auswählen</option>
                        @foreach (var competition in Model.Competitions)
                        {
                            <option value="@competition.Id"
                                    selected="@(Model.SelectedCompetition?.Id == competition.Id)">
                                @competition.Name
                            </option>
                        }
                    </select>
                </div>
            </form>

            @if (Model.SelectedCompetition != null)
            {
                <div class="competition-actions">
                    <h3>@Model.SelectedCompetition.Name</h3>
                    <form method="post">
                        <input type="hidden" name="selectedCompetition" value="@Model.SelectedCompetition.Id"/>
                        <button class="registration-button @(Model.IsRegistered ? "unregister" : "register")"
                                asp-page-handler="@(Model.IsRegistered ? "Unregister" : "Register")">
                            @(Model.IsRegistered ? "Abmelden" : "Anmelden")
                        </button>
                    </form>
                </div>
            }
        </section>


        @* Pair configuration (Double) *@
        @if (Model.SelectedCompetition != null && !Model.SelectedCompetition.IsSingle)
        {
            <h2>Paare Konfigurieren</h2>
            <h4>Anzahl der angemeldeten Spieler: @Model.RegisteredCompetitionPlayers.Count</h4>

            <form method="post" asp-page-handler="SavePairs">
                @for (int i = 0; i < Model.RegisteredCompetitionPlayers.Count / 2; i++)
                {
                    var firstPlayer = Model.RegisteredCompetitionPlayers[i * 2];
                    var secondPlayer = Model.RegisteredCompetitionPlayers[i * 2 + 1];

                    <div class="double-assign-container">
                        <div class="double-assign-pair">

                            <div class="double-select-wrapper">
                                <label class="double-label">Spieler A</label>
                                <select class="double-select" name="pairs[@i].SinglePlayerId">
                                    <option value="">Spieler auswählen</option>
                                    @foreach (var registration in Model.RegisteredCompetitionPlayers)
                                    {
                                        if (registration.Id == firstPlayer.Id)
                                        {
                                            <option value="@registration.Id"
                                                    selected="selected">@registration.Player.ToString()</option>
                                        }
                                        else
                                        {
                                            <option value="@registration.Id">@registration.Player.ToString()</option>
                                        }
                                    }
                                </select>
                            </div>

                            <span class="double-separator">+</span>

                            <div class="double-select-wrapper">
                                <label class="double-label">Spieler B</label>
                                <select class="double-select" name="pairs[@i].DoublePlayerId">
                                    <option value="">Spieler auswählen</option>
                                    @foreach (var registration in Model.RegisteredCompetitionPlayers)
                                    {
                                        if (registration.Id == secondPlayer.Id)
                                        {
                                            <option value="@registration.Id"
                                                    selected="selected">@registration.Player.ToString()</option>
                                        }
                                        else
                                        {
                                            <option value="@registration.Id">@registration.Player.ToString()</option>
                                        }
                                    }
                                </select>
                            </div>

                        </div>
                    </div>
                }
                <button type="submit">Speichern</button>
            </form>
        }


        <!-- Group Management -->
        <section class="groups-section">
            <div class="section-header">
                <h2><i class="icon">👥</i> Gruppen</h2>
                @if (Model.SelectedCompetition != null)
                {
                    <form method="post">
                        <button class="add-group-button" asp-page-handler="CreateGroup">➕ Gruppe erstellen</button>
                    </form>
                }
            </div>
            
            <div class="group-container">
                @foreach (var group in Model.Groups)
                {
                    <div class="group-card">
                        <div class="group-header">
                            <h3>@group.GroupName</h3>
                            <div class="group-actions">
                                <form method="post">
                                    <input type="hidden" name="groupId" value="@group.Id"/>
                                    <button class="icon-button increase" asp-page-handler="IncreaseGroupSize">➕</button>
                                    <button class="icon-button decrease" asp-page-handler="DecreaseGroupSize">⬇️
                                    </button>
                                    <button class="icon-button delete" asp-page-handler="DeleteGroup">🗑️</button>
                                </form>
                            </div>
                        </div>

                        <table class="player-table">
                            <thead>
                            <tr>
                                <th>Spieler</th>
                                <th>Punkte</th>
                            </tr>
                            </thead>
                            <tbody>

                            @for (int i = 0; i < group.MaxAmount; i++)
                            {
                                var groupTeam = group.GroupTeams.ElementAtOrDefault(i);
                                <tr>
                                    <td colspan="3">
                                        <form method="post" asp-page-handler="AddSinglePlayer">
                                            <input type="hidden" name="groupId" value="@group.Id"/>
                                            <input type="hidden" name="competitionId"
                                                   value="@group.Competition.Id"/>
                                            <select class="player-select" name="teamId"
                                                    onchange="this.form.submit()">
                                                @if (groupTeam != null)
                                                {
                                                    <option selected="selected"
                                                            value="@groupTeam.Team.Id">@groupTeam.Team.PlayersToString()</option>
                                                }
                                                else
                                                {
                                                    <option value="">Spieler auswählen</option>
                                                }
                                                @foreach (var team in Model.RegisteredTeams)
                                                {
                                                    <option value="@team.Id"> @team.PlayersToString() </option>
                                                }
                                            </select>
                                        </form>
                                    </td>
                                    <td>@groupTeam?.Points</td>
                                    @if (Model.CurrentPlayer.IsAdmin)
                                    {
                                        <td>
                                            <form method="post">
                                                <input type="hidden" name="groupId" value="@group.Id"/>
                                                <input type="hidden" name="playerId"
                                                       value="@if (groupTeam != null) { @groupTeam.Team.Id }"/>
                                                <button class="icon-button delete"
                                                        asp-page-handler="RemovePlayerFromGroup">❌
                                                </button>
                                            </form>
                                        </td>
                                    }
                                </tr>
                            }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
            @if (Model.SelectedCompetition != null)
            {
                <form method="post" class="save-groups">
                    <button class="save-button" asp-page-handler="SaveGroups">💾 Diese Gruppen Einteilung speichern
                    </button>
                </form>
            }
        </section>


        <!-- Matches -->
        <section class="matches-section">
            <h2>Deine Spiele</h2>
            <div class="matches-list">
                @foreach (var match in Model.PersonalMatches)
                {
                    <div class="match-card">
                        <form method="post">
                            <input type="hidden" name="matchId" value="@match.Id"/>
                            <div class="match-header">
                                <span class="match-players">
                                    @string.Join(" / ", match.Team1.Players.Select(tp => tp.Player.ToString()))
                                    vs
                                    @string.Join(" / ", match.Team2.Players.Select(tp => tp.Player.ToString()))
                                </span>
                                <span class="match-competition">
                                    @(match.Group != null ? match.Group.Competition.Name : "K.O Phase")
                                </span>
                            </div>

                            @if (match.Sets == null || !match.Sets.Any())
                            {
                                <div class="match-input">
                                    <input type="text" name="score" placeholder="x:x x:x …"/>
                                    <button class="save-score" asp-page-handler="SaveMatch">Spielstand speichern
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="match-result">
                                    <span class="sets">@match.SetToString()</span>
                                    @if (match.Team1.Id == Model.CurrentPlayer.Id || match.Team2?.Id == Model.CurrentPlayer.Id || Model.CurrentPlayer.IsAdmin)
                                    {
                                        <button class="delete-result" asp-page-handler="DeleteMatch">Ergebnis löschen
                                        </button>
                                    }
                                </div>
                            }
                        </form>
                    </div>
                }
            </div>
        </section>


        @{
            ViewData["Title"] = "Tournament Bracket";
            var grouped = Model.Matches.GroupBy(m => m.RoundNo).OrderBy(g => g.Key);
        }

        @if (Model.SelectedCompetition != null)
        {
            <section class="tournament-section">
                <h2 class="bracket-title">K.O. Phase</h2>

                <form method="post">
                    <div class="tournament-controls">
                        <label for="SelectedSize">Größe:</label>
                        <select asp-for="SelectedSize">
                            <option value="2">2</option>
                            <option value="4">4</option>
                            <option value="8">8</option>
                            <option value="16">16</option>
                            <option value="32">32</option>
                        </select>
                        <button type="submit" asp-page-handler="CreateBracket">Create / Update Bracket</button>
                    </div>

                    @if (Model.Matches.Any() && Model.SelectedCompetition != null)
                    {
                        <div class="brackets">
                            <div class="group">
                                @foreach (var round in grouped)
                                {
                                    <div class="r@round.Key">
                                        @foreach (var match in round)
                                        {
                                            if (match.IsBye)
                                            {
                                                <div></div>
                                            }
                                            else
                                            {
                                                var index = match.BracketNo - 1;

                                                <div>
                                                    <div class="bracketbox">
                                                        <input type="hidden" name="Inputs[@index].BracketNo"
                                                               value="@match.BracketNo"/>
                                                        <span class="info">Match @match.BracketNo</span>

                                                        @* Select box for Team1 *@
                                                        <select name="Inputs[@index].Team1Id" class="teama">
                                                            <option value="">-- Team 1 --</option>
                                                            @foreach (var team in Model.RegisteredTeams) @* Alle Teams der Competition *@
                                                            {
                                                                <option value="@team.Id"
                                                                        selected="@(match.Team1?.Id == team.Id)">
                                                                    @string.Join(" / ", team.Players.Select(tp => tp.Player.ToString()))
                                                                </option>
                                                            }
                                                        </select>

                                                        @* Select box for Team2 *@
                                                        <select name="Inputs[@index].Team2Id" class="teamb">
                                                            <option value="">-- Team 2 --</option>
                                                            @foreach (var team in Model.RegisteredTeams)
                                                            {
                                                                <option value="@team.Id"
                                                                        selected="@(match.Team2?.Id == team.Id)">
                                                                    @string.Join(" / ", team.Players.Select(tp => tp.Player.ToString()))
                                                                </option>
                                                            }
                                                        </select>

                                                        @if (match.Sets != null && match.Sets.Any())
                                                        {
                                                            <div class="match-result"
                                                                 style="margin-top:0.5rem; font-weight:600;">
                                                                Result:
                                                                <span style="color:#2563eb;">
                                                        @foreach (var set in match.Sets)
                                                                    {
                                                                        @($"{set.Player1GamesWon}:{set.Player2GamesWon} ")
                                                                    }
                                                    </span>
                                                            </div>
                                                        }
                                                    </div>
                                                </div>
                                            }
                                        }
                                    </div>
                                }
                            </div>
                        </div>

                        <div class="tournament-controls">
                            <button type="submit" asp-page-handler="ApplyUserInputs">Update Results</button>
                        </div>
                    }
                </form>
            </section>
        }
        <!-- Info Section -->
        <section class="info-section">
            <button type="button" class="info-toggle" onclick="toggleInfo()">⬇️ Mehr Infos</button>
            <div id="infoBox" class="info-content" style="display: none;">
                <div class="registered-players">
                    <h3><i class="icon">👤</i> Angemeldete Spieler</h3>
                    <table class="players-table">
                        @foreach (var player in Model.RegisteredCompetitionPlayers)
                        {
                            <tr>
                                <td>@player.ToString()</td>
                                @if (Model.CurrentPlayer.IsAdmin)
                                {
                                    <td>
                                        <form method="post">
                                            <input type="hidden" name="playerId" value="@player.Id"/>
                                            <button class="icon-button delete"
                                                    asp-page-handler="RemoveSinglePlayerFromCompetition">🗑️
                                            </button>
                                        </form>
                                    </td>
                                }
                            </tr>
                        }
                    </table>
                </div>

                @if (Model.CurrentPlayer.IsAdmin)
                {
                    <div class="admin-controls">
                        <form method="post" class="competition-creation">
                            <input type="text" name="competitionName" class="competition-input"
                                   placeholder="Neuer Bewerb Name"/>
                            <input id="radioSingle" type="radio" name="isSingle" value="true"/>
                            <label for="radioSingle">Einzel</label>
                            <input id="radioDouble" type="radio" name="isSingle" value="false"/>
                            <label for="radioDouble">Doppel</label>
                            <button class="create-competition" asp-page-handler="CreateCompetition">➕ Bewerb erstellen
                            </button>
                        </form>

                        @if (Model.SelectedCompetition != null)
                        {
                            <form method="post">
                                <input type="hidden" name="competitionId" value="@Model.SelectedCompetition.Id"/>
                                <button class="delete-competition" asp-page-handler="DeleteCompetition">🗑️ Diesen Bewerb
                                    löschen
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>
        </section>
    </main>

    <footer class="championship-footer">
        <form method="post">
            <button class="back-button" asp-page-handler="Back">Zurück</button>
        </form>
    </footer>
</div>
</body>
</html>
