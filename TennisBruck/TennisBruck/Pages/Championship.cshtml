@page
@model TennisBruck.Pages.Championship

@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vereinsmeisterschaft Bruck</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <script src="https://code.jquery.com/jquery-1.8.3.min.js"></script>
    <script src="https://underscorejs.org/underscore-min.js"></script>
    <link rel="stylesheet" href="~/css/tournament.css" asp-append-version="true"/>
    <script src="js/toggleVisibility.js"></script>
    <script src="js/tournament.js"></script>
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <form method="post" class="inline-form-zero">
            <button type="submit" asp-page-handler="Back" class="btn-back-header">
                ← Übersicht
            </button>
        </form>
    </div>
    <h1 class="app-title">🏆 Vereinsmeisterschaft Bruck 🏆</h1>

    <form method="post" asp-page-handler="CompetitionChanged">
        <div class="competition-pills">
            @foreach (var competition in Model.Competitions)
            {
                var isActive = Model.SelectedCompetition?.Id == competition.Id;
                <button type="submit" name="selectedCompetitionId" value="@competition.Id"
                        class="pill-btn @(isActive ? "active" : "")">
                    @competition.Name
                </button>
            }
        </div>
    </form>
</header>

<main class="main-container">
    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-success">
            @Model.Message
        </div>
    }

    @if (Model.SelectedCompetition != null)
    {
        <section class="modern-card">
            <div class="competition-info-flex">
                <div>
                    <h2 class="competition-title">@Model.SelectedCompetition.Name</h2>
                    <p class="registration-text">
                        Anmeldeschluss: <strong
                            class="text-dark">@Model.SelectedCompetition.RegistrationUntil.ToString("dd.MM.yyyy HH:mm")</strong>
                    </p>
                </div>

                <form method="post" class="competition-action-form">
                    <input type="hidden" name="selectedCompetition" value="@Model.SelectedCompetition.Id"/>
                    @if (Model.SelectedCompetition.RegistrationUntil >= DateTime.Now)
                    {
                        <button class="btn-action btn-large-shadow @(Model.IsRegistered ? "btn-danger" : "btn-accent")"
                                asp-page-handler="@(Model.IsRegistered ? "Unregister" : "Register")">
                            @(Model.IsRegistered ? "❌ Wieder abmelden" : "🎾 Jetzt Teilnehmen")
                        </button>
                    }
                    else
                    {
                        <span class="badge-closed">Anmeldung geschlossen</span>
                        @if (Model.IsRegistered)
                        {
                            <button class="btn-action btn-warning" asp-page-handler="SelfWithdraw"
                                    onclick="return confirm('Möchtest du das Turnier wirklich komplett abbrechen? ALLE deine noch offenen Matches werden als Sieg (w.o.) für deine Gegner gewertet. Das kann nicht rückgängig gemacht werden!');">
                                Turnier abbrechen (w.o.)
                            </button>
                        }
                    }
                    <span class="badge-count">Spieler: @Model.RegisteredCompetitionPlayers.Count</span>
                </form>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <form method="post" class="admin-time-form">
                    <span class="text-sm text-muted">Admin-Anpassung:</span>
                    <input type="date" name="newDate"
                           value="@Model.SelectedCompetition.RegistrationUntil.ToString("yyyy-MM-dd")"
                           class="input-auto"/>
                    <input type="time" name="newTime"
                           value="@Model.SelectedCompetition.RegistrationUntil.ToString("HH:mm")" class="input-auto"/>
                    <button asp-page-handler="SaveNewDate" class="btn-action btn-sm">Zeit updaten</button>
                </form>
            }
        </section>

        @if (!Model.SelectedCompetition.IsSingle)
        {
            <section class="modern-card">
                <div class="card-header">
                    <h2>👥 Doppel-Paare Konfigurieren</h2>
                    <form method="post" class="m-0">
                        <input type="hidden" name="ChampionshipId" value="@Model.SelectedCompetition.Id"/>

                        <button type="submit" asp-page-handler="GeneratePairs" class="btn-action">
                            🔀 Doppel-Paare zufällig auslosen
                        </button>
                    </form>
                </div>

                @{
                    int totalPairs = Model.RegisteredCompetitionPlayers.Count / 2;
                }

                <form method="post">
                    <input type="hidden" name="ChampionshipId" value="@Model.SelectedCompetition?.Id"/>

                    <div class="pairs-grid-container">
                        @for (int i = 0; i < totalPairs; i++)
                        {
                            var currentTeam = (Model.RegisteredTeams != null && i < Model.RegisteredTeams.Count) ? Model.RegisteredTeams[i] : null;
                            var firstPlayer = currentTeam?.TeamPlayers?.ElementAtOrDefault(0)?.Player;
                            var secondPlayer = currentTeam?.TeamPlayers?.ElementAtOrDefault(1)?.Player;

                            <div class="pair-card">
                                <div
                                    style="font-weight: bold; border-bottom: 2px solid #e9ecef; padding-bottom: 10px; margin-bottom: 15px;">
                                    Paar @(i + 1)
                                </div>

                                @if (currentTeam != null && User.IsInRole("Admin"))
                                {
                                    <input type="hidden" name="pairs[@i].TeamId" value="@currentTeam.Id"/>
                                }

                                <div class="players-flex-row">
                                    <div class="player-column">
                                        <label class="player-label">Spieler A</label>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <select name="pairs[@i].SinglePlayerId" class="player-select">
                                                <option value="">Auswählen...</option>
                                                @foreach (var registration in Model.RegisteredCompetitionPlayers)
                                                {
                                                    bool isSelected = (firstPlayer != null && registration.Player.Id == firstPlayer.Id);
                                                    <option value="@registration.Player.Id" selected="@isSelected">
                                                        @registration.Player.ToString()
                                                    </option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <div class="player-select" style="background-color: #e9ecef;">
                                                @(firstPlayer != null ? firstPlayer.ToString() : "Offen")
                                            </div>
                                        }
                                    </div>

                                    <div class="plus-symbol">+</div>

                                    <div class="player-column">
                                        <label class="player-label">Spieler B</label>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <select name="pairs[@i].DoublePlayerId" class="player-select">
                                                <option value="">Auswählen...</option>
                                                @foreach (var registration in Model.RegisteredCompetitionPlayers)
                                                {
                                                    bool isSelected = (secondPlayer != null && registration.Player.Id == secondPlayer.Id);
                                                    <option value="@registration.Player.Id" selected="@isSelected">
                                                        @registration.Player.ToString()
                                                    </option>
                                                }
                                            </select>
                                        }
                                        else
                                        {
                                            <div class="player-select" style="background-color: #e9ecef;">
                                                @(secondPlayer != null ? secondPlayer.ToString() : "Offen")
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>

                </form>
                @if (User.IsInRole("Admin"))
                {
                    <div class="d-flex justify-content-center align-items-center gap-3 mt-4 mb-5">
                        <form method="post" asp-page-handler="SavePairs">
                            <div class="group-save-wrapper m-0">
                                <button type="submit" class="btn-action btn-accent">
                                    💾 Paare Speichern
                                </button>
                            </div>
                        </form>

                    </div>
                }

            </section>
        }

        @if (Model.Groups.Any() || User.IsInRole("Admin"))
        {
            <section class="modern-card">
                <div class="card-header">
                    <h2>📊 Gruppenphase</h2>
                    @if (User.IsInRole("Admin"))
                    {
                        <form method="post">
                            <button class="btn-action" asp-page-handler="CreateGroup">➕ Gruppe hinzufügen</button>
                        </form>
                    }
                </div>

                <form method="post">
                    <input type="hidden" name="competitionId" value="@Model.SelectedCompetition.Id"/>

                    <div class="group-generator-toolbar">
                        <label for="targetGroupSize" class="toolbar-label">
                            Wunsch-Gruppengröße:
                        </label>

                        <input type="number" id="targetGroupSize" name="TargetGroupSize"
                               class="toolbar-input" value="4" min="2" max="10" required/>
        
                        <button type="submit" asp-page-handler="GenerateGroups" class="btn-generate">
                            Zufällig Auslosen
                        </button>
                    </div>
                </form>

                <div class="group-grid">
                    @foreach (var group in Model.Groups)
                    {
                        <div class="group-panel">
                            <div class="group-panel-header">
                                <strong class="group-panel-title">@group.GroupName</strong>
                                @if (User.IsInRole("Admin"))
                                {
                                    <form method="post" class="group-admin-actions">
                                        <input type="hidden" name="groupId" value="@group.Id"/>
                                        <button class="btn-action btn-icon-sm" title="Größer"
                                                asp-page-handler="IncreaseGroupSize">➕
                                        </button>
                                        <button class="btn-action btn-icon-sm" title="Kleiner"
                                                asp-page-handler="DecreaseGroupSize">➖
                                        </button>
                                        <button class="btn-delete-icon" title="Löschen" asp-page-handler="DeleteGroup">
                                            🗑️
                                        </button>
                                    </form>
                                }
                            </div>

                            <div class="group-panel-body">
                                @for (int i = 0; i < group.MaxAmount; i++)
                                {
                                    // Wir holen uns die sicher berechneten Daten für diese Zeile
                                    var tableEntry = Model.GroupTables.TryGetValue(group.Id, out var table) ? table.ElementAtOrDefault(i) : null;

                                    // Das ist dein Original-Objekt, das wir für die Team-Namen und den Lösch-Button brauchen
                                    var groupTeam = tableEntry?.GroupTeam ?? group.GroupTeams.ElementAtOrDefault(i);

                                    <div class="group-team-row">
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <form method="post" asp-page-handler="AddSinglePlayer" class="flex-1">
                                                <input type="hidden" name="groupId" value="@group.Id"/>
                                                <input type="hidden" name="competitionId"
                                                       value="@group.Competition.Id"/>
                                                <select name="teamId" onchange="this.form.submit()" class="select-sm">
                                                    <option value="">Freilos</option>
                                                    @if (groupTeam != null)
                                                    {
                                                        <option selected="selected"
                                                                value="@groupTeam.Team.Id">@groupTeam.Team.PlayersToString()</option>
                                                    }
                                                    @foreach (var team in Model.RegisteredTeams)
                                                    {
                                                        <option value="@team.Id">@team.PlayersToString()</option>
                                                    }
                                                </select>
                                            </form>
                                        }
                                        else
                                        {
                                            <span
                                                class="fw-500">@(groupTeam != null ? groupTeam.Team.PlayersToString() : "TBD")</span>
                                        }

                                        <div class="group-score-wrapper">
                                            @if (tableEntry != null)
                                            {
                                                <span class="group-points"
                                                      title="Punkte (Siege)">@tableEntry.Points</span>
                                                <span class="group-points"
                                                      title="Games (Gewonnen:Verloren)">@tableEntry.GamesWon:@tableEntry.GamesLost</span>
                                            }
                                            else
                                            {
                                                <span class="group-points">0</span>
                                                <span class="group-points">0:0</span>
                                            }

                                            @if (User.IsInRole("Admin") && groupTeam != null)
                                            {
                                                <form method="post">
                                                    <input type="hidden" name="groupId" value="@group.Id"/>
                                                    <input type="hidden" name="teamId" value="@groupTeam.Team.Id"/>
                                                    <button class="btn-delete-icon"
                                                            asp-page-handler="RemoveTeamFromGroup">❌
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>

                @if (User.IsInRole("Admin") && Model.Groups.Any())
                {
                    <form method="post" class="group-save-wrapper">
                        <button type="submit" asp-page-handler="SaveGroups"
                                class="btn-action btn-accent btn-large-accent-shadow">
                            💾 Gruppeneinteilung speichern
                        </button>
                    </form>
                }
            </section>
        }


        var grouped = Model.Matches.GroupBy(m => m.RoundNo).OrderBy(g => g.Key).ToList();

        if (grouped.Any() || User.IsInRole("Admin"))
        {
            <section class="modern-card">
                <div class="card-header">
                    <h2>⚔️ K.O. Phase</h2>
                    @if (User.IsInRole("Admin"))
                    {
                        <form method="post" class="bracket-admin-form">
                            <select asp-for="SelectedSize" class="bracket-select-w150">
                                <option value="2">Finale (2)</option>
                                <option value="4">Halbfinale (4)</option>
                                <option value="8">Viertelfinale (8)</option>
                                <option value="16">Achtelfinale (16)</option>
                                <option value="32">32er (32)</option>
                            </select>
                            <button type="submit" asp-page-handler="CreateBracket" class="btn-action">Raster bauen
                            </button>
                        </form>
                    }
                </div>

                <div class="bracket-scroll-area">
                    <form method="post">
                        <div class="bracket-flex">
                            @foreach (var round in grouped)
                            {
                                <div class="bracket-col">
                                    @foreach (var match in round)
                                    {
                                        @if (match.IsBye)
                                        {
                                            <div class="bracket-bye"></div>
                                        }
                                        else
                                        {
                                            var index = match.BracketNo - 1;
                                            <div class="match-scorecard bracket-match-card">
                                                <input type="hidden" name="Inputs[@index].BracketNo"
                                                       value="@match.BracketNo"/>
                                                <div class="bracket-match-info">Match @match.BracketNo</div>

                                                @if (User.IsInRole("Admin"))
                                                {
                                                    <select name="Inputs[@index].Team1Id" class="bracket-select">
                                                        <option value="">Team 1 wählen</option>
                                                        @foreach (var team in Model.RegisteredTeams)
                                                        {
                                                            <option value="@team.Id"
                                                                    selected="@(match.Team1?.Id == team.Id)">@team.PlayersToString()</option>
                                                        }
                                                    </select>
                                                    <select name="Inputs[@index].Team2Id" class="bracket-select">
                                                        <option value="">Team 2 wählen</option>
                                                        @foreach (var team in Model.RegisteredTeams)
                                                        {
                                                            <option value="@team.Id"
                                                                    selected="@(match.Team2?.Id == team.Id)">@team.PlayersToString()</option>
                                                        }
                                                    </select>
                                                }
                                                else
                                                {
                                                    <div
                                                        class="bracket-team-read-1 @(match.IsWalkover && match.WalkoverTeamId == match.Team1?.Id ? "team-walkover" : "")">
                                                        @(match.Team1?.PlayersToString() ?? "TBD") @(match.IsWalkover && match.WalkoverTeamId == match.Team2?.Id ? "✅" : "")
                                                    </div>
                                                    <div
                                                        class="bracket-team-read-2 @(match.IsWalkover && match.WalkoverTeamId == match.Team2?.Id ? "team-walkover" : "")">
                                                        @(match.Team2?.PlayersToString() ?? "TBD") @(match.IsWalkover && match.WalkoverTeamId == match.Team1?.Id ? "✅" : "")
                                                    </div>
                                                }

                                                @if (match.IsWalkover)
                                                {
                                                    var winnerName = match.WalkoverTeamId == match.Team1?.Id ? match.Team2?.PlayersToString() : match.Team1?.PlayersToString();
                                                    <div class="bracket-result text-warning fw-bold">w.o.
                                                        (Sieger: @winnerName)
                                                    </div>
                                                }
                                                else if (match.Sets != null && match.Sets.Any())
                                                {
                                                    <div class="bracket-result">
                                                        @match.SetToString()
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                        @if (User.IsInRole("Admin") && grouped.Any())
                        {
                            <button type="submit" asp-page-handler="ApplyUserInputs"
                                    class="btn-action btn-accent bracket-save-btn">
                                Zuteilung im Raster speichern
                            </button>
                        }
                    </form>
                </div>
            </section>
        }


        @if (Model.PersonalMatches.Any())
        {
            <section class="modern-card card-accent-border">
                <div class="card-header">
                    <h2>🎾 Deine nächsten Matches</h2>
                </div>

                @foreach (var match in Model.PersonalMatches)
                {
                    <div class="match-scorecard">
                        <div class="match-players">
                            <span
                                class="@(match.IsWalkover && match.WalkoverTeamId == match.Team1?.Id ? "team-walkover" : (match.IsWalkover && match.WalkoverTeamId == match.Team2?.Id ? "team-walkover-winner" : ""))">
                                @match.Team1?.PlayersToString() @(match.IsWalkover && match.WalkoverTeamId == match.Team2?.Id ? "✅" : "")
                            </span>

                            <span class="text-vs">vs</span>

                            <span
                                class="@(match.IsWalkover && match.WalkoverTeamId == match.Team2?.Id ? "team-walkover" : (match.IsWalkover && match.WalkoverTeamId == match.Team1?.Id ? "team-walkover-winner" : ""))">
                                @match.Team2?.PlayersToString() @(match.IsWalkover && match.WalkoverTeamId == match.Team1?.Id ? "✅" : "")
                            </span>
                            <span class="badge-phase">
                                @(match.Group != null ? match.Group.Competition.Name : "K.O Phase")
                            </span>
                        </div>

                        <form method="post" class="match-action-form">
                            <input type="hidden" name="matchId" value="@match.Id"/>

                            @if (match.IsWalkover)
                            {
                                var winnerName = match.WalkoverTeamId == match.Team1?.Id ? match.Team2?.PlayersToString() : match.Team1?.PlayersToString();
                                <div class="match-score text-warning fw-bold">w.o. (Sieger: @winnerName)</div>
                                @if (match.Team1?.TeamPlayers.Any(x => x.PlayerId == Model.CurrentPlayer.Id) == true || match.Team2?.TeamPlayers.Any(x => x.PlayerId == Model.CurrentPlayer.Id) == true)
                                {
                                    <button class="btn-action btn-danger btn-xs" asp-page-handler="DeleteMatch">
                                        Rückgängig
                                    </button>
                                }
                            }
                            else if (match.Sets == null || !match.Sets.Any())
                            {
                                <div class="flex-center-gap">
                                    <input type="text" name="score" placeholder="6:4 6:2" class="input-score"/>
                                    <button class="btn-action btn-accent" asp-page-handler="SaveMatch">Eintragen
                                    </button>
                                    <button type="submit" class="btn-action btn-warning btn-sm"
                                            asp-page-handler="GiveWalkover"
                                            onclick="return confirm('Möchtest du dieses Match wirklich aufgeben? Dein Gegner gewinnt durch w.o.');">
                                        W.O. geben
                                    </button>
                                </div>
                            }
                            else
                            {
                                <div class="match-score">@match.SetToString()</div>
                                @if (match.Team1?.TeamPlayers.Any(x => x.PlayerId == Model.CurrentPlayer.Id) == true || match.Team2?.TeamPlayers.Any(x => x.PlayerId == Model.CurrentPlayer.Id) == true)
                                {
                                    <button class="btn-action btn-danger btn-xs" asp-page-handler="DeleteMatch">
                                        Rückgängig
                                    </button>
                                }
                            }
                        </form>
                    </div>
                }
            </section>
        }

        <div class="toggle-info-wrapper">
            <button type="button" onclick="toggleInfo()" class="btn-action btn-outline-muted">
                ⬇️ Teilnehmer & Alle Spiele einblenden
            </button>
        </div>

        <div id="infoBox" style="display: none;">
            <section class="modern-card mb-24">
                <div class="card-header">
                    <h2>📋 Teilnehmerliste (@Model.RegisteredCompetitionPlayers.Count)</h2>
                </div>

                <div class="participants-wrapper">
                    @foreach (var registered in Model.RegisteredCompetitionPlayers)
                    {
                        <div class="participant-badge">
                            @registered.Player.ToString()
                            @if (User.IsInRole("Admin"))
                            {
                                <form method="post" class="inline-form-zero flex-center-gap">
                                    <input type="hidden" name="playerId" value="@registered.Player.Id"/>
                                    <input type="hidden" name="competitionId" value="@Model.SelectedCompetition.Id"/>

                                    <button asp-page-handler="WithdrawPlayer"
                                            class="btn-warning btn-xs btn-action-micro"
                                            title="Spieler w.o. abmelden"
                                            onclick="return confirm('Soll dieser Spieler wirklich verletzungsbedingt/w.o. abgemeldet werden? ALLE seine offenen Matches in diesem Bewerb werden sofort als Sieg für die Gegner gewertet!');">
                                        Alles W.O.
                                    </button>
                                </form>
                            }
                        </div>
                    }
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="manual-add-wrapper">
                        <h4 class="manual-add-title">Spieler manuell hinzufügen</h4>
                        <form method="post" class="manual-add-form">
                            <select name="playerId">
                                <option value="">Spieler auswählen...</option>
                                @foreach (var player in Model.UnregisteredPlayers)
                                {
                                    <option value="@player.Id">@player.ToString()</option>
                                }
                            </select>
                            <button asp-page-handler="Register" class="btn-action btn-accent white-space-nowrap">
                                Hinzufügen
                            </button>
                        </form>
                    </div>
                }
            </section>

            <section class="modern-card mb-24">
                <div class="card-header">
                    <h2>🎾 Alle Matches in diesem Bewerb</h2>
                </div>
                @foreach (var match in Model.AllMatches)
                {
                    @if (match.Team1 != null && match.Team2 != null)
                    {
                        <div class="match-scorecard">
                            <div class="match-players text-sm">
                                <span
                                    class="@(match.IsWalkover && match.WalkoverTeamId == match.Team1?.Id ? "team-walkover" : (match.IsWalkover && match.WalkoverTeamId == match.Team2?.Id ? "team-walkover-winner" : ""))">
                                    @match.Team1?.PlayersToString() @(match.IsWalkover && match.WalkoverTeamId == match.Team2?.Id ? "✅" : "")
                                </span>

                                <span class="text-vs">vs</span>

                                <span
                                    class="@(match.IsWalkover && match.WalkoverTeamId == match.Team2?.Id ? "team-walkover" : (match.IsWalkover && match.WalkoverTeamId == match.Team1?.Id ? "team-walkover-winner" : ""))">
                                    @match.Team2?.PlayersToString() @(match.IsWalkover && match.WalkoverTeamId == match.Team1?.Id ? "✅" : "")
                                </span>
                                <span class="badge-phase">
                                    @(match.Group != null ? match.Group.Competition.Name : "K.O Phase")
                                </span>
                            </div>

                            @if (User.IsInRole("Admin"))
                            {
                                <form method="post" class="match-action-form">
                                    <input type="hidden" name="matchId" value="@match.Id"/>

                                    @if (match.IsWalkover)
                                    {
                                        var winnerName = match.WalkoverTeamId == match.Team1?.Id ? match.Team2?.PlayersToString() : match.Team1?.PlayersToString();
                                        <div class="match-score text-warning fw-bold">w.o. (Sieger: @winnerName)</div>
                                        <button class="btn-action btn-danger btn-xs" asp-page-handler="DeleteMatch">
                                            Löschen
                                        </button>
                                    }
                                    else if (match.Sets == null || !match.Sets.Any())
                                    {
                                        <div class="flex-center-gap">
                                            <input type="text" name="score" placeholder="6:4 6:2"
                                                   class="input-score-sm"/>
                                            <button class="btn-action btn-xs" asp-page-handler="SaveMatch">Speichern
                                            </button>

                                            <button type="submit" class="btn-action btn-warning btn-xs"
                                                    asp-page-handler="AdminWalkover" name="walkoverTeamId"
                                                    value="@if (match.Team1 != null) { @match.Team1.Id }"
                                                    title="T1 aufgeben">
                                                W.O. T1
                                            </button>
                                            <button type="submit" class="btn-action btn-warning btn-xs"
                                                    asp-page-handler="AdminWalkover" name="walkoverTeamId"
                                                    value="@if (match.Team2 != null) { @match.Team2.Id }"
                                                    title="T2 aufgeben">
                                                W.O. T2
                                            </button>
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="match-score">@match.SetToString()</div>
                                        <button class="btn-action btn-danger btn-xs" asp-page-handler="DeleteMatch">
                                            Löschen
                                        </button>
                                    }
                                </form>
                            }
                            else
                            {
                                @if (match.IsWalkover)
                                {
                                    var winnerName = match.WalkoverTeamId == match.Team1?.Id ? match.Team2?.PlayersToString() : match.Team1?.PlayersToString();
                                    <div class="match-score text-warning fw-bold">w.o. (Sieger: @winnerName)</div>
                                }
                                else
                                {
                                    <div
                                        class="match-score">@(match.Sets != null && match.Sets.Any() ? match.SetToString() : "Offen")</div>
                                }
                            }
                        </div>
                    }
                }
            </section>
        </div>
    }
    else
    {
        <div class="empty-state">
            <div class="empty-state-icon">🎾</div>
            <h2>Wähle oben einen Bewerb aus</h2>
            <p>Um die Gruppen, das Raster und deine Spiele zu sehen.</p>
        </div>
    }

    @if (User.IsInRole("Admin"))
    {
        <section class="admin-strip">
            <h3 class="admin-strip-title">⚠️ Admin Bereich</h3>
            <div class="admin-strip-flex">

                <form method="post" class="admin-create-form">
                    <input type="text" name="competitionName" placeholder="Neuer Bewerb Name" required
                           class="flex-1"/>
                    <div class="admin-radio-wrapper">
                        <input id="radioSingle" type="radio" name="isSingle" value="true" checked/>
                        <label for="radioSingle" class="admin-radio-label">Einzel</label>
                        <input id="radioDouble" type="radio" name="isSingle" value="false"/>
                        <label for="radioDouble" class="admin-radio-label">Doppel</label>
                    </div>
                    <button class="btn-action" asp-page-handler="CreateCompetition">Erstellen</button>
                </form>

                @if (Model.SelectedCompetition != null)
                {
                    <form method="post">
                        <input type="hidden" name="competitionId" value="@Model.SelectedCompetition!.Id"/>
                        <button class="btn-action btn-danger" asp-page-handler="DeleteCompetition"
                                onclick="return confirm('Diesen Bewerb wirklich unwiderruflich löschen?');">
                            Aktuellen Bewerb löschen
                        </button>
                    </form>
                }
            </div>
        </section>
    }

</main>
</body>
</html>