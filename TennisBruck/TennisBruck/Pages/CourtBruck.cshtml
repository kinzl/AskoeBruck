@page
@model TennisBruck.Pages.CourtBruck

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Platzreservierung</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/courtBruck.css" asp-append-version="true">
    <script src="~/js/courtBruckWeather.js" asp-append-version="true"></script>
    <script src="~/js/courtBruck.js" asp-append-version="true"></script>
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <button onclick="window.location.href = '/Index'" class="btn-back-header">
            ← Übersicht
        </button>
    </div>

    <h1 class="app-title">Platz reservieren</h1>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-box @(Model.IsError ? "alert-error" : "alert-success")">
            <span class="alert-icon">@(Model.IsError ? "⚠️" : "✅")</span>
            <span>@Model.Message</span>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
</header>

<main class="main-container @(!string.IsNullOrEmpty(Model.Message) ? "has-message" : "")">
    <section class="modern-card">
        <div class="date-nav-wrapper">
            <a href="?date=@Model.CurrentDate.AddDays(-1).ToString("yyyy-MM-dd")" class="btn-date">◀</a>

            <form method="get" class="date-picker-form">
                <input type="date" name="date" value="@Model.CurrentDate.ToString("yyyy-MM-dd")"
                       class="date-picker-input" onchange="this.form.submit()">
            </form>

            <a href="?date=@Model.CurrentDate.AddDays(1).ToString("yyyy-MM-dd")" class="btn-date">▶</a>
        </div>

        @if (Model.CurrentPlayer != null)
        {
            <div class="admin-panel">
                <h3 class="admin-panel-title">Block-Reservierung eintragen</h3>

                <form method="post" asp-page-handler="CreateEvent" class="admin-form">
                    <input type="hidden" name="currentDateStr" value="@Model.CurrentDate.ToString("yyyy-MM-dd")"/>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="form-group-flex">
                            <label class="form-label">Event Name</label>
                            <input type="text" name="eventName" placeholder="z.B. Meisterschaft" class="form-input">
                        </div>
                    }
                    <div>
                        <label class="form-label">Platz</label>
                        <select name="courtNumber" class="form-input">
                            <option value="1">Platz 1</option>
                            <option value="2">Platz 2</option>
                            <option value="3">Platz 3</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Von (Uhrzeit)</label>
                        <input type="time" name="startTimeStr" required class="form-input">
                    </div>

                    <div>
                        <label class="form-label">Bis (Uhrzeit)</label>
                        <input type="time" name="endTimeStr" required class="form-input">
                    </div>

                    <button type="submit" class="btn-action btn-accent btn-admin-reserve">Reservieren</button>
                </form>
            </div>
        }
        <div class="table-responsive">
            <table class="court-table">
                <thead>
                <tr>
                    <th class="time-col">Zeit</th>
                    <th>Platz 1</th>
                    <th>Platz 2</th>
                    <th>Platz 3</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var timeSlot in Model.TimeSlots)
                {
                    <tr>
                        <td class="time-col">
                            <div class="time-label">@timeSlot.Time.ToString("HH:mm")</div>
                            <div class="weather-info" data-time="@timeSlot.Time.ToString("yyyy-MM-dd'T'HH:00")"></div>
                        </td>

                        @for (int court = 1; court <= 3; court++)
                        {
                            if (Model.BlockInfo.TryGetValue((court, timeSlot.Time), out var block))
                            {
                                if (block.IsStart)
                                {
                                    var reservation = block.Reservation;
                                    if (Model.CurrentPlayer == null)
                                    {
                                        <td class="slot-reserved" rowspan="@block.RowSpan">
                                            🔒 Reserviert
                                        </td>
                                    }
                                    else
                                    {
                                        bool isMyReservation = Model.CurrentPlayer.Id == reservation.Player?.Id;
                                        bool isEvent = !string.IsNullOrWhiteSpace(reservation.EventName);
                                        bool isEditable = isMyReservation || User.IsInRole("Admin");
                                        string tdClass = isMyReservation ? "slot-my-reservation" : (isEvent ? "slot-event" : "slot-reserved");
                                        var blockEndTimeStr = reservation.StartTime.AddMinutes(30 * block.RowSpan).ToString("HH:mm");

                                        <td class="@tdClass @(isEditable ? "clickable-res" : "")"
                                            rowspan="@block.RowSpan"
                                            @if (isEditable)
                                            {
                                            <text>onclick="openEditModal(@reservation.Id, @court, '@reservation.StartTime.ToString("HH:mm")', '@blockEndTimeStr', @(reservation.PartnerId ?? 0), '@(reservation.EventName?.Replace("'", "\\'") ?? "")')"
                                            </text>
                                            }
                                            title="@(isEditable ? "Klicken zum Bearbeiten" : reservation.DisplayName)">
                                            <div class="reserved-name">
                                                @reservation.DisplayName
                                            </div>
                                            <div class="reserved-time">
                                                @reservation.StartTime.ToString("HH:mm") - @blockEndTimeStr
                                            </div>
                                            @if (isEditable)
                                            {
                                                <div class="edit-indicator">✏️
                                                    Bearbeiten
                                                </div>
                                            }
                                        </td>
                                    }
                                }
                            }
                            else
                            {
                                <td class="slot-available">
                                    @if (Model.CurrentPlayer != null)
                                    {
                                        if (timeSlot.Time >= CityTime.GetViennaTimeZone())
                                        {
                                            var defaultEndTime = timeSlot.Time.AddHours(2) > timeSlot.Time.Date.AddHours(22)
                                                ? timeSlot.Time.Date.AddHours(22).ToString("HH:mm")
                                                : timeSlot.Time.AddHours(2).ToString("HH:mm");

                                            <button type="button" class="btn-reserve" title="Jetzt reservieren"
                                                    onclick="openBookingModal(@court, '@timeSlot.Time.ToString("HH:mm")', '@defaultEndTime')">
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted slot-muted-dash">-</span>
                                        }
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

    </section>
</main>

<!-- RESERVATION MODAL (CREATE / EDIT) -->
<div id="reservationModal" class="modal-overlay hidden-element">
    <div class="modal-card">
        <div class="modal-header">
            <h3 id="modalTitle">Platz reservieren</h3>
            <button type="button" class="modal-close" onclick="closeReservationModal()">&times;</button>
        </div>

        <form id="modalForm" method="post">
            <input type="hidden" name="currentDateStr" value="@Model.CurrentDate.ToString("yyyy-MM-dd")"/>
            <input type="hidden" id="modalReservationId" name="reservationId" value="0"/>

            <div class="modal-body">
                <div class="modal-field">
                    <label class="form-label">Platz</label>
                    <select name="courtNumber" id="modalCourtNumber" class="form-input" required>
                        <option value="1">Platz 1</option>
                        <option value="2">Platz 2</option>
                        <option value="3">Platz 3</option>
                    </select>
                </div>

                <div class="modal-row">
                    <div class="modal-field">
                        <label class="form-label">Von (Uhrzeit)</label>
                        <input type="time" name="startTimeStr" id="modalStartTime" required class="form-input"
                               onchange="onStartTimeChanged()"/>
                    </div>

                    <div class="modal-field">
                        <label class="form-label">Bis (Uhrzeit)</label>
                        <input type="time" name="endTimeStr" id="modalEndTime" required class="form-input"/>
                    </div>
                </div>

                <div class="modal-field">
                    <label class="form-label">Mit wem spielst du? (optional)</label>
                    <select name="partnerId" id="modalPartnerId" class="form-input">
                        <option value="">-- Allein (Kein Partner) --</option>
                        @foreach (var player in Model.AllPlayers.Where(p => p.Id != Model.CurrentPlayer?.Id))
                        {
                            <option value="@player.Id">@player.Firstname @player.Lastname</option>
                        }
                    </select>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="modal-field">
                        <label class="form-label">Event Name (optional)</label>
                        <input type="text" name="eventName" id="modalEventName" placeholder="z.B. Meisterschaft"
                               class="form-input"/>
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button" id="btnModalDelete" class="btn-modal-delete hidden-element"
                        onclick="deleteCurrentReservation()">Löschen
                </button>
                <div class="modal-footer-right">
                    <button type="button" class="btn-modal-cancel" onclick="closeReservationModal()">Abbrechen</button>
                    <button type="submit" id="btnModalSubmit" class="btn-action btn-accent btn-modal-submit-custom">Reservieren
                    </button>
                </div>
            </div>
        </form>

        <!-- Hidden delete form for post handler -->
        <form id="deleteForm" method="post" asp-page-handler="DeleteReservation" class="hidden-element">
            <input type="hidden" id="deleteReservationId" name="ReservationId" value="0"/>
        </form>
    </div>
</div>

</body>
</html>