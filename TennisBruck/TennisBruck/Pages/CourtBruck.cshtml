@page
@model TennisBruck.Pages.CourtBruck

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Platzreservierung</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/courtBruck.css" asp-append-version="true">
    <script src="~/js/courtBruckWeather.js" asp-append-version="true"></script>
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <button onclick="window.location.href = '/Index'" class="btn-back-header">
            ← Übersicht
        </button>
    </div>

    <h1 class="app-title">Platz reservieren</h1>
    @* <p class="header-subtitle">Wähle deinen Wunschtermin für die Anlage Bruck</p> *@

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-box @(Model.IsError ? "alert-error" : "alert-success")">
            <span class="alert-icon">@(Model.IsError ? "⚠️" : "✅")</span>
            <span>@Model.Message</span>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
</header>

<main class="main-container">
    <section class="modern-card">
        <div class="date-nav-wrapper">
            <a href="?date=@Model.CurrentDate.AddDays(-1).ToString("yyyy-MM-dd")" class="btn-date">◀</a>

            <form method="get" class="date-picker-form">
                <input type="date" name="date" value="@Model.CurrentDate.ToString("yyyy-MM-dd")"
                       class="date-picker-input" onchange="this.form.submit()">
            </form>

            <a href="?date=@Model.CurrentDate.AddDays(1).ToString("yyyy-MM-dd")" class="btn-date">▶</a>
        </div>


        @if (Model.CurrentPlayer != null)
        {
            <div class="admin-panel">
                <h3 class="admin-panel-title">Block-Reservierung eintragen</h3>

                <form method="post" asp-page-handler="CreateEvent" class="admin-form">

                    <input type="hidden" name="currentDateStr" value="@Model.CurrentDate.ToString("yyyy-MM-dd")"/>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="form-group-flex">
                            <label class="form-label">Event Name</label>
                            <input type="text" name="eventName" placeholder="z.B. Meisterschaft" class="form-input">
                        </div>
                    }
                    <div>
                        <label class="form-label">Platz</label>
                        <select name="courtNumber" class="form-input">
                            <option value="1">Platz 1</option>
                            <option value="2">Platz 2</option>
                            <option value="3">Platz 3</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label" min="@DateTime.Today.ToString("yyyy-MM-dd")">Von (Uhrzeit)</label>
                        <input type="time" name="startTimeStr" required class="form-input">
                    </div>

                    <div>
                        <label class="form-label">Bis (Uhrzeit)</label>
                        <input type="time" name="endTimeStr" required class="form-input">
                    </div>

                    <button type="submit" class="btn-action btn-accent" style="padding: 9px 20px;">Reservieren</button>
                </form>
            </div>
        }
        <div class="table-responsive">
            <table class="court-table">
                <thead>
                <tr>
                    <th class="time-col">Zeit</th>
                    <th>Platz 1</th>
                    <th>Platz 2</th>
                    <th>Platz 3</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var timeSlot in Model.TimeSlots)
                {
                    <tr>
                        <td class="time-col">
                            <div style="font-weight: 600;">@timeSlot.Time.ToString("HH:mm")</div>
                            <div class="weather-info" data-time="@timeSlot.Time.ToString("yyyy-MM-dd'T'HH:00")"
                                 style="font-size: 0.85rem; margin-top: 4px; font-weight: normal; opacity: 0.8; min-height: 18px;"></div>
                        </td>

                        @for (int court = 1; court <= 3; court++)
                        {
                            if (Model.BlockInfo.TryGetValue((court, timeSlot.Time), out var block))
                            {
                                if (block.IsStart)
                                {
                                    var reservation = block.Reservation;
                                    if (Model.CurrentPlayer == null)
                                    {
                                        <td class="slot-reserved" rowspan="@block.RowSpan">
                                            🔒 Reserviert
                                        </td>
                                    }
                                    else
                                    {
                                        bool isMyReservation = Model.CurrentPlayer.Id == reservation.Player?.Id;
                                        bool isEvent = !string.IsNullOrWhiteSpace(reservation.EventName);
                                        string tdClass = isMyReservation ? "slot-my-reservation" : (isEvent ? "slot-event" : "slot-reserved");

                                        <td class="@tdClass" rowspan="@block.RowSpan">
                                            <div class="reserved-name" title="@reservation.DisplayName">
                                                @reservation.DisplayName
                                            </div>
                                            @if (block.RowSpan > 1)
                                            {
                                                <div class="reserved-time"
                                                     style="font-size: 0.65rem; opacity: 0.8; margin-top: 2px; font-weight: 500;">
                                                    @reservation.StartTime.ToString("HH:mm") - @reservation.StartTime.AddMinutes(30 * block.RowSpan).ToString("HH:mm")
                                                </div>
                                            }
                                            @if (isMyReservation || User.IsInRole("Admin"))
                                            {
                                                <form method="post" asp-page-handler="DeleteReservation"
                                                      style="margin: 0;">
                                                    <input type="hidden" name="ReservationId" value="@reservation.Id"/>
                                                    <button type="submit" class="btn-delete-res"
                                                            title="Gesamte Reservierung löschen">Löschen
                                                    </button>
                                                </form>
                                            }
                                        </td>
                                    }
                                }
                                // Skip rendering td entirely for block.IsStart == false (it is spanned from the start cell)
                            }
                            else
                            {
                                <td class="slot-available">
                                    @if (Model.CurrentPlayer != null)
                                    {
                                        if (timeSlot.Time >= CityTime.GetViennaTimeZone())
                                        {
                                            <form method="post" asp-page-handler="CreateReservation" class="cell-form">
                                                <input type="hidden" name="courtNumber" value="@court"/>
                                                <input type="hidden" name="StartTime" value="@timeSlot.Time"/>
                                                <button type="submit" class="btn-reserve" title="Jetzt reservieren">+
                                                </button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="opacity: 0.5;">-</span>
                                        }
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

    </section>
</main>

<script>
    const currentViewDate = '@Model.CurrentDate.ToString("yyyy-MM-dd")';
</script>
</body>
</html>