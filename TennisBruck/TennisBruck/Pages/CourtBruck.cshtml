@page
@model TennisBruck.Pages.CourtBruck

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Platzreservierung</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/courtBruck.css" asp-append-version="true">
    <script src="~/js/courtBruckWeather.js" asp-append-version="true"></script>
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <button onclick="window.location.href = '/Index'" class="btn-back-header">
            ← Übersicht
        </button>
    </div>

    <h1 class="app-title">Platz reservieren</h1>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-box @(Model.IsError ? "alert-error" : "alert-success")">
            <span class="alert-icon">@(Model.IsError ? "⚠️" : "✅")</span>
            <span>@Model.Message</span>
        </div>
    }

    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
</header>

<main class="main-container @(!string.IsNullOrEmpty(Model.Message) ? "has-message" : "")">
    <section class="modern-card">
        <div class="date-nav-wrapper">
            <a href="?date=@Model.CurrentDate.AddDays(-1).ToString("yyyy-MM-dd")" class="btn-date">◀</a>

            <form method="get" class="date-picker-form">
                <input type="date" name="date" value="@Model.CurrentDate.ToString("yyyy-MM-dd")"
                       class="date-picker-input" onchange="this.form.submit()">
            </form>

            <a href="?date=@Model.CurrentDate.AddDays(1).ToString("yyyy-MM-dd")" class="btn-date">▶</a>
        </div>

        @if (Model.CurrentPlayer != null)
        {
            <div class="admin-panel">
                <h3 class="admin-panel-title">Block-Reservierung eintragen</h3>

                <form method="post" asp-page-handler="CreateEvent" class="admin-form">
                    <input type="hidden" name="currentDateStr" value="@Model.CurrentDate.ToString("yyyy-MM-dd")"/>
                    @if (User.IsInRole("Admin"))
                    {
                        <div class="form-group-flex">
                            <label class="form-label">Event Name</label>
                            <input type="text" name="eventName" placeholder="z.B. Meisterschaft" class="form-input">
                        </div>
                    }
                    <div>
                        <label class="form-label">Platz</label>
                        <select name="courtNumber" class="form-input">
                            <option value="1">Platz 1</option>
                            <option value="2">Platz 2</option>
                            <option value="3">Platz 3</option>
                        </select>
                    </div>

                    <div>
                        <label class="form-label">Von (Uhrzeit)</label>
                        <input type="time" name="startTimeStr" required class="form-input">
                    </div>

                    <div>
                        <label class="form-label">Bis (Uhrzeit)</label>
                        <input type="time" name="endTimeStr" required class="form-input">
                    </div>

                    <button type="submit" class="btn-action btn-accent" style="padding: 9px 20px;">Reservieren</button>
                </form>
            </div>
        }
        <div class="table-responsive">
            <table class="court-table">
                <thead>
                <tr>
                    <th class="time-col">Zeit</th>
                    <th>Platz 1</th>
                    <th>Platz 2</th>
                    <th>Platz 3</th>
                </tr>
                </thead>
                <tbody>
                @foreach (var timeSlot in Model.TimeSlots)
                {
                    <tr>
                        <td class="time-col">
                            <div style="font-weight: 600;">@timeSlot.Time.ToString("HH:mm")</div>
                            <div class="weather-info" data-time="@timeSlot.Time.ToString("yyyy-MM-dd'T'HH:00")"
                                 style="font-size: 0.85rem; margin-top: 4px; font-weight: normal; opacity: 0.8; min-height: 18px;"></div>
                        </td>

                        @for (int court = 1; court <= 3; court++)
                        {
                            if (Model.BlockInfo.TryGetValue((court, timeSlot.Time), out var block))
                            {
                                if (block.IsStart)
                                {
                                    var reservation = block.Reservation;
                                    if (Model.CurrentPlayer == null)
                                    {
                                        <td class="slot-reserved" rowspan="@block.RowSpan">
                                            🔒 Reserviert
                                        </td>
                                    }
                                    else
                                    {
                                        bool isMyReservation = Model.CurrentPlayer.Id == reservation.Player?.Id;
                                        bool isEvent = !string.IsNullOrWhiteSpace(reservation.EventName);
                                        bool isEditable = isMyReservation || User.IsInRole("Admin");
                                        string tdClass = isMyReservation ? "slot-my-reservation" : (isEvent ? "slot-event" : "slot-reserved");
                                        var blockEndTimeStr = reservation.StartTime.AddMinutes(30 * block.RowSpan).ToString("HH:mm");

                                        <td class="@tdClass @(isEditable ? "clickable-res" : "")" rowspan="@block.RowSpan"
                                            @if (isEditable)
                                            {
                                                <text>onclick="openEditModal(@reservation.Id, @court, '@reservation.StartTime.ToString("HH:mm")', '@blockEndTimeStr', @(reservation.PartnerId ?? 0), '@(reservation.EventName?.Replace("'", "\\'") ?? "")')"</text>
                                            }
                                            title="@(isEditable ? "Klicken zum Bearbeiten" : reservation.DisplayName)">
                                            <div class="reserved-name">
                                                @reservation.DisplayName
                                            </div>
                                            <div class="reserved-time" style="font-size: 0.65rem; opacity: 0.8; margin-top: 2px; font-weight: 500;">
                                                @reservation.StartTime.ToString("HH:mm") - @blockEndTimeStr
                                            </div>
                                            @if (isEditable)
                                            {
                                                <div style="font-size: 0.6rem; opacity: 0.75; margin-top: 3px;">✏️ Bearbeiten</div>
                                            }
                                        </td>
                                    }
                                }
                            }
                            else
                            {
                                <td class="slot-available">
                                    @if (Model.CurrentPlayer != null)
                                    {
                                        if (timeSlot.Time >= CityTime.GetViennaTimeZone())
                                        {
                                            var defaultEndTime = timeSlot.Time.AddHours(2) > timeSlot.Time.Date.AddHours(22)
                                                ? timeSlot.Time.Date.AddHours(22).ToString("HH:mm")
                                                : timeSlot.Time.AddHours(2).ToString("HH:mm");

                                            <button type="button" class="btn-reserve" title="Jetzt reservieren"
                                                    onclick="openBookingModal(@court, '@timeSlot.Time.ToString("HH:mm")', '@defaultEndTime')">
                                            </button>
                                        }
                                        else
                                        {
                                            <span class="text-muted" style="opacity: 0.5;">-</span>
                                        }
                                    }
                                </td>
                            }
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>

    </section>
</main>

<!-- RESERVATION MODAL (CREATE / EDIT) -->
<div id="reservationModal" class="modal-overlay" style="display: none;">
    <div class="modal-card">
        <div class="modal-header">
            <h3 id="modalTitle">Platz reservieren</h3>
            <button type="button" class="modal-close" onclick="closeReservationModal()">&times;</button>
        </div>

        <form id="modalForm" method="post">
            <input type="hidden" name="currentDateStr" value="@Model.CurrentDate.ToString("yyyy-MM-dd")" />
            <input type="hidden" id="modalReservationId" name="reservationId" value="0" />

            <div class="modal-body">
                <div class="modal-field">
                    <label class="form-label">Platz</label>
                    <select name="courtNumber" id="modalCourtNumber" class="form-input" required>
                        <option value="1">Platz 1</option>
                        <option value="2">Platz 2</option>
                        <option value="3">Platz 3</option>
                    </select>
                </div>

                <div class="modal-row">
                    <div class="modal-field">
                        <label class="form-label">Von (Uhrzeit)</label>
                        <input type="time" name="startTimeStr" id="modalStartTime" required class="form-input" onchange="onStartTimeChanged()" />
                    </div>

                    <div class="modal-field">
                        <label class="form-label">Bis (Uhrzeit)</label>
                        <input type="time" name="endTimeStr" id="modalEndTime" required class="form-input" />
                    </div>
                </div>

                <div class="modal-field">
                    <label class="form-label">Mit wem spielst du? (optional)</label>
                    <select name="partnerId" id="modalPartnerId" class="form-input">
                        <option value="">-- Allein (Kein Partner) --</option>
                        @foreach (var player in Model.AllPlayers.Where(p => p.Id != Model.CurrentPlayer?.Id))
                        {
                            <option value="@player.Id">@player.Firstname @player.Lastname</option>
                        }
                    </select>
                </div>

                @if (User.IsInRole("Admin"))
                {
                    <div class="modal-field">
                        <label class="form-label">Event Name (optional)</label>
                        <input type="text" name="eventName" id="modalEventName" placeholder="z.B. Meisterschaft" class="form-input" />
                    </div>
                }
            </div>

            <div class="modal-footer">
                <button type="button" id="btnModalDelete" class="btn-modal-delete" style="display: none;" onclick="deleteCurrentReservation()">Löschen</button>
                <div class="modal-footer-right">
                    <button type="button" class="btn-modal-cancel" onclick="closeReservationModal()">Abbrechen</button>
                    <button type="submit" id="btnModalSubmit" class="btn-action btn-accent" style="padding: 8px 18px; margin: 0;">Reservieren</button>
                </div>
            </div>
        </form>

        <!-- Hidden delete form for post handler -->
        <form id="deleteForm" method="post" asp-page-handler="DeleteReservation" style="display: none;">
            <input type="hidden" id="deleteReservationId" name="ReservationId" value="0" />
        </form>
    </div>
</div>

<script>
    const currentViewDate = '@Model.CurrentDate.ToString("yyyy-MM-dd")';

    function openBookingModal(court, startTime, endTime) {
        document.getElementById('modalTitle').innerText = 'Platz ' + court + ' reservieren';
        document.getElementById('modalForm').action = '?handler=CreateReservation';
        document.getElementById('modalReservationId').value = '0';
        document.getElementById('modalCourtNumber').value = court;
        document.getElementById('modalStartTime').value = startTime;
        document.getElementById('modalEndTime').value = endTime;
        document.getElementById('modalPartnerId').value = '';
        const eventNameInput = document.getElementById('modalEventName');
        if (eventNameInput) eventNameInput.value = '';

        document.getElementById('btnModalDelete').style.display = 'none';
        document.getElementById('btnModalSubmit').innerText = 'Reservieren';

        document.getElementById('reservationModal').style.display = 'flex';
    }

    function openEditModal(reservationId, court, startTime, endTime, partnerId, eventName) {
        document.getElementById('modalTitle').innerText = 'Reservierung bearbeiten';
        document.getElementById('modalForm').action = '?handler=UpdateReservation';
        document.getElementById('modalReservationId').value = reservationId;
        document.getElementById('modalCourtNumber').value = court;
        document.getElementById('modalStartTime').value = startTime;
        document.getElementById('modalEndTime').value = endTime;
        document.getElementById('modalPartnerId').value = partnerId > 0 ? partnerId : '';
        const eventNameInput = document.getElementById('modalEventName');
        if (eventNameInput) eventNameInput.value = eventName || '';

        document.getElementById('btnModalDelete').style.display = 'inline-block';
        document.getElementById('deleteReservationId').value = reservationId;
        document.getElementById('btnModalSubmit').innerText = 'Speichern';

        document.getElementById('reservationModal').style.display = 'flex';
    }

    function closeReservationModal() {
        document.getElementById('reservationModal').style.display = 'none';
    }

    function onStartTimeChanged() {
        const startTimeVal = document.getElementById('modalStartTime').value;
        if (!startTimeVal) return;

        const parts = startTimeVal.split(':').map(Number);
        let endHours = parts[0] + 2;
        if (endHours > 22) endHours = 22;

        const pad = n => n.toString().padStart(2, '0');
        document.getElementById('modalEndTime').value = `${pad(endHours)}:${pad(parts[1])}`;
    }

    function deleteCurrentReservation() {
        if (confirm('Möchtest du diese Reservierung wirklich stornieren/löschen?')) {
            document.getElementById('deleteForm').submit();
        }
    }

    window.addEventListener('click', function(event) {
        const modal = document.getElementById('reservationModal');
        if (event.target === modal) {
            closeReservationModal();
        }
    });
</script>
</body>
</html>