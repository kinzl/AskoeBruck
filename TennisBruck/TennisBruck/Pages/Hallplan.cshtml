@page
@model TennisBruck.Pages.Hallplan

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hallenplan | TennisBruck</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/mobile-drag-drop@2.3.0-rc.2/default.css">
    <script src="https://cdn.jsdelivr.net/npm/mobile-drag-drop@2.3.0-rc.2/index.min.js"></script>
    <link rel="stylesheet" href="~/css/hallplan.css" asp-append-version="true">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <script src="~/js/hallplan.js" asp-append-version="true" defer></script>
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <form method="post" asp-page-handler="Back" style="margin: 0;">
            <button type="submit" class="btn-back-header">← Übersicht</button>
        </form>
    </div>
    <h1 class="app-title">🎾 @(Model.SelectedHallPlanEntity?.Name ?? "Hallenplan")</h1>
    <p style="color: var(--text-muted); margin-top: 10px;">Verschiebe Spieler einfach per Drag & Drop</p>
</header>

<main class="main-container" id="main-content" data-me-id="@Model.LoggedInPlayer?.Id">

    <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 24px;">

        <section class="modern-card" style="margin: 0;">
            <label
                style="font-size: 0.85rem; font-weight: bold; color: var(--text-muted); display: block; margin-bottom: 8px;">Gewählter
                Platz / Bewerb</label>
            <form method="post" asp-page-handler="SelectHallPlan" style="margin: 0;">
                <select asp-for="HallPlanId" class="custom-select" onchange="this.form.submit()">
                    <option value="">Bitte auswählen...</option>
                    @foreach (var item in Model.HallPlanEntity)
                    {
                        <option value="@item.Id">@item.Name</option>
                    }
                </select>
            </form>
        </section>

        @if (Model.SelectedHallPlanEntity != null)
        {
            <section class="modern-card"
                     style="margin: 0; display: flex; justify-content: space-between; align-items: center;">
                <div>
                    <span
                        style="font-size: 0.85rem; font-weight: bold; color: var(--text-muted); display: block; margin-bottom: 5px;">Mein Status</span>
                    <h3 style="margin: 0; font-size: 1.2rem; color: @(Model.IsLoggedInPlayerPlaying ? "var(--nav-bg)" : "var(--text-muted)");">
                        @(Model.IsLoggedInPlayerPlaying ? "✅ Eingeteilt" : "⏸️ Pausiert")
                    </h3>
                </div>
                <form method="post" asp-page-handler="ChangePlayingState" id="statusForm" style="margin: 0;">
                    <label class="switch">
                        <input type="checkbox" onchange="this.form.submit()"
                               @(Model.IsLoggedInPlayerPlaying ? "checked" : "")>
                        <span class="slider round"></span>
                    </label>
                </form>
            </section>
        }

    </div>

    @if (Model.SelectedHallPlanEntity != null)
    {
        <section class="modern-card">
            <h2 class="section-title">📅 Spielplan Übersicht</h2>

            <div class="table-responsive">
                <table class="modern-table">
                    <thead>
                    <tr>
                        <th>Datum</th>
                        <th>Position 1</th>
                        <th>Position 2</th>
                        <th>Position 3</th>
                        <th>Position 4</th>
                    </tr>
                    </thead>
                    <tbody>
                    @foreach (var court in Model.HallPlanDays)
                    {
                        <tr>
                            <td class="date-col">
                                <span class="date-day">@court.PlayDate.ToString("dd")</span>
                                <span class="date-month">@court.PlayDate.ToString("MMM")</span>
                            </td>
                            @foreach (var playerEntry in court.Players)
                            {
                                bool isMe = Model.LoggedInPlayer != null && playerEntry.Player.Id == Model.LoggedInPlayer.Id;
                                string highlightClass = isMe ? "player-slot-me" : "";

                                <td class="drop-zone" data-day-id="@court.Id">
                                    <div class="player-slot draggable-player @highlightClass"
                                         draggable="true"
                                         data-player-id="@playerEntry.Player.Id"
                                         data-court-id="@court.Id">
                                        <div class="avatar-mini">@playerEntry.Player.ToString().Substring(0, 1)</div>
                                        <span class="player-name">@playerEntry.Player</span>
                                    </div>
                                </td>
                            }
                        </tr>
                    }
                    </tbody>
                </table>
            </div>
        </section>

        <section class="modern-card" style="border-left: 4px solid var(--accent-color);">
            <h2 class="section-title" style="margin-bottom: 5px;">🔄 Ersatzbank (Kein Abo)</h2>
            <p style="font-size: 0.85rem; color: var(--text-muted); margin-bottom: 15px;">Ziehe einen Spieler von hier
                auf den Spielplan, um jemanden zu ersetzen.</p>

            <div class="substitute-bench">
                @if (Model.NotRegisteredPlayers != null && Model.NotRegisteredPlayers.Any())
                {
                    foreach (var sub in Model.NotRegisteredPlayers)
                    {
                        <div class="player-slot draggable-substitute"
                             draggable="true"
                             data-player-id="@sub.Id">
                            <div class="avatar-mini"
                                 style="background: #cbd5e1; color: #475569;">@sub.ToString().Substring(0, 1)</div>
                            <span class="player-name">@sub</span>
                        </div>
                    }
                }
                else
                {
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin: 0;">Aktuell keine Ersatzspieler
                        verfügbar.</p>
                }
            </div>
        </section>
    }

    @if (User.IsInRole("Admin"))
    {
        <section class="modern-card" style="margin-top: 20px;">
            <h2 class="section-title">🛠️ Administrator Werkzeuge</h2>

            <div class="admin-grid">
                @if (Model.SelectedHallPlanEntity != null)
                {
                    <div class="admin-box">
                        <h4>Zeitraum generieren</h4>
                        <form method="post" class="admin-form"
                              style="display: flex; flex-direction: column; gap: 10px;">
                            <input type="hidden" name="HallPlanId" value="@Model.HallPlanId"/>

                            <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 10px;">
                                <input type="date" name="startDate" value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       class="input-field"
                                       style="min-width: 0; padding-left: 10px; padding-right: 10px;" required/>
                                <input type="date" name="endDate"
                                       value="@DateTime.Today.AddMonths(6).ToString("yyyy-MM-dd")" class="input-field"
                                       style="min-width: 0; padding-left: 10px; padding-right: 10px;" required/>
                            </div>

                            <select name="frequencyDays" class="custom-select" required>
                                <option value="7" selected>Wöchentlich (alle 7 Tage)</option>
                                <option value="14">14-tägig (alle 14 Tage)</option>
                                <option value="21">Alle 3 Wochen (21 Tage)</option>
                                <option value="28">Alle 4 Wochen (28 Tage)</option>
                                <option value="1">Täglich</option>
                            </select>

                            <button asp-page-handler="GeneratePlan" class="btn-action">Plan erstellen</button>
                        </form>
                    </div>

                    <div class="admin-box">
                        <h4>Spieler fest ins Abo hinzufügen</h4>
                        <form method="post" asp-page-handler="AddPlayerToHallplan"
                              style="display: flex; flex-direction: column; gap: 10px;">
                            <input type="hidden" name="HallPlanId" value="@Model.HallPlanId"/>
                            <select name="playerId" class="custom-select" required>
                                <option value="">Spieler wählen...</option>
                                @if (Model.NotRegisteredPlayers != null)
                                {
                                    @foreach (var player in Model.NotRegisteredPlayers)
                                    {
                                        <option value="@player.Id">@player</option>
                                    }
                                }
                            </select>
                            <button class="btn-action">Hinzufügen</button>
                        </form>
                    </div>
                }

                <div class="admin-box" style="grid-column: 1 / -1;">
                    <h4>Neuen Bewerb/Platz anlegen</h4>
                    <form method="post" asp-page-handler="CreateCompetition" style="display: flex; gap: 10px;">
                        <input type="text" name="competitionName" placeholder="Name (z.B. Halle West)"
                               class="input-field" required/>
                        <button class="btn-action" style="width: auto;">Erstellen
                        </button>
                    </form>
                    <form method="post" asp-page-handler="DeleteSelectedHallplan" style="display: flex; gap: 10px;">
                        @if (Model.SelectedHallPlanEntity != null)
                        {
                            <button class="btn-action"
                                    style="width: auto; background-color: red">Diesen Hallenplan
                                löschen
                            </button>
                        }
                    </form>
                </div>
            </div>
        </section>
    }
</main>

</body>
</html>