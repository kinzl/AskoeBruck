@page
@model TennisBruck.Pages.Hallplan

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Hallenplan</title>

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/mobile-drag-drop@2.3.0-rc.2/default.css">
    <script src="https://cdn.jsdelivr.net/npm/mobile-drag-drop@2.3.0-rc.2/index.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/mobile-drag-drop@2.3.0-rc.2/scroll-behaviour.min.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/hallplan.css" asp-append-version="true">
    <script src="~/js/hallplan.js" asp-append-version="true" defer></script>
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <form method="post" asp-page-handler="Back" class="form-no-margin">
            <button type="submit" class="btn-back-header">← Übersicht</button>
        </form>
    </div>
    <h1 class="app-title">@(Model.SelectedHallPlanEntity?.Name ?? "Hallenplan")</h1>
    <p class="header-subtitle">Verschiebe Spieler einfach per Drag & Drop</p>

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-box @(Model.IsError ? "alert-error" : "alert-success")">
            <span class="alert-icon">@(Model.IsError ? "⚠️" : "✅")</span>
            <span>@Model.Message</span>
        </div>
    }
</header>

<main class="main-container" id="main-content" data-me-id="@Model.LoggedInPlayer.Id">

    <div class="top-dashboard-grid">
        <section class="modern-card card-no-margin hallplan-header-card">
            <div class="hallplan-select-wrapper">
                <label class="input-label">Gewählter Platz / Bewerb</label>
                <form method="post" asp-page-handler="SelectHallPlan" class="form-no-margin">
                    <select asp-for="HallPlanId" class="custom-select" onchange="this.form.submit()">
                        <option value="">Bitte auswählen...</option>
                        @foreach (var item in Model.HallPlanEntity)
                        {
                            <option value="@item.Id">@item.Name</option>
                        }
                    </select>
                </form>
            </div>

            @if (Model.SelectedHallPlanEntity != null)
            {
                <div class="hallplan-status-wrapper">
                    <div class="status-text-info">
                        <span class="status-label">Mein Abo-Status</span>
                        <h3 class="status-heading @(Model.IsLoggedInPlayerPlaying ? "status-active" : "status-paused")">
                            @(Model.IsLoggedInPlayerPlaying ? "✅ Eingeteilt (Abo aktiv)" : "⏸️ Pausiert / Kein Abo")
                        </h3>
                    </div>
                    <form method="post" asp-page-handler="ChangePlayingState" id="statusForm" class="form-no-margin">
                        <label class="switch">
                            <input type="checkbox" onchange="this.form.submit()"
                                   @(Model.IsLoggedInPlayerPlaying ? "checked" : "")>
                            <span class="slider round"></span>
                        </label>
                    </form>
                </div>
            }
        </section>
    </div>

    @if (Model.SelectedHallPlanEntity != null)
    {
        <section class="modern-card">
            <h2 class="section-title">📅 Spielplan Übersicht</h2>

            <div class="mobile-schedule-compact">
                @foreach (var court in Model.HallPlanDays)
                {
                    <div class="match-day-row">

                        <div class="date-sidebar">
                            <span class="day-num">@court.PlayDate.ToString("dd")</span>
                            <span class="month-text">@court.PlayDate.ToString("MMM")</span>
                        </div>

                        <div class="players-2x2-grid">
                            @foreach (var playerEntry in court.Players)
                            {
                                bool isMe = Model.LoggedInPlayer != null && playerEntry.Player.Id == Model.LoggedInPlayer.Id;
                                string highlightClass = isMe ? "slot-me" : "";

                                <div class="drop-zone compact-drop" data-day-id="@court.Id">
                                    <div class="player-slot draggable-player compact-player @highlightClass"
                                         draggable="true"
                                         data-player-id="@playerEntry.Player.Id"
                                         data-court-id="@court.Id">
                                        <div class="avatar-micro">@(!string.IsNullOrEmpty(playerEntry.Player.Firstname) ? playerEntry.Player.Firstname.Substring(0, 1) : "")</div>
                                        <span class="player-name-micro desktop-name">@playerEntry.Player.ToString()</span>
                                        <span class="player-name-micro mobile-name">@playerEntry.Player.Firstname @(string.IsNullOrEmpty(playerEntry.Player.Lastname) ? "" : playerEntry.Player.Lastname[0].ToString() + ".")</span>
                                    </div>

                                </div>
                            }
                        </div>

                    </div>
                }
            </div>
        </section>

        <section class="modern-card card-highlight-left">
            <h2 class="section-title compact">🔄 Ersatzbank (Abo-Besitzer)</h2>
            <p class="section-description">Spieler mit einem aktiven Abo, die derzeit keinem Spieltag zugeteilt sind. Ziehe sie auf den Spielplan, um jemanden zu ersetzen.</p>

            <div class="substitute-bench">
                @if (Model.RegisteredPlayers.Any())
                {
                    foreach (var sub in Model.RegisteredPlayers)
                    {
                        <div class="player-slot draggable-substitute"
                             draggable="true"
                             data-player-id="@sub.Id">
                            <div class="avatar-mini avatar-substitute">@sub.ToString().Substring(0, 1)</div>
                            <span class="player-name">@sub</span>
                        </div>
                    }
                }
                else
                {
                    <p class="empty-state-text">Aktuell gibt es keine Spieler im Abo.</p>
                }
            </div>
        </section>
    }

    @if (User.IsInRole("Admin"))
    {
        <section class="modern-card admin-section">
            <h2 class="section-title">🛠️ Administrator Werkzeuge</h2>

            <div class="admin-grid">
                @if (Model.SelectedHallPlanEntity != null)
                {
                    <div class="admin-box">
                        <h4>Zeitraum generieren</h4>
                        <form method="post" class="form-col">
                            <input type="hidden" name="HallPlanId" value="@Model.HallPlanId"/>

                            <div class="form-grid-2">
                                <input type="date" name="startDate" value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                       class="input-field input-date" required/>
                                <input type="date" name="endDate"
                                       value="@DateTime.Today.AddMonths(6).ToString("yyyy-MM-dd")"
                                       class="input-field input-date" required/>
                            </div>

                            <select name="frequencyDays" class="custom-select" required>
                                <option value="7" selected>Wöchentlich (alle 7 Tage)</option>
                                <option value="14">14-tägig (alle 14 Tage)</option>
                                <option value="21">Alle 3 Wochen (21 Tage)</option>
                                <option value="28">Alle 4 Wochen (28 Tage)</option>
                                <option value="1">Täglich</option>
                            </select>

                            <button asp-page-handler="GeneratePlan" class="btn-action">Plan erstellen</button>
                        </form>
                    </div>

                    <div class="admin-box">
                        <h4>Spieler fest ins Abo hinzufügen</h4>
                        <form method="post" asp-page-handler="AddPlayerToHallplan" class="form-col">
                            <input type="hidden" name="HallPlanId" value="@Model.HallPlanId"/>
                            <select name="playerId" class="custom-select" required>
                                <option value="">Spieler wählen...</option>
                                @if (Model.NotRegisteredPlayers != null)
                                {
                                    @foreach (var player in Model.NotRegisteredPlayers)
                                    {
                                        <option value="@player.Id">@player</option>
                                    }
                                }
                            </select>
                            <button class="btn-action">Hinzufügen</button>
                        </form>
                    </div>

                    <div class="admin-box">
                        <h4>Spieler vom abo entfernen</h4>
                        <form method="post" asp-page-handler="RemovePlayerFromAbo" class="form-col">
                            <select name="PlayerIdToRemove" class="custom-select" required>
                                <option value="">Spieler wählen...</option>

                                @foreach (var player in Model.RegisteredPlayers)
                                {
                                    <option value="@player.Id">@player.ToString()</option>
                                }
                            </select>

                            <button type="submit" class="btn-action btn-danger">Entfernen</button>
                        </form>
                    </div>
                }

                <div class="admin-box admin-box-full">
                    <h4>Neuen Bewerb/Platz anlegen</h4>
                    <form method="post" asp-page-handler="CreateCompetition" class="form-row">
                        <input type="text" name="competitionName" placeholder="Name (z.B. Halle West)"
                               class="input-field" required/>
                        <button class="btn-action btn-auto">Erstellen</button>
                    </form>

                    @if (Model.SelectedHallPlanEntity != null)
                    {
                        <form method="post" asp-page-handler="DeleteSelectedHallplan" class="form-row mt-10">
                            <button type="submit" class="btn-action btn-danger btn-auto" 
                                    onclick="return confirm('Möchtest du diesen Hallenplan wirklich komplett löschen? Sämtliche Einträge gehen dabei verloren!');">
                                Diesen Hallenplan löschen
                            </button>
                        </form>
                    }
                </div>
            </div>
        </section>
    }
</main>

</body>
</html>