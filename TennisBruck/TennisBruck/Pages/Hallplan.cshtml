@page
@model TennisBruck.Pages.Hallplan

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8"/>
    <title>Hallenplatz Grieskirchen</title>

    <script src="js/courtGrieskirchen.js"></script>

    <!-- NEW CSS -->
    <link rel="stylesheet" href="css/hallplan.css">
</head>

<body class="page-bg">

<!-- Header -->
<div class="header">
    <div class="container header-inner">
        <h1 class="title">Hallenplatz Grieskirchen</h1>

        <form method="post" asp-page-handler="Back">
            <button class="btn-secondary">
                Zurück
            </button>
        </form>
    </div>
</div>

<!-- Content -->
<div class="container" style="padding-top:2rem; padding-bottom:2rem;">

    <!-- Spielstatus -->
    <div class="card">
        <div style="display:flex; justify-content:space-between; align-items:center;">
            <div>
                <h2 class="card-title">Spielstatus</h2>

                <p style="font-size:0.875rem; color:@(Model.LoggedInPlayer.IsPlayingGrieskirchen ? "#059669" : "#6b7280")">
                    @(Model.LoggedInPlayer.IsPlayingGrieskirchen
                        ? "Sie spielen aktuell in Grieskirchen mit."
                        : "Sie spielen aktuell nicht in Grieskirchen mit.")
                </p>
            </div>

            <form method="post" asp-page-handler="ChangePlayingState">
                <label>
                    <input type="checkbox"
                           name="isPlayingGrieskirchen"
                           onchange="this.form.submit()"
                           @(Model.LoggedInPlayer.IsPlayingGrieskirchen ? "checked" : "")
                           style="display:none"/>

                    <div class="toggle @(Model.LoggedInPlayer.IsPlayingGrieskirchen ? "active" : "")"></div>
                </label>
            </form>
        </div>
    </div>

    <!-- Admin Panel -->
    @if (Model.LoggedInPlayer.IsAdmin)
    {
        <div class="card">
            <h2 class="card-title" style="margin-bottom:1rem;">Admin Panel</h2>

            <form method="post" asp-page-handler="GeneratePlan" class="form-grid">

                <div>
                    <label style="font-size:0.875rem;">Start Datum</label>
                    <input type="date"
                           name="startDate"
                           value="@DateTime.Today.ToString("yyyy-MM-dd")"
                           class="input"
                           required/>
                </div>

                <div>
                    <label style="font-size:0.875rem;">End Datum</label>
                    <input type="date"
                           name="endDate"
                           value="@DateTime.Today.AddMonths(6).ToString("yyyy-MM-dd")"
                           class="input"
                           required/>
                </div>

                <div style="display:flex; align-items:end;">
                    <button class="btn-primary">
                        Generiere Plan
                    </button>
                </div>

            </form>
        </div>
    }

    <!-- Table -->
    <div class="card" style="padding:0;">
        <div style="padding:1.5rem; border-bottom:1px solid #e5e7eb;">
            <h2 class="card-title">Spielplan</h2>
        </div>

        <div class="table-wrapper">
            <table class="table">

                <thead>
                <tr>
                    <th>Datum</th>
                    <th>Spieler 1</th>
                    <th>Spieler 2</th>
                    <th>Spieler 3</th>
                    <th>Spieler 4</th>
                </tr>
                </thead>

                <tbody>
                @foreach (var court in Model.Courts)
                {
                    <tr>
                        <td style="font-weight:500;">
                            @court.MatchDay.ToString("dd.MM.yy")
                        </td>

                        @foreach (var player in court.PlayerCourtGrieskirchens)
                        {
                            <td>
                                <div id="player-@player.Player.Id"
                                     class="player-card draggable-player"
                                     draggable="true"
                                     data-player-id="@player.Player.Id"
                                     data-court-id="@court.Id">

                                    <svg class="player-icon" fill="none" stroke="currentColor" stroke-width="2"
                                         viewBox="0 0 24 24">
                                        <path stroke-linecap="round" stroke-linejoin="round"
                                              d="M5.121 17.804A13.937 13.937 0 0112 15c2.636 0 5.093.76 7.121 2.072M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                                    </svg>

                                    <span>@player.Player</span>

                                </div>
                            </td>
                        }
                    </tr>
                }
                </tbody>

            </table>
        </div>
    </div>

</div>

</body>
</html>