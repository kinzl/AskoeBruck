@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Tennis Club</title>
    <link rel="stylesheet" href="css/index.css">
</head>
<body>
<div class="container">
    <header>
        @if (Model.Player == null)
        {
            <h1>Willkommen beim ASKÖ Bruck-Peuerbach</h1>
        }
        else
        {
            <h1>Willkommen @Model.Player.ToString()</h1>
        }
    </header>

    @if (User.Identity!.IsAuthenticated)
    {
        <section id="logout" class="category">
            <form asp-area="Identity" asp-page="/Account/Logout" method="post">
                <button type="submit">Logout</button>
            </form>
        </section>
    }
    else
    {
        <section id="login" class="category">
            <h2>Login</h2>
            <form asp-area="Identity" asp-page="/Account/Login" method="get" style="display:inline">
                <button type="submit">Login</button>
            </form>
            <form asp-area="Identity" asp-page="/Account/Register" method="get" style="display:inline">
                <button type="submit">Registrieren</button>
            </form>
        </section>
    }
    @* <!--#region Login/Logout  --> *@
    @* @if (Model.Player == null) *@
    @* { *@
    @*     <form method="post" asp-page-handler="Login"> *@
    @*         <section id="login" class="category"> *@
    @*             <h2>Login</h2> *@
    @*             <p>Melden Sie sich an, um persönliche Infos zu sehen</p> *@
    @*             <button type="submit">Login</button> *@
    @*         </section> *@
    @*     </form> *@
    @* } *@
    @* else *@
    @* { *@
    @*     <form method="post" asp-page-handler="Logout"> *@
    @*         <section id="logout" class="category"> *@
    @*             <h2>Logout</h2> *@
    @*             <p>Logge dich aus, um die Privatsphäre deines Accounts zu schützen</p> *@
    @*             <button type="submit">Ausloggen</button> *@
    @*         </section> *@
    @*     </form> *@
    @* } *@
    @* <!--#endregion --> *@

    <!--#region Court Reservation  -->
    <form method="post" asp-page-handler="ReserveCourt">
        <section id="court-reservation" class="category">
            <h2>Platz Reservierung</h2>
            <p>Reservieren Sie sich jetzt Ihren Platz</p>
            <button type="submit">Jetzt Reservieren</button>
        </section>
    </form>
    <!--#endregion -->


    @if (User.Identity!.IsAuthenticated)
    {
        <!--#region Hallplan  -->
        <form method="post" asp-page-handler="Hallplan">
            <section id="members" class="category">
                <h2>Hallenplan</h2>
                <p>Hier sehen Sie den Hallenplan</p>
                <button type="submit">Hallenplan zeigen</button>
            </section>
        </form>
        <!--#endregion -->

        <!--#region Championship  -->
        <form method="post" asp-page-handler="Championship">
            <section id="championship" class="category">
                <h2>Vereinsmeisterschaft</h2>
                <p>Hier sehen Sie alle Infos zur Vereinsmeisterschaft</p>
                <button type="submit">Zur Vereinsmeisterschaft</button>
            </section>
        </form>
        <!--#endregion -->

        <!--#region Members  -->
        <form method="post" asp-page-handler="ShowMembers">
            <section id="members" class="category">
                <h2>Mitglieder</h2>
                <p>Hier sehen Sie alle Mitglieder</p>
                <button type="submit">Mitglieder ansehen</button>
            </section>
        </form>
        <!--#endregion -->

        <!--#region Settings  -->
        <form method="post" asp-page-handler="ShowSettings">
            <section id="members" class="category">
                <h2>Einstellungen</h2>
                <p>Hier sehen Sie Ihre persönlichen Einstellungen</p>
                <button type="submit">Einstellungen</button>
            </section>
        </form>
    }
    <!--#endregion -->

    <footer>
        <p>&copy; 2024 Tennis Club. All Rights Reserved.</p>
    </footer>
</div>
</body>
</html>