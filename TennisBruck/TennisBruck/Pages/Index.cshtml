@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    // Falls du kein _Layout verwendest, bleibt diese Zeile leer oder auf null
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Tennis Club Dashboard</title>
    
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    
    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true">
</head>
<body>

<header class="app-header">
    <div class="top-bar">
        @if (User.Identity!.IsAuthenticated)
        {
            <div class="user-greeting">
                @(Model.Player != null ? Model.Player.ToString() : "Spieler")
            </div>
            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="inline-form">
                <button type="submit" class="btn-outline-light">Logout</button>
            </form>
        }
        else
        {
            <form asp-area="Identity" asp-page="/Account/Login" method="get" class="inline-form">
                <button type="submit" class="btn-action btn-accent" style="width: auto; padding: 8px 20px; border-radius: 20px;">Login</button>
            </form>
            <form asp-area="Identity" asp-page="/Account/Register" method="get" class="inline-form">
                <button type="submit" class="btn-outline-light">Registrieren</button>
            </form>
        }
    </div>

    <h1 class="app-title">ASKÖ Bruck-Peuerbach</h1>
    <p class="app-subtitle">Dein digitales Tennis-Dashboard</p>
</header>

<main class="main-container">
    <div class="dashboard-grid">
        
        <form method="post" asp-page-handler="ReserveCourt" class="dashboard-card">
            <div class="card-icon">🎾</div>
            <h2 class="card-title">Platz Reservierung</h2>
            <p class="card-desc">Sichere dir jetzt deinen Court für das nächste Match.</p>
            <button type="submit" class="btn-action btn-accent">Jetzt Reservieren</button>
        </form>

        @if (User.Identity!.IsAuthenticated)
        {
            <form method="post" asp-page-handler="Championship" class="dashboard-card">
                <div class="card-icon">🏆</div>
                <h2 class="card-title">Vereinsmeisterschaft</h2>
                <p class="card-desc">Turnierbäume, Gruppen und deine anstehenden Matches.</p>
                <button type="submit" class="btn-action">Turnier ansehen</button>
            </form>

            <form method="post" asp-page-handler="Hallplan" class="dashboard-card">
                <div class="card-icon">📅</div>
                <h2 class="card-title">Hallenplan</h2>
                <p class="card-desc">Überprüfe die aktuelle Belegung und freie Zeiten in der Halle.</p>
                <button type="submit" class="btn-action">Plan öffnen</button>
            </form>

            <form method="post" asp-page-handler="ShowMembers" class="dashboard-card">
                <div class="card-icon">👥</div>
                <h2 class="card-title">Mitglieder</h2>
                <p class="card-desc">Finde Spielpartner und durchsuche das Vereins-Verzeichnis.</p>
                <button type="submit" class="btn-action">Mitglieder ansehen</button>
            </form>

            <form method="post" asp-page-handler="ShowSettings" class="dashboard-card">
                <div class="card-icon">⚙️</div>
                <h2 class="card-title">Einstellungen</h2>
                <p class="card-desc">Verwalte dein Profil, deine Spielstärke und Passwörter.</p>
                <button type="submit" class="btn-action">Profil bearbeiten</button>
            </form>
        }
        else
        {
            <div class="dashboard-card" style="justify-content: center; background: #e2e8f0; border: 2px dashed #cbd5e1; box-shadow: none;">
                <div class="card-icon" style="opacity: 0.5;">🔒</div>
                <h2 class="card-title" style="color: var(--text-muted);">Interner Bereich</h2>
                <p class="card-desc">Bitte logge dich ein, um Turniere, Mitglieder und den Hallenplan zu sehen.</p>
            </div>
        }
    </div>
</main>

<footer class="site-footer">
    <p>&copy; @DateTime.Now.Year Tennis Club ASKÖ Bruck-Peuerbach. Alle Rechte vorbehalten.</p>
</footer>

</body>
</html>