@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
    // Falls du kein _Layout verwendest, bleibt diese Zeile leer oder auf null
}
<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <meta http-equiv="X-UA-Compatible" content="ie=edge">
    <title>Tennis Club Dashboard</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="~/css/index.css" asp-append-version="true">
    <partial name="_PwaHeaders"/>
</head>
<body>

<header class="app-header">
    <div class="top-bar">
        @if (User.Identity!.IsAuthenticated)
        {
            <div class="user-greeting">
                @(Model.CurrentPlayer != null ? Model.CurrentPlayer.ToString() : "Spieler")
            </div>
            <form asp-area="Identity" asp-page="/Account/Logout" method="post" class="inline-form">
                <button type="submit" class="btn-outline-light">Logout</button>
            </form>
        }
        else
        {
            <form asp-area="Identity" asp-page="/Account/Login" method="get" class="inline-form">
                    <button type="submit" class="btn-action btn-danger btn-login">Login
                    </button>
            </form>
            <form asp-area="Identity" asp-page="/Account/Register" method="get" class="inline-form">
                <button type="submit" class="btn-outline-light">Registrieren</button>
            </form>
        }
    </div>

    <h1 class="app-title">ASKÖ Bruck-Peuerbach</h1>
    <p class="app-subtitle">Dein digitales Tennis-Dashboard</p>
</header>

<main class="main-container">
    <div class="dashboard-grid">

        <form method="get" asp-page="/CourtBruck" class="dashboard-card">
            <div class="card-icon">🎾</div>
            <h2 class="card-title">Platz Reservierung</h2>
            <p class="card-desc">Sichere dir jetzt deinen Court für das nächste Match.</p>
            <button type="submit" class="btn-action btn-accent">Jetzt Reservieren</button>
        </form>

        @if (User.Identity!.IsAuthenticated)
        {
            <form method="get" asp-page="/Championship" class="dashboard-card">
                <div class="card-icon">🏆</div>
                <h2 class="card-title">Vereinsmeisterschaft</h2>
                <p class="card-desc">Turnierbäume, Gruppen und deine anstehenden Matches.</p>
                <button type="submit" class="btn-action">Turnier ansehen</button>
            </form>

            <form method="get" asp-page="/Hallplan" class="dashboard-card">
                <div class="card-icon">📅</div>
                <h2 class="card-title">Hallenplan</h2>
                <p class="card-desc">Überprüfe die aktuelle Belegung und freie Zeiten in der Halle.</p>
                <button type="submit" class="btn-action">Plan öffnen</button>
            </form>

            <form method="get" asp-page="/PartnerBoard" class="dashboard-card">
                <div class="card-icon">🤝</div>

                <h2 class="card-title">Spielpartner-Börse</h2>

                <p class="card-desc">Finde unkompliziert Mitspieler für ein Match oder trage deine eigenen freien Zeiten
                    ein.</p>

                <button type="submit" class="btn-action">Börse öffnen</button>
            </form>

            <form method="get" asp-page="/Members" class="dashboard-card">
                <div class="card-icon">👥</div>
                <h2 class="card-title">Mitglieder</h2>
                <p class="card-desc">Sehe alle Mitglieder des Vereins.</p>
                <button type="submit" class="btn-action">Mitglieder ansehen</button>
            </form>

            <form method="get" asp-page="/Settings" class="dashboard-card">
                <div class="card-icon">⚙️</div>
                <h2 class="card-title">Einstellungen</h2>
                <p class="card-desc">Verwalte dein Profil, deine Spielstärke und Passwörter.</p>
                <button type="submit" class="btn-action">Profil bearbeiten</button>
            </form>
        }
        else
        {
            <div class="dashboard-card card-internal">
                <div class="card-icon opacity-50">🔒</div>
                <h2 class="card-title text-muted">Interner Bereich</h2>
                <p class="card-desc">Bitte logge dich ein, um Turniere, Mitglieder und den Hallenplan zu sehen.</p>
            </div>
        }
    </div>
</main>

<partial name="_PwaScripts"/>
</body>
</html>