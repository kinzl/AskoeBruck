@page
@model TennisBruck.Pages.Members

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Mitglieder | TennisBruck</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/members.css" asp-append-version="true">

    <script src="/js/toggleVisibility.js"></script>
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <form method="post" style="margin: 0;">
            <button type="submit" asp-page-handler="Back" class="btn-back-header">
                ← Übersicht
            </button>
        </form>
    </div>

    <h1 class="app-title">👥 Mitgliederverzeichnis</h1>
    <p style="color: var(--text-muted); margin-top: 10px;">Eingeloggt als:
        <strong>@Model.LoggedInPlayer.ToString()</strong></p>
</header>

<main class="main-container">

    @if (User.IsInRole("Admin"))
    {
        <section class="modern-card" style="border-left: 4px solid var(--accent-color);">
            <div class="card-header" style="border-bottom: none; margin-bottom: 0; padding-bottom: 0;">
                <h2 style="font-size: 1.2rem;">🛠️ Admin-Tools</h2>
                <button id="createUserButton" class="btn-action btn-accent" onclick="toggleCreateUser()" type="button">
                    + Benutzer erstellen
                </button>
            </div>

            <div id="createUser"
                 style="display: none; margin-top: 20px; padding-top: 20px; border-top: 1px solid #e2e8f0;">
                <form method="post">
                    <div class="form-grid">
                        <div class="form-group">
                            <label for="firstnameInput">Vorname</label>
                            <input id="firstnameInput" name="firstname" class="form-input" required/>
                        </div>
                        <div class="form-group">
                            <label for="lastnameInput">Nachname</label>
                            <input id="lastnameInput" name="lastname" class="form-input" required/>
                        </div>
                        <div class="form-group">
                            <label for="usernameInput">ITN</label>
                            <input id="usernameInput" name="username" class="form-input" required/>
                        </div>
                        <div class="form-group">
                            <label for="emailOrPhoneInput">Email</label>
                            <input id="emailOrPhoneInput" name="emailOrPhone" class="form-input" required type="email"/>
                        </div>
                    </div>
                    <div style="text-align: right;">
                        <button type="submit" class="btn-action" asp-page-handler="CreateUser">Benutzer in DB anlegen
                        </button>
                    </div>
                </form>
            </div>

            @if (!string.IsNullOrEmpty(Model.Message))
            {
                <div class="info-alert">@Model.Message</div>
            }
        </section>
    }

    <section class="modern-card">
        <div class="card-header">
            <h2>Aktive Mitglieder</h2>
        </div>

        <div class="table-responsive">
            <table class="members-table">
                <thead>
                <tr>
                    <th>Vorname</th>
                    <th>Nachname</th>
                    @if (User.IsInRole("Admin"))
                    {
                        <th>ITN</th>
                        <th>Email</th>
                        <th style="text-align: center;">Admin</th>
                        <th style="text-align: center;">Löschen</th>
                    }
                </tr>
                </thead>
                <tbody>
                @foreach (var player in Model.AllPlayers)
                {
                    <tr>
                        <td style="font-weight: 500;">@player.Firstname</td>
                        <td style="font-weight: 500;">@player.Lastname</td>

                        @if (User.IsInRole("Admin"))
                        {
                            <td style="color: var(--text-muted);">@player.Itn</td>
                            <td style="color: var(--text-muted);">@player.IdentityUser?.Email</td>

                            <td style="text-align: center;">
                                <form method="post" asp-page-handler="ChangeAdmin" style="margin: 0;">
                                    <input type="hidden" name="user" value="@player.Id"/>
                                    <label class="switch" title="Admin-Rechte umschalten">
                                        <input type="checkbox" onclick="this.form.submit()"
                                               @(player.IdentityUser != null && Model.AdminUserIds.Contains(player.IdentityUser.Id) ? "checked" : "")/>
                                        <span class="slider"></span>
                                    </label>
                                </form>
                            </td>

                            <td style="text-align: center;">
                                <form method="post" style="margin: 0; display: inline-block;">
                                    <button class="btn-danger-icon" name="playerId" value="@player.Id" type="submit"
                                            asp-page-handler="DeleteUser"
                                            onclick="return confirm('Möchtest du @player.Firstname wirklich komplett aus dem System löschen?');"
                                            title="User löschen">
                                        🗑️
                                    </button>
                                </form>
                            </td>
                        }
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </section>

</main>
</body>
</html>