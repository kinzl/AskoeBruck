@model TennisBruck.Pages.Championship
@using Microsoft.AspNetCore.Http

@{
    var grouped = Model.Matches.GroupBy(m => m.RoundNo).OrderBy(g => g.Key).ToList();
    var phases = Model.Matches.GroupBy(m => m.PhaseName ?? "A-Bewerb").OrderBy(g => g.Key).ToList();
    string? sessionPhase = Context.Session.GetString("ActivePhase");
    string activePhase = sessionPhase ?? TempData["ActivePhase"]?.ToString() ?? phases.FirstOrDefault()?.Key ?? "A-Bewerb";
    int globalInputIndex = 0;

    string GetTeamClass(KnockoutMatch m, Team? team, string winnerClass, string loserClass, string tbdClass)
    {
        if (m.Winner != null || m.IsWalkover)
        {
            bool isWinner = m.Winner?.Id == team?.Id || (m.IsWalkover && m.WalkoverTeamId != team?.Id);
            return isWinner ? winnerClass : loserClass;
        }
        return team == null ? tbdClass : "";
    }
}

@if (grouped.Any() || User.IsInRole("Admin"))
{
    <form method="post" id="deletePhaseForm" style="display: none;"></form>
    <section class="modern-card">
        <div class="card-header">
            <h2>K.O. Phase</h2>
            @if (User.IsInRole("Admin"))
            {
                <form method="post" class="bracket-admin-form">
                    <div class="bracket-inputs-row">
                        <input type="text" asp-for="PhaseName" placeholder="Z.B A-Bewerb"
                               class="input-score bracket-name-input"/>
                        <select asp-for="SelectedSize" class="bracket-select-w150">
                            <option value="2">Finale (2)</option>
                            <option value="4">Halbfinale (4)</option>
                            <option value="8">Viertelfinale (8)</option>
                            <option value="16">Achtelfinale (16)</option>
                            <option value="32">32er (32)</option>
                        </select>
                    </div>
                    <div class="bracket-buttons-row">
                        <button type="button" class="btn-action btn-sm" onclick="checkPhaseExists()">
                            ➕ Raster hinzufügen
                        </button>
                        <button type="submit" id="btnRealCreateBracket" asp-page-handler="CreateBracket"
                                style="display: none;"></button>
                    </div>
                </form>
            }
        </div>

        <div class="bracket-scroll-area">
            <form method="post">
                @if (phases.Count > 1)
                {
                    <div class="competition-pills mb-4 bracket-tabs bracket-tabs-row">
                        @foreach (var phase in phases)
                        {
                            bool isActive = phase.Key == activePhase;
                            <button type="submit" asp-page-handler="SwitchPhase" name="phaseName"
                                    value="@phase.Key" class="bracket-pill-btn @(isActive ? "active" : "")">
                                @phase.Key
                            </button>
                        }
                        @if (User.IsInRole("Admin") && phases.Any(p => p.Key == activePhase))
                        {
                            <span class="m-0 bracket-delete-form">
                                <button type="submit" form="deletePhaseForm" asp-page-handler="DeletePhase"
                                        name="phaseToDelete"
                                        value="@activePhase"
                                        class="btn-action btn-sm btn-danger"
                                        onclick="return confirm('Möchtest du diesen Raster (@activePhase) und alle darin enthaltenen Spiele wirklich unwiderruflich löschen?');">
                                    🗑️
                                </button>
                            </span>
                        }
                    </div>
                }
                else if (User.IsInRole("Admin") && phases.Any(p => p.Key == activePhase))
                {
                    <div class="bracket-single-delete">
                        <button type="submit" form="deletePhaseForm" asp-page-handler="DeletePhase" name="phaseToDelete"
                                value="@activePhase"
                                class="btn-action btn-sm btn-danger"
                                onclick="return confirm('Möchtest du diesen Raster (@activePhase) und alle darin enthaltenen Spiele wirklich unwiderruflich löschen?');">
                            🗑️ Raster löschen
                        </button>
                    </div>
                }

                @{
                    var activePhaseGroup = phases.FirstOrDefault(p => p.Key == activePhase);
                }
                @if (activePhaseGroup != null)
                {
                    var phaseGrouped = activePhaseGroup.GroupBy(m => m.RoundNo).OrderBy(g => g.Key).ToList();

                    <div class="bracket-phase-container">
                        <div class="bracket-flex mb-24">
                            @foreach (var round in phaseGrouped)
                            {
                                <div class="bracket-col">
                                    @foreach (var match in round)
                                    {
                                        @if (match.IsBye)
                                        {
                                            var byeIndex = globalInputIndex++;
                                            bool byeAdvanced = match.Team1 != null;
                                            <div class="match-scorecard bracket-match-card bracket-bye-card @(byeAdvanced ? "match-complete" : "")">
                                                <input type="hidden" name="Inputs[@byeIndex].MatchId" value="@match.Id" />
                                                <div class="bracket-match-info">Match @match.BracketNo · <span class="bye-label">Freilos</span></div>
                                                @if (User.IsInRole("Admin") && match.RoundNo == 1)
                                                {
                                                    <div class="bracket-admin-selects">
                                                        <div class="bracket-admin-row">
                                                            <select name="Inputs[@byeIndex].Team1Id"
                                                                    class="bracket-select @(byeAdvanced ? "select-winner" : "")"
                                                                    disabled="@(byeAdvanced ? "disabled" : null)">
                                                                <option value="">Team mit Freilos wählen</option>
                                                                @foreach (var team in Model.RegisteredTeams)
                                                                {
                                                                    <option value="@team.Id"
                                                                            selected="@(match.Team1?.Id == team.Id)">@team.PlayersToStringWithItn()</option>
                                                                }
                                                            </select>
                                                            @if (byeAdvanced)
                                                            {
                                                                <span class="bracket-player-score">✓ weiter</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="bracket-slots-container">
                                                        <div class="bracket-slot slot-top @(byeAdvanced ? "slot-winner" : "slot-tbd")">
                                                            <span class="bracket-player-name">@(match.Team1?.PlayersToStringWithItn() ?? "TBD")</span>
                                                        </div>
                                                        <div class="bracket-slot slot-bottom slot-bye">
                                                            <span class="bracket-player-name bye-label">Freilos</span>
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            var currentIndex = globalInputIndex++;
                                            bool isDecided = match.Winner != null || match.IsWalkover;
                                            string team1Score = "";
                                            string team2Score = "";
                                            if (match.IsWalkover)
                                            {
                                                team1Score = match.WalkoverTeamId == match.Team1?.Id ? "w.o." : "";
                                                team2Score = match.WalkoverTeamId == match.Team2?.Id ? "w.o." : "";
                                            }
                                            else if (match.Sets != null && match.Sets.Any())
                                            {
                                                team1Score = string.Join(" ", match.Sets.OrderBy(s => s.SetNumber).Select(s => s.Player1GamesWon));
                                                team2Score = string.Join(" ", match.Sets.OrderBy(s => s.SetNumber).Select(s => s.Player2GamesWon));
                                            }

                                            <div
                                                class="match-scorecard bracket-match-card @(isDecided ? "match-complete" : "")">
                                                <input type="hidden" name="Inputs[@currentIndex].MatchId"
                                                       value="@match.Id"/>
                                                <div class="bracket-match-info">Match @match.BracketNo</div>

                                                @if (User.IsInRole("Admin") && match.RoundNo == 1)
                                                {
                                                    bool alreadyFreilos = match.IsWalkover && match.Team2 == null;
                                                    <div class="bracket-admin-selects">
                                                        <div class="bracket-admin-row">
                                                            <select name="Inputs[@currentIndex].Team1Id"
                                                                    class="bracket-select @GetTeamClass(match, match.Team1, "select-winner", "select-loser", "")"
                                                                    disabled="@(isDecided ? "disabled" : null)">
                                                                <option value="">Team 1 wählen</option>
                                                                @foreach (var team in Model.RegisteredTeams)
                                                                {
                                                                    <option value="@team.Id"
                                                                            selected="@(match.Team1?.Id == team.Id)">@team.PlayersToStringWithItn()</option>
                                                                }
                                                            </select>
                                                            @if (!string.IsNullOrEmpty(team1Score))
                                                            {
                                                                <span class="bracket-player-score">@team1Score</span>
                                                            }
                                                        </div>
                                                        <div class="bracket-admin-row">
                                                            <select name="Inputs[@currentIndex].Team2Id"
                                                                    class="bracket-select @GetTeamClass(match, match.Team2, "select-winner", "select-loser", "") @(alreadyFreilos ? "select-freilos" : "")"
                                                                    disabled="@(isDecided ? "disabled" : null)">
                                                                <option value="">Team 2 wählen</option>
                                                                <option value="-1" selected="@alreadyFreilos">Freilos</option>
                                                                @foreach (var team in Model.RegisteredTeams)
                                                                {
                                                                    <option value="@team.Id"
                                                                            selected="@(match.Team2?.Id == team.Id)">@team.PlayersToStringWithItn()</option>
                                                                }
                                                            </select>
                                                            @if (!string.IsNullOrEmpty(team2Score))
                                                            {
                                                                <span class="bracket-player-score">@team2Score</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                                else
                                                {
                                                    <div class="bracket-slots-container">
                                                        <div class="bracket-slot slot-top @GetTeamClass(match, match.Team1, "slot-winner", "slot-loser", "slot-tbd")"
                                                             title="@(match.Team1?.PlayersToStringWithItn() ?? "TBD")">
                                                            <span
                                                                class="bracket-player-name">@(match.Team1?.PlayersToStringWithItn() ?? "TBD")</span>
                                                            @if (!string.IsNullOrEmpty(team1Score))
                                                            {
                                                                <span class="bracket-player-score">@team1Score</span>
                                                            }
                                                        </div>
                                                        <div class="bracket-slot slot-bottom @GetTeamClass(match, match.Team2, "slot-winner", "slot-loser", "slot-tbd")"
                                                             title="@(match.Team2?.PlayersToStringWithItn() ?? "TBD")">
                                                            <span
                                                                class="bracket-player-name">@(match.Team2?.PlayersToStringWithItn() ?? "TBD")</span>
                                                            @if (!string.IsNullOrEmpty(team2Score))
                                                            {
                                                                <span class="bracket-player-score">@team2Score</span>
                                                            }
                                                        </div>
                                                    </div>
                                                }
                                            </div>
                                        }
                                    }
                                </div>
                            }
                        </div>
                    </div>
                }

                @if (User.IsInRole("Admin") && grouped.Any())
                {
                    <button type="submit" asp-page-handler="ApplyUserInputs"
                            class="btn-action btn-accent bracket-save-btn">
                        Zuteilung im Raster speichern
                    </button>
                }
            </form>
        </div>
    </section>
}
