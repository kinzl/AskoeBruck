@model TennisBruck.Pages.Championship

@functions {
    string GetRowClass(TennisDb.Match match, Team team)
    {
        if (team == null) return "";
        if (match.Winner != null)
        {
            if (match.IsWalkover)
            {
                return match.WalkoverTeamId == team.Id ? "walkover-loser" : "winner";
            }
            return match.Winner.Id == team.Id ? "winner" : "loser";
        }
        return "";
    }
}

@if (Model.PersonalMatches.Any())
{
    <section class="modern-card card-accent-border">
        <div class="card-header">
            <h2>Deine nächsten Matches</h2>
        </div>

        @foreach (var match in Model.PersonalMatches)
        {
            string team1Score = "";
            string team2Score = "";
            bool isDecided = match.IsWalkover || (match.Sets != null && match.Sets.Any());

            if (match.IsWalkover)
            {
                if (match.Sets != null && match.Sets.Any())
                {
                    string p1 = string.Join(" ", match.Sets.OrderBy(s => s.SetNumber).Select(s => s.Player1GamesWon));
                    string p2 = string.Join(" ", match.Sets.OrderBy(s => s.SetNumber).Select(s => s.Player2GamesWon));
                    team1Score = match.WalkoverTeamId == match.Team1?.Id ? $"{p1} w.o." : p1;
                    team2Score = match.WalkoverTeamId == match.Team2?.Id ? $"{p2} w.o." : p2;
                }
                else
                {
                    team1Score = match.WalkoverTeamId == match.Team1?.Id ? "w.o." : "";
                    team2Score = match.WalkoverTeamId == match.Team2?.Id ? "w.o." : "";
                }
            }
            else if (match.Sets != null && match.Sets.Any())
            {
                team1Score = string.Join(" ", match.Sets.OrderBy(s => s.SetNumber).Select(s => s.Player1GamesWon));
                team2Score = string.Join(" ", match.Sets.OrderBy(s => s.SetNumber).Select(s => s.Player2GamesWon));
            }

            string competitionName = match.Group?.Competition?.Name
                ?? (match as KnockoutMatch)?.Competition?.Name
                ?? Model.Competitions.FirstOrDefault(c => c.Id == (match as KnockoutMatch)?.CompetitionId)?.Name
                ?? "";

            string groupCategory = match.Group != null ? match.Group.GroupName : ((match as KnockoutMatch)?.PhaseName ?? "K.O Phase");

            <div class="match-scorecard">
                <div class="match-main-info">
                    <div class="match-players-stacked">
                        <div class="match-player-row @GetRowClass(match, match.Team1)">
                            <span class="player-name" title="@match.Team1?.PlayersToString()">@match.Team1?.PlayersToString()</span>
                            @if (!string.IsNullOrEmpty(team1Score))
                            {
                                <span class="match-player-score-inline">@team1Score</span>
                            }
                        </div>
                        <div class="match-player-row @GetRowClass(match, match.Team2)">
                            <span class="player-name" title="@match.Team2?.PlayersToString()">@match.Team2?.PlayersToString()</span>
                            @if (!string.IsNullOrEmpty(team2Score))
                            {
                                <span class="match-player-score-inline">@team2Score</span>
                            }
                        </div>
                    </div>

                    <div class="match-meta-container">
                        @if (!string.IsNullOrEmpty(competitionName))
                        {
                            <span class="badge-phase badge-comp">@competitionName</span>
                        }
                        <span class="badge-phase">
                            @groupCategory
                        </span>
                        @if (isDecided)
                        {
                            <form method="post" class="inline-form-zero" style="display:inline-block;">
                                <input type="hidden" name="matchId" value="@match.Id"/>
                                <button type="submit" class="btn-action btn-danger btn-xs" asp-page-handler="DeleteMatch">
                                    Rückgängig
                                </button>
                            </form>
                        }
                    </div>
                </div>

                @if (!isDecided)
                {
                    bool isCurrentUserTeam1 = match.Team1?.TeamPlayers.Any(p => p.PlayerId == Model.CurrentPlayer?.Id) == true;
                    int? myTeamId = isCurrentUserTeam1 ? match.Team1?.Id : match.Team2?.Id;
                    int? opponentTeamId = isCurrentUserTeam1 ? match.Team2?.Id : match.Team1?.Id;

                    <form method="post" class="match-action-form">
                        <input type="hidden" name="matchId" value="@match.Id"/>
                        <div class="flex-center-gap flex-wrap">
                            <input type="text" name="score" placeholder="6:4 6:2 oder leer bei w.o." class="input-score-sm"/>
                            
                            <label class="wo-toggle-label" title="Aufgabe / w.o. (mit oder ohne Spielstand)">
                                <input type="checkbox" name="isWalkover" value="true" class="wo-checkbox" onchange="toggleCardWalkover(this)" />
                                <span>w.o.</span>
                            </label>

                            <select name="walkoverTeamId" class="wo-select-sm" style="display:none;" disabled>
                                <option value="@myTeamId">Ich habe aufgegeben</option>
                                <option value="@opponentTeamId">Gegner hat aufgegeben</option>
                            </select>

                            <button type="submit" class="btn-action btn-xs" asp-page-handler="SaveMatch">Eintragen</button>
                        </div>
                    </form>
                }
            </div>
        }
    </section>
}
