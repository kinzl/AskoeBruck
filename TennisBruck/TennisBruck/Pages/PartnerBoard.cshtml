@page
@model TennisBruck.Pages.PartnerBoardModel

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <link rel="stylesheet" href="css/partnerboard.css"/>
    <title>Spielpartner-Suche</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
</head>
<body>
<div class="dark-header-section">
    <div class="header-top-bar">
        <a href="/" class="back-button">← Übersicht</a>
    </div>

    <h1 class="fw-bold mb-2">Spielpartner-Suche</h1>
    <p class="text-white-50">Finde unkompliziert Mitspieler oder trage deine verfügbaren Zeiten ein</p>

</div>

<div class="main-content-container">
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert-box-custom alert-success-custom mb-3">
            <i class="bi bi-check-circle-fill me-2"></i>
            <strong>@TempData["SuccessMessage"]</strong>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert-box-custom alert-error-custom mb-3">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>
            <strong>@TempData["ErrorMessage"]</strong>
        </div>
    }

    <!-- FILTER BAR -->
    <div class="hallenplan-card mb-4 filter-card">
        <form method="get" class="row g-2 align-items-end">
            <div class="col-12 col-md-2">
                <label class="form-label small text-muted mb-1 fw-bold">Datum von</label>
                <input type="date" name="FilterDateFrom" class="form-control form-control-sm"
                       value="@Model.FilterDateFrom?.ToString("yyyy-MM-dd")"/>
            </div>
            <div class="col-12 col-md-2">
                <label class="form-label small text-muted mb-1 fw-bold">Datum bis</label>
                <input type="date" name="FilterDateTo" class="form-control form-control-sm"
                       value="@Model.FilterDateTo?.ToString("yyyy-MM-dd")"/>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1 fw-bold">Zeit von</label>
                <input type="time" name="FilterTimeFrom" class="form-control form-control-sm"
                       value="@Model.FilterTimeFrom?.ToString(@"hh\:mm")"/>
            </div>
            <div class="col-6 col-md-2">
                <label class="form-label small text-muted mb-1 fw-bold">Zeit bis</label>
                <input type="time" name="FilterTimeTo" class="form-control form-control-sm"
                       value="@Model.FilterTimeTo?.ToString(@"hh\:mm")"/>
            </div>
            <div class="col-6 col-md-2">
                <button type="submit" class="btn btn-sm btn-outline-secondary w-100">
                    <i class="bi bi-funnel"></i> Filtern
                </button>
            </div>
            <div class="col-6 col-md-2">
                <a href="/PartnerBoard" class="btn btn-sm btn-outline-danger w-100">
                    <i class="bi bi-x-circle"></i> Zurücksetzen
                </a>
            </div>
        </form>
    </div>

    <!-- MEINE OFFENEN EINTRÄGE -->
    @if (Model.MyOpenSlots.Any())
    {
        <div class="hallenplan-card mb-4 card-warning-accent">
            <h5 class="fw-bold mb-3 text-dark-blue">
                <i class="bi bi-person-lines-fill text-warning me-2"></i> Meine offenen Einträge
            </h5>
            <div class="list-group list-group-flush shadow-sm rounded">
                @foreach (var slot in Model.MyOpenSlots)
                {
                    <div
                        class="list-group-item d-flex justify-content-between align-items-center p-3 border-0 mb-1 rounded bg-white my-open-slot-item">
                        <div class="w-100 pe-3">
                            <div class="d-flex align-items-center mb-1">
                                <span class="badge bg-secondary me-2">@(slot.IsDouble ? "Doppel" : "Einzel")</span>
                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Mein Eintrag</span>
                            </div>
                            <small class="text-muted d-block mb-1">
                                <i class="bi bi-clock me-1"></i> @slot.Date.ToString("dd.MM.yyyy") | @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm") Uhr
                            </small>
                            @{
                                int totalJoined = 0;
                                if (slot.MatchedWithPlayerId != null) totalJoined++;
                                if (slot.MatchedWithPlayer2Id != null) totalJoined++;
                                if (slot.MatchedWithPlayer3Id != null) totalJoined++;
                                int missingPlayers = slot.NeededPlayers - totalJoined;
                            }
                            <div class="small text-danger fw-bold mt-1">
                                @if (slot.IsDouble)
                                {
                                    <span>Sucht noch @missingPlayers Mitspieler (Doppel)</span>
                                }
                                else
                                {
                                    <span>Sucht @slot.NeededPlayers Mitspieler (Einzel)</span>
                                }
                            </div>
                            <div class="small text-muted mb-1">
                                Bisher dabei: @slot.Player
                                @(slot.MatchedWithPlayer != null ? ", " + slot.MatchedWithPlayer : "")
                                @(slot.MatchedWithPlayer2 != null ? ", " + slot.MatchedWithPlayer2 : "")
                                @(slot.MatchedWithPlayer3 != null ? ", " + slot.MatchedWithPlayer3 : "")
                            </div>
                            @if (!string.IsNullOrEmpty(slot.Message))
                            {
                                <div class="small fst-italic mt-1 text-secondary pt-1 border-top border-light">
                                    "@slot.Message"
                                </div>
                            }
                        </div>
                        <div class="text-end ms-3 flex-shrink-0 d-flex flex-column gap-2">
                            <button type="button" class="btn btn-sm btn-outline-secondary fw-bold"
                                    onclick="openEditModal(@slot.Id, '@slot.Date.ToString("yyyy-MM-dd")', '@slot.StartTime.ToString(@"hh\:mm")', '@slot.EndTime.ToString(@"hh\:mm")', '@slot.NeededPlayers', '@slot.Message')">
                                <i class="bi bi-pencil-square me-1"></i> Bearbeiten
                            </button>
                            <form method="post" asp-page-handler="DeleteSlot" class="m-0">
                                <input type="hidden" name="SlotId" value="@slot.Id"/>
                                <button type="submit" class="btn btn-sm btn-outline-danger fw-bold w-100"
                                        onclick="return confirm('Möchtest du deinen Eintrag wirklich löschen?');">
                                    <i class="bi bi-trash3 me-1"></i> Löschen
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }

    <!-- MEINE FIXIERTEN MATCHES -->
    @if (Model.MyFixedMatches.Any())
    {
        <div class="hallenplan-card mb-4 card-highlight">
            <h5 class="fw-bold mb-3 text-dark-blue">
                <i class="bi bi-calendar-check-fill text-success me-2"></i> Meine fixierten Matches
            </h5>

            <div class="list-group list-group-flush shadow-sm rounded">
                @foreach (var match in Model.MyFixedMatches)
                {
                    <div
                        class="list-group-item d-flex justify-content-between align-items-center p-3 border-0 mb-1 rounded bg-white @(match.PlayerId == Model.CurrentPlayerId ? "my-open-slot-item" : "my-joined-slot-item")">
                        <div>
                            <div class="d-flex align-items-center mb-1">
                                <span class="badge bg-secondary me-2">@(match.IsDouble ? "Doppel" : "Einzel")</span>
                                @if (match.PlayerId == Model.CurrentPlayerId)
                                {
                                    <span class="badge bg-primary-subtle text-primary border border-primary-subtle">Von mir erstellt</span>
                                }
                                else
                                {
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Teilgenommen</span>
                                }
                            </div>
                            @if (match.IsDouble)
                            {
                                <div class="mt-1 mb-2">
                                    <small class="text-muted">Teilnehmer: </small>
                                    <strong>@match.Player</strong>@if (match.MatchedWithPlayer != null) { <span>, </span><strong>@match.MatchedWithPlayer</strong> }@if (match.MatchedWithPlayer2 != null) { <span>, </span><strong>@match.MatchedWithPlayer2</strong> }@if (match.MatchedWithPlayer3 != null) { <span>, </span><strong>@match.MatchedWithPlayer3</strong> }
                                </div>
                            }
                            else
                            {
                                <div class="mt-1 mb-2">
                                    <strong class="text-navy">@match.Player</strong> spielt gegen <strong
                                        class="text-navy">@match.MatchedWithPlayer</strong>
                                </div>
                            }

                            <div class="small text-muted mt-2">
                                <i class="bi bi-clock me-1"></i> @match.Date.ToString("dd.MM.yyyy") | @match.StartTime.ToString(@"hh\:mm") - @match.EndTime.ToString(@"hh\:mm") Uhr
                            </div>
                        </div>

                        <div class="text-end">
                            <span class="badge badge-fixed mb-2 d-inline-block">Fixiert ✔</span>
                            <form method="post" asp-page-handler="DeleteSlot" class="m-0">
                                <input type="hidden" name="SlotId" value="@match.Id"/>
                                <button type="submit" class="btn btn-sm btn-outline-warning fw-bold"
                                        onclick="return confirm('Möchtest du wirklich absagen?');">
                                    <i class="bi bi-x-circle me-1"></i> Absagen
                                </button>
                            </form>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    <div class="hallenplan-card d-flex justify-content-between align-items-center">
        <h5 class="mb-0 fw-bold text-slate">Verfügbare Zeiten</h5>
        <button type="button" class="btn-limone" data-bs-toggle="modal" data-bs-target="#createSlotModal">
            + Zeit eintragen
        </button>
    </div>

    <div class="hallenplan-card card-with-accent">

        @if (!Model.SlotsByDay.Any())
        {
            <div class="text-center py-5">
                <div class="empty-state-icon"><i class="bi bi-calendar-x"></i></div>
                <h5 class="fw-bold text-navy">Aktuell keine Gesuche!</h5>
                <p class="text-muted mb-0">Sei der Erste und trage ein, wann du Zeit hast.</p>
            </div>
        }
        else
        {
            <div class="list-group list-group-flush">
                @foreach (var dayGroup in Model.SlotsByDay)
                {
                    <h6 class="fw-bold mt-3 mb-2 text-navy">
                        <i class="bi bi-calendar-event me-2 text-muted"></i>
                        @dayGroup.Key.ToString("dd. MMMM yyyy")
                    </h6>

                    @foreach (var slot in dayGroup.Value)
                    {
                        var hasJoined = slot.MatchedWithPlayerId == Model.CurrentPlayerId || slot.MatchedWithPlayer2Id == Model.CurrentPlayerId || slot.MatchedWithPlayer3Id == Model.CurrentPlayerId;
                        <div
                            class="list-group-item d-flex justify-content-between align-items-center border-0 mb-2 rounded @(hasJoined ? "my-joined-slot-item" : "bg-light")">
                            <div class="w-100 pe-3">
                                <div class="d-flex align-items-center mb-1">
                                    <span class="badge bg-secondary me-2">@(slot.IsDouble ? "Doppel" : "Einzel")</span>
                                    @if (hasJoined)
                                    {
                                        <span class="badge bg-success-subtle text-success border border-success-subtle me-2">Angemeldet</span>
                                    }
                                    <strong class="text-dark">@(slot.Player.ToString() ?? "Unbekannt")</strong>
                                </div>
                                <small class="text-muted d-block mb-1">
                                    <i class="bi bi-clock me-1"></i> @slot.StartTime.ToString(@"hh\:mm") - @slot.EndTime.ToString(@"hh\:mm") Uhr
                                </small>
                                @{
                                    int totalJoined = 0;
                                    if (slot.MatchedWithPlayerId != null) totalJoined++;
                                    if (slot.MatchedWithPlayer2Id != null) totalJoined++;
                                    if (slot.MatchedWithPlayer3Id != null) totalJoined++;
                                    int missingPlayers = slot.NeededPlayers - totalJoined;
                                }
                                <div class="small text-danger fw-bold mt-1">
                                    Noch @missingPlayers Mitspieler gesucht!
                                </div>
                                <div class="small text-muted mb-1">
                                    Bisher dabei: @slot.Player
                                    @(slot.MatchedWithPlayer != null ? ", " + slot.MatchedWithPlayer : "")
                                    @(slot.MatchedWithPlayer2 != null ? ", " + slot.MatchedWithPlayer2 : "")
                                    @(slot.MatchedWithPlayer3 != null ? ", " + slot.MatchedWithPlayer3 : "")
                                </div>
                                @if (!string.IsNullOrEmpty(slot.Message))
                                {
                                    <div class="small fst-italic mt-1 text-secondary pt-1 border-top border-light">
                                        "@slot.Message"
                                    </div>
                                }
                            </div>
                            <div class="ms-3 d-flex flex-column gap-2 flex-shrink-0">
                                @if (slot.MatchedWithPlayerId == Model.CurrentPlayerId || slot.MatchedWithPlayer2Id == Model.CurrentPlayerId || slot.MatchedWithPlayer3Id == Model.CurrentPlayerId)
                                {
                                    <form method="post" asp-page-handler="DeleteSlot" class="m-0">
                                        <input type="hidden" name="SlotId" value="@slot.Id"/>
                                        <button type="submit" class="btn btn-sm btn-outline-warning fw-bold w-100"
                                                onclick="return confirm('Möchtest du absagen?');">
                                            <i class="bi bi-x-circle me-1"></i> Absagen
                                        </button>
                                    </form>
                                }
                                else
                                {
                                    <form method="post" asp-page-handler="AcceptMatch" class="m-0">
                                        <input type="hidden" name="SlotId" value="@slot.Id"/>
                                        <button type="submit" class="btn btn-sm btn-limone fw-bold w-100">
                                            Dabei sein
                                        </button>
                                    </form>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        }
    </div>

</div>

<div class="modal fade" id="createSlotModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-navy">Wann hast du Zeit?</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="CreateSlot">
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Datum</label>
                        <input type="date" name="date" class="form-control"
                               value="@DateTime.Today.ToString("yyyy-MM-dd")"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" required/>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label fw-bold text-muted small">Von (Uhrzeit)</label>
                            <input type="time" name="startTime" class="form-control" required/>
                        </div>
                        <div class="col">
                            <label class="form-label fw-bold text-muted small">Bis (Uhrzeit)</label>
                            <input type="time" name="endTime" class="form-control" required/>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Nachricht (Optional)</label>
                        <input type="text" name="message" class="form-control"
                               placeholder="Z.B. Suche Gegner für lockeres Einzel" maxlength="200"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Match-Typ</label>
                        <select name="neededPlayers" class="form-select">
                            <option value="1">Einzel (1 weiterer Spieler gesucht)</option>
                            <option value="3">Doppel (3 weitere Spieler gesucht)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn-limone">Speichern</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Eintrag Bearbeiten -->
<div class="modal fade" id="editSlotModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content border-0 shadow">
            <div class="modal-header border-bottom-0 pb-0">
                <h5 class="modal-title fw-bold text-navy">Eintrag bearbeiten</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <form method="post" asp-page-handler="EditSlot">
                <input type="hidden" id="editSlotId" name="editSlotId"/>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Datum</label>
                        <input type="date" id="editDate" name="editDate" class="form-control"
                               min="@DateTime.Today.ToString("yyyy-MM-dd")" required/>
                    </div>
                    <div class="row mb-3">
                        <div class="col">
                            <label class="form-label fw-bold text-muted small">Von (Uhrzeit)</label>
                            <input type="time" id="editStartTime" name="editStartTime" class="form-control" required/>
                        </div>
                        <div class="col">
                            <label class="form-label fw-bold text-muted small">Bis (Uhrzeit)</label>
                            <input type="time" id="editEndTime" name="editEndTime" class="form-control" required/>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Nachricht (Optional)</label>
                        <input type="text" id="editMessage" name="editMessage" class="form-control"
                               maxlength="200"/>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold text-muted small">Match-Typ</label>
                        <select id="editNeededPlayers" name="editNeededPlayers" class="form-select">
                            <option value="1">Einzel (1 weiterer Spieler gesucht)</option>
                            <option value="3">Doppel (3 weitere Spieler gesucht)</option>
                        </select>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-light" data-bs-dismiss="modal">Abbrechen</button>
                    <button type="submit" class="btn-limone">Aktualisieren</button>
                </div>
            </form>
        </div>
    </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script>
    function openEditModal(id, date, startTime, endTime, neededPlayers, message) {
        document.getElementById('editSlotId').value = id;
        document.getElementById('editDate').value = date;
        document.getElementById('editStartTime').value = startTime;
        document.getElementById('editEndTime').value = endTime;
        document.getElementById('editNeededPlayers').value = neededPlayers;
        document.getElementById('editMessage').value = message;

        var editModal = new bootstrap.Modal(document.getElementById('editSlotModal'));
        editModal.show();
    }
</script>
</body>
</html>