@page
@model TennisBruck.Pages.PyramidModel
@{
    ViewData["Title"] = "Forderungspyramide";
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Forderungspyramide - ASKÖ Bruck-Peuerbach</title>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/tournaments.css" asp-append-version="true">
    <link rel="stylesheet" href="~/css/pyramid.css" asp-append-version="true">
    <partial name="_PwaHeaders"/>
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <a asp-page="/Index" class="btn-back-header">← Dashboard</a>
    </div>
    <h1 class="app-title">Forderungspyramide</h1>
    <p class="header-subtitle">Klettere an die Spitze der Pyramide durch Siege in Einzel- und Doppel-Matches!</p>

    @if (Model.PyramidCompetitions.Any())
    {
        <form method="post" asp-page-handler="SelectCompetition">
            <div class="competition-pills">
                @if (Model.PyramidCompetitions.Count < 4)
                {
                    @foreach (var comp in Model.PyramidCompetitions)
                    {
                        var isActive = Model.SelectedCompetition?.Id == comp.Id;
                        <button type="submit" name="competitionId" value="@comp.Id"
                                class="pill-btn @(isActive ? "active" : "")">
                            @comp.Name (@(comp.IsSingle ? "Einzel" : "Doppel"))
                        </button>
                    }
                }
                else
                {
                    var isCurrentActive = Model.PyramidCompetitions.Any(c => c.Id == Model.SelectedCompetition?.Id);
                    <select name="competitionId" class="pill-btn pill-select @(isCurrentActive ? "active" : "")"
                            onchange="this.form.submit()">
                        <option value="" disabled selected="@(!isCurrentActive)">Aktuelle Pyramiden</option>
                        @foreach (var comp in Model.PyramidCompetitions)
                        {
                            var isActive = Model.SelectedCompetition?.Id == comp.Id;
                            <option value="@comp.Id" selected="@isActive">
                                @comp.Name (@(comp.IsSingle ? "Einzel" : "Doppel"))
                            </option>
                        }
                    </select>
                }
            </div>
        </form>
    }

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-box @(Model.IsError ? "alert-error" : "alert-success")">
            <span>@(Model.IsError ? "⚠️" : "✅")</span>
            <span>@Model.Message</span>
        </div>
    }
</header>

<main class="main-container">

    @if (Model.SelectedCompetition != null)
    {
        <!-- 1. PYRAMID VISUAL DISPLAY AT THE TOP -->
        <div class="modern-card">
            <div class="card-header card-header-flex">
                <h2 class="card-title-lg">@Model.SelectedCompetition.Name</h2>
                <span
                    class="badge-count font-weight-bold">@(Model.SelectedCompetition.IsSingle ? "Einzel" : "Doppel")</span>
            </div>

            @if (Model.PyramidLevels.Any())
            {
                <div class="pyramid-container">
                    @foreach (var level in Model.PyramidLevels)
                    {
                        <div class="pyramid-level">
                            @foreach (var node in level.Nodes)
                            {
                                string rankClass = node.PyramidRank.Rank == 1 ? "rank-top" : node.PyramidRank.Rank <= 3 ? "rank-second" : node.PyramidRank.Rank <= 6 ? "rank-third" : "";
                                string myTeamClass = node.IsMyTeam ? "node-my-team" : "";

                                <div class="pyramid-node @rankClass @myTeamClass">
                                    <span class="rank-badge">
                                         #@node.PyramidRank.Rank
                                    </span>

                                    <div class="node-team-name">
                                        @node.PyramidRank.Team.PlayersToString()
                                    </div>

                                    @if (node.ActiveChallenge != null)
                                    {
                                        <div class="challenge-badge">In Forderung</div>
                                    }

                                    @if (node.CanBeChallengedByCurrentUser)
                                    {
                                        <div class="node-actions">
                                            <form method="post" asp-page-handler="Challenge" class="inline-form">
                                                <input type="hidden" name="competitionId"
                                                       value="@Model.SelectedCompetition.Id"/>
                                                <input type="hidden" name="defenderTeamId"
                                                       value="@node.PyramidRank.TeamId"/>
                                                <button type="submit" class="btn-challenge">Fordern</button>
                                            </form>
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="pyramid-empty-box">
                    <p>In dieser Pyramide sind noch keine Teilnehmer eingetragen.</p>
                    <p class="pyramid-empty-subtext">Nutze die Anmeldefunktion unten, um als Erster der Pyramide
                        beizutreten!</p>
                </div>
            }
        </div>

        <!-- 2. USER SELF-REGISTRATION SECTION -->
        @if (User.Identity!.IsAuthenticated)
        {
            <div class="user-join-card">
                <div class="user-join-info">
                    @if (Model.IsCurrentUserInPyramid)
                    {
                        <h4 class="user-join-title">Du nimmst an dieser Pyramide teil!</h4>
                        <p class="user-join-desc">Deine aktuelle Position ist <strong>Rang #@Model.MyRank?.Rank</strong>.
                            Fordere oben platzierte Spieler heraus!</p>
                    }
                    else if (!Model.SelectedCompetition.IsSingle)
                    {
                        <h4 class="user-join-title">Doppel-Pyramide Anmeldung</h4>
                        <p class="user-join-desc">
                            📅 Anmeldefrist bis
                            <strong>@Model.SelectedCompetition.RegistrationUntil.ToString("dd.MM.yyyy HH:mm") Uhr</strong>.<br/>
                            Nach Ablauf der Frist teilt der Admin die Doppel-Paare zu.
                        </p>
                    }
                    else
                    {
                        <h4 class="user-join-title">Jetzt an der Einzel-Pyramide teilnehmen!</h4>
                        <p class="user-join-desc">Melde dich an, um in die Rangliste eingereiht zu werden und andere
                            herauszufordern.</p>
                    }
                </div>

                @if (!Model.IsCurrentUserInPyramid)
                {
                    @if (!Model.SelectedCompetition.IsSingle)
                    {
                        @if (Model.IsRegistrationOpen)
                        {
                            @if (!Model.IsCurrentUserRegisteredInPool)
                            {
                                <form method="post" asp-page-handler="RegisterSelf">
                                    <input type="hidden" name="competitionId" value="@Model.SelectedCompetition.Id"/>
                                    <button type="submit" class="btn-join">Für Doppel anmelden 🎾</button>
                                </form>
                            }
                            else
                            {
                                <div class="flex-center-gap">
                                    <span class="user-status-pill">Angemeldet im Pool</span>
                                    <form method="post" asp-page-handler="WithdrawSelfRegistration">
                                        <input type="hidden" name="competitionId"
                                               value="@Model.SelectedCompetition.Id"/>
                                        <button type="submit" class="btn-dark-pill btn-danger-pill"
                                                onclick="return confirm('Anmeldung stornieren?');">Stornieren
                                        </button>
                                    </form>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="user-status-pill pill-disabled">
                                🔒 Anmeldefrist abgelaufen
                            </div>
                        }
                    }
                    else
                    {
                        <form method="post" asp-page-handler="JoinPyramid" class="user-join-form">
                            <input type="hidden" name="competitionId" value="@Model.SelectedCompetition.Id"/>
                            <button type="submit" class="btn-join">Anmelden 🎾</button>
                        </form>
                    }
                }
                else
                {
                    <div class="user-status-pill">
                        <span>In Pyramide eingereiht</span>
                    </div>
                }
            </div>
        }

        <!-- 3. ACTIVE CHALLENGES SECTION -->
        @if (Model.ActiveChallenges.Any())
        {
            <div class="challenges-section">
                <h3 class="section-title">Offene Forderungen</h3>
                @foreach (var ch in Model.ActiveChallenges)
                {
                    bool isMyMatch = Model.CurrentPlayer != null &&
                                         (ch.ChallengerTeam.TeamPlayers.Any(p => p.PlayerId == Model.CurrentPlayer.Id) ||
                                          ch.DefenderTeam.TeamPlayers.Any(p => p.PlayerId == Model.CurrentPlayer.Id));

                    var cardVm = new MatchCardViewModel
                    {
                        MatchId = ch.Id,
                        Team1Name = ch.ChallengerTeam.PlayersToString(),
                        Team2Name = ch.DefenderTeam.PlayersToString(),
                        Team1Id = ch.ChallengerTeamId,
                        Team2Id = ch.DefenderTeamId,
                        BadgeText = $"{ch.ChallengeDate.ToString("dd.MM.yyyy")}",
                        IsAdmin = User.IsInRole("Admin"),
                        IsMyMatch = isMyMatch,
                        SaveHandler = "SaveMatch",
                        WalkoverHandler = "AdminWalkover",
                        GiveWalkoverHandler = "GiveWalkover",
                        DeleteHandler = "CancelChallenge",
                        DeleteButtonText = "Stornieren"
                    };

                    <partial name="_MatchScorecard" model="cardVm"/>
                }
            </div>
        }

        <!-- 4. RECENT CHALLENGES HISTORY -->
        @if (Model.PastChallenges.Any())
        {
            <div class="challenges-section challenges-section-history">
                <h3 class="section-title">Vergangene Forderungs-Matches</h3>
                @foreach (var ch in Model.PastChallenges)
                {
                    var challengerWon = ch.WinnerTeamId == ch.ChallengerTeamId;
                    var defenderWon = ch.WinnerTeamId == ch.DefenderTeamId;

                    var cardVm = new MatchCardViewModel
                    {
                        MatchId = ch.Id,
                        Team1Name = ch.ChallengerTeam.PlayersToString(),
                        Team2Name = ch.DefenderTeam.PlayersToString(),
                        Team1Score = challengerWon ? ch.Score : null,
                        Team2Score = defenderWon ? ch.Score : null,
                        IsTeam1Winner = challengerWon,
                        IsTeam2Winner = defenderWon,
                        BadgeText = $"{ch.MatchDate?.ToString("dd.MM.yyyy") ?? ch.ChallengeDate.ToString("dd.MM.yyyy")}"
                    };

                    <partial name="_MatchScorecard" model="cardVm"/>
                }
            </div>
        }

        <!-- 5. COMPETITION INFO & ADMIN FRIST CARD -->
        <section class="modern-card">
            <div class="competition-info-flex">
                <div class="competition-info-header-content">
                    <h2 class="competition-title">@Model.SelectedCompetition.Name - Details</h2>
                    <p class="registration-text">
                        Anmeldeschluss: <strong
                            class="text-dark">@Model.SelectedCompetition.RegistrationUntil.ToString("dd.MM.yyyy HH:mm")</strong>
                    </p>
                    @{
                        var registrationOpen = Model.SelectedCompetition.RegistrationUntil >= CityTime.GetViennaTimeZone();
                    }
                    <div class="competition-status-row">
                        @if (registrationOpen)
                        {
                            <span class="badge-open">Anmeldung offen</span>
                        }
                        else
                        {
                            <span class="badge-closed">Anmeldung geschlossen</span>
                        }
                        <span
                            class="badge-count">Spieler: @(Model.SelectedCompetition.IsSingle ? Model.RegisteredTeams.Count : Model.TournamentRegistrations.Count)</span>
                    </div>
                </div>

                <div class="competition-info-actions">
                    @if (User.IsInRole("Admin"))
                    {
                        <form method="post" asp-page-handler="SaveNewDate" class="admin-time-form">
                            <input type="hidden" name="competitionId" value="@Model.SelectedCompetition.Id"/>
                            <span class="admin-label">Admin:</span>
                            <input type="date" name="newDate"
                                   value="@Model.SelectedCompetition.RegistrationUntil.ToString("yyyy-MM-dd")"
                                   class="input-auto" required/>
                            <input type="time" name="newTime"
                                   value="@Model.SelectedCompetition.RegistrationUntil.ToString("HH:mm")"
                                   class="input-auto" required/>
                            <button type="submit" class="btn-dark-pill btn-admin-submit">Anmeldefrist aktualisieren
                            </button>
                        </form>
                    }
                </div>
            </div>

            @if (User.IsInRole("Admin"))
            {
                <hr class="dashed-divider"/>
                <div class="admin-player-bar">
                    <h5 class="admin-player-title">👤 Spieler anmelden (Admin)</h5>
                    <form method="post" asp-page-handler="AdminRegisterPlayer" class="admin-player-form">
                        <input type="hidden" name="competitionId" value="@Model.SelectedCompetition.Id"/>
                        <select name="playerId" class="form-input select-admin-player" required>
                            <option value="">-- Spieler auswählen --</option>
                            @foreach (var player in Model.UnregisteredPlayers)
                            {
                                <option value="@player.Id">@player.ToStringWithItn()</option>
                            }
                        </select>
                        <button type="submit" class="btn-dark-pill">➕ Spieler anmelden</button>
                    </form>
                </div>
            }
        </section>

        <!-- 6. POOL / DOUBLE PAIRS CONFIG (DOUBLES) -->
        @if (!Model.SelectedCompetition.IsSingle && Model.TournamentRegistrations.Any())
        {
            <div class="modern-card pool-card">
                <div class="card-header card-header-flex">
                    <h3 class="card-title-md">
                        🎾 Angemeldete Spieler im Pool (@Model.TournamentRegistrations.Count)
                    </h3>
                </div>

                <table class="participant-table">
                    <thead>
                    <tr>
                        <th class="th-rank">#</th>
                        <th>Spieler</th>
                        <th>ITN</th>
                        @if (User.IsInRole("Admin"))
                        {
                            <th class="th-action">Aktion</th>
                        }
                    </tr>
                    </thead>
                    <tbody>
                    @{ int poolCounter = 1; }
                    @foreach (var reg in Model.TournamentRegistrations)
                    {
                        <tr>
                            <td><strong>#@poolCounter</strong></td>
                            <td>@reg.Player.Firstname @reg.Player.Lastname</td>
                            <td>
                                    <span class="badge-count badge-itn">
                                        @(reg.Player.Itn.HasValue ? reg.Player.Itn.Value.ToString("0.0") : "-")
                                    </span>
                            </td>
                            @if (User.IsInRole("Admin"))
                            {
                                <td class="td-action-right">
                                    <form method="post" asp-page-handler="AdminRemoveRegistration"
                                          class="inline-form-zero">
                                        <input type="hidden" name="competitionId"
                                               value="@Model.SelectedCompetition.Id"/>
                                        <input type="hidden" name="playerId" value="@reg.PlayerId"/>
                                        <button type="submit" class="btn-danger btn-xs btn-action-micro"
                                                title="Aus Pool entfernen"
                                                onclick="return confirm('Spieler aus dem Anmelde-Pool entfernen?');">
                                            Entfernen 🗑️
                                        </button>
                                    </form>
                                </td>
                            }
                        </tr>
                        poolCounter++;
                    }
                    </tbody>
                </table>
            </div>
        }

        @if (!Model.SelectedCompetition.IsSingle)
        {
            var pairablePlayers = Model.TournamentRegistrations.Select(r => r.Player)
                .Concat(Model.RegisteredTeams.SelectMany(t => t.TeamPlayers.Select(tp => tp.Player)))
                .Concat(Model.AllPlayers)
                .DistinctBy(p => p.Id)
                .OrderBy(p => p.Lastname)
                .ThenBy(p => p.Firstname)
                .ToList();

            <partial name="Partials/_DoublePairsConfig" model='new TennisBruck.Pages.Partials.DoublePairsConfigViewModel
            {
                CompetitionId = Model.SelectedCompetition.Id,
                RegistrationUntil = Model.SelectedCompetition.RegistrationUntil,
                IsAdmin = User.IsInRole("Admin"),
                RegisteredPlayers = pairablePlayers,
                RegisteredTeams = Model.RegisteredTeams ?? new List<TennisDb.Team>()
            }'/>
        }

        <!-- 7. ADMIN PANEL FOR PARTICIPANTS -->
        @if (User.IsInRole("Admin"))
        {
            <div class="modern-card">
                <div class="card-header">
                    <h2>Teilnehmer-Verwaltung</h2>
                </div>

                @if (Model.PyramidLevels.Any())
                {
                    <table class="participant-table">
                        <thead>
                        <tr>
                            <th>Rang</th>
                            <th>Teilnehmer</th>
                            <th>Aktion</th>
                        </tr>
                        </thead>
                        <tbody>
                        @foreach (var level in Model.PyramidLevels)
                        {
                            @foreach (var node in level.Nodes)
                            {
                                <tr>
                                    <td><strong>#@node.PyramidRank.Rank</strong></td>
                                    <td>@node.PyramidRank.Team.PlayersToString()</td>
                                    <td>
                                        <form method="post" asp-page-handler="DeletePyramidRank"
                                              class="inline-form-zero"
                                              onsubmit="return confirm('Möchtest du diesen Teilnehmer wirklich aus der Pyramide entfernen?');">
                                            <input type="hidden" name="competitionId"
                                                   value="@Model.SelectedCompetition.Id"/>
                                            <input type="hidden" name="teamId" value="@node.PyramidRank.TeamId"/>
                                            <button type="submit" class="btn-danger btn-xs btn-action-micro"
                                                    title="Aus Pyramide entfernen">Entfernen
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        }
                        </tbody>
                    </table>
                }
                else
                {
                    <p class="text-muted">Noch keine Teilnehmer in dieser Pyramide.</p>
                }

                <div class="manual-add-wrapper">
                    <h4 class="manual-add-title">➕ Teilnehmer manuell zur Pyramide hinzufügen</h4>
                    <form method="post" asp-page-handler="AddTeam" class="manual-add-form">
                        <input type="hidden" name="competitionId" value="@Model.SelectedCompetition.Id"/>

                        <select name="player1Id" class="form-input flex-1" required>
                            <option value="">-- Spieler 1 wählen --</option>
                            @foreach (var player in Model.UnregisteredPlayers)
                            {
                                <option value="@player.Id">@player.ToString()</option>
                            }
                        </select>

                        @if (!Model.SelectedCompetition.IsSingle)
                        {
                            <select name="player2Id" class="form-input flex-1" required>
                                <option value="">-- Spieler 2 (Doppelpartner) wählen --</option>
                                @foreach (var player in Model.UnregisteredPlayers)
                                {
                                    <option value="@player.Id">@player.ToString()</option>
                                }
                            </select>
                        }

                        <button type="submit" class="btn-action btn-accent">+ Hinzufügen</button>
                    </form>
                </div>
            </div>
        }
    }
    else
    {
        <div class="empty-state">
            <h2>Keine Forderungspyramide vorhanden</h2>
            <p>Erstelle unten als Admin einen neuen Bewerb, um zu starten.</p>
        </div>
    }

    <!-- 8. ADMIN STRIP BOTTOM (CREATE / DELETE COMPETITION) -->
    <partial name="_AdminStrip" model='(Model.SelectedCompetition?.Id, "Neuer Pyramiden-Bewerb Name")'/>

</main>

<script>
    function openResultModal(challengeId, challengerName, challengerId, defenderName, defenderId) {
        document.getElementById('modalChallengeId').value = challengeId;

        var select = document.getElementById('modalWinnerSelect');
        select.innerHTML = '';

        var opt1 = document.createElement('option');
        opt1.value = challengerId;
        opt1.textContent = challengerName + ' (Forderer - übernimmt Rang bei Sieg)';

        var opt2 = document.createElement('option');
        opt2.value = defenderId;
        opt2.textContent = defenderName + ' (Geforderter - verteidigt Rang)';

        select.appendChild(opt1);
        select.appendChild(opt2);

        document.getElementById('resultModal').style.display = 'flex';
    }

    function closeResultModal() {
        document.getElementById('resultModal').style.display = 'none';
    }
</script>

<partial name="_PwaScripts"/>
</body>
</html>
