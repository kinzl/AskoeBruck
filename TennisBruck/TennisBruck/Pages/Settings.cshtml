@page
@model TennisBruck.Pages.Settings

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Einstellungen | TennisBruck</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true">
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <form method="post" class="m-0">
            <button type="submit" asp-page-handler="Back" class="btn-back-header">
                ← Übersicht
            </button>
        </form>
    </div>

    <h1 class="app-title">⚙️ Einstellungen</h1>
    <p class="header-subtitle">Verwalte deine persönlichen Daten und Einstellungen</p>
</header>

<main class="main-container">

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-info">
            @Model.Message
        </div>
    }

    <div class="settings-grid">

        <section class="modern-card">
            <div class="card-header-flex">
                <div class="icon-box">👤</div>
                <h2>Persönliche Daten</h2>
            </div>

            <form method="post" asp-page-handler="ChangeSettings" class="form-col-flex">

                <div class="form-row">
                    <div class="form-group mb-0">
                        <label for="Firstname">Vorname</label>
                        <input type="text" id="Firstname" name="Firstname" value="@Model.CurrentPlayer.Firstname"
                               required
                               class="form-input">
                    </div>
                    <div class="form-group mb-0">
                        <label for="Lastname">Nachname</label>
                        <input type="text" id="Lastname" name="Lastname" value="@Model.CurrentPlayer.Lastname" required
                               class="form-input">
                    </div>
                </div>

                <div class="form-group">
                    <label for="EmailOrPhone">E-Mail Adresse</label>
                    <input type="email" id="EmailOrPhone" name="EmailOrPhone"
                           value="@Model.CurrentPlayer.IdentityUser?.Email"
                           required class="form-input">
                </div>

                <div class="form-group mt-15">
                    <label for="NuLigaPlayerUrl">ÖTV Profil URL (Optional)</label>
                    <input type="url" id="NuLigaPlayerUrl" name="NuLigaPlayerUrl"
                           value="@Model.CurrentPlayer.NuLigaPlayerUrl"
                           class="form-input" placeholder="https://www.oetv.at/spieler/NU...">
                    <small class="form-help-text">
                        Dieser Link führt zu deinem Spielerprofil auf der ÖTV Verbandsseite. (Freiwillig)
                    </small>
                </div>

                <button type="submit" class="btn-action btn-accent mt-15">Daten Speichern</button>
            </form>
        </section>

        <section class="modern-card">
            <div class="card-header-flex">
                <div class="icon-box">🔒</div>
                <h2>Passwort ändern</h2>
            </div>

            <form method="post" asp-page-handler="ChangePassword" class="form-col-flex">

                <div class="form-group">
                    <label for="OldPassword">Altes Passwort</label>
                    <input id="OldPassword" name="oldPassword" type="password" required class="form-input">
                </div>

                <div class="form-group">
                    <label for="NewPassword">Neues Passwort</label>
                    <input id="NewPassword" name="newPassword" type="password" required class="form-input">
                </div>

                <div class="form-group mb-30">
                    <label for="NewPasswordRepeat">Neues Passwort wiederholen</label>
                    <input id="NewPasswordRepeat" name="newPasswordRepeat" type="password" required class="form-input">
                </div>

                <button type="submit" class="btn-action">Passwort aktualisieren</button>
            </form>
        </section>

        <section class="modern-card" style="border-left: 4px solid var(--danger-color, #ef4444);">
            <div class="card-header-flex">
                <div class="icon-box" style="background:#fee2e2;color:#ef4444;">⚠️</div>
                <h2 style="color: var(--danger-color, #ef4444);">Profil löschen</h2>
            </div>

            <p class="form-help-text" style="display:block;margin-bottom:15px;line-height:1.4;">
                Hier kannst du dein Profil deaktivieren. Du wirst aus allen aktiven Ansichten entfernt und sofort
                abgemeldet. Dieser Vorgang kann nicht eigenständig rückgängig gemacht werden.
            </p>

            <form method="post" asp-page-handler="DeleteProfile" class="form-col-flex" style="margin-top:auto;">
                <button type="submit" class="btn-action"
                        style="background-color:var(--danger-color, #ef4444); color:white; width: 100%; transition: opacity 0.2s;"
                        onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1"
                        onclick="return confirm('Möchtest du dein Profil wirklich deaktivieren? Du wirst sofort abgemeldet und dies ist endgültig!');">
                    Mein Profil löschen
                </button>
            </form>
        </section>

    </div>
</main>

</body>
</html>