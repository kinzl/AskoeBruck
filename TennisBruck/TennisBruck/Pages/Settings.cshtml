@page
@model TennisBruck.Pages.Settings

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Einstellungen</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true">
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <form method="post" class="m-0">
            <button type="submit" asp-page-handler="Back" class="btn-back-header">
                ← Übersicht
            </button>
        </form>
    </div>

    <h1 class="app-title">Einstellungen</h1>
    <p class="header-subtitle">Verwalte deine persönlichen Daten und Einstellungen</p>
</header>

<main class="main-container">

    @if (!string.IsNullOrEmpty(Model.Message))
    {
        <div class="alert-info">
            @Model.Message
        </div>
    }

    <div class="settings-grid">

        <section class="modern-card">
            <div class="card-header-flex">
                <div class="icon-box">👤</div>
                <h2>Persönliche Daten</h2>
            </div>

            <form method="post" asp-page-handler="ChangeSettings" class="form-col-flex">

                <div class="form-row">
                    <div class="form-group mb-0">
                        <label for="Firstname">Vorname</label>
                        <input type="text" id="Firstname" name="Firstname" value="@Model.CurrentPlayer.Firstname"
                               required
                               class="form-input">
                    </div>
                    <div class="form-group mb-0">
                        <label for="Lastname">Nachname</label>
                        <input type="text" id="Lastname" name="Lastname" value="@Model.CurrentPlayer.Lastname" required
                               class="form-input">
                    </div>
                </div>

                <div class="form-group">
                    <label for="EmailOrPhone">E-Mail Adresse</label>
                    <input type="email" id="EmailOrPhone" name="EmailOrPhone"
                           value="@Model.CurrentPlayer.IdentityUser?.Email"
                           required class="form-input">
                </div>

                <div class="form-group mt-15">
                    <label for="NuLigaPlayerUrl">ÖTV Profil URL (Optional)</label>
                    <input type="url" id="NuLigaPlayerUrl" name="NuLigaPlayerUrl"
                           value="@Model.CurrentPlayer.NuLigaPlayerUrl"
                           class="form-input" placeholder="https://www.oetv.at/spieler/NU...">
                    <small class="form-help-text">
                        Dieser Link führt zu deinem Spielerprofil auf der ÖTV Verbandsseite. Durch den Link kann deine
                        ITN auf dieser Seite hinzugefügt werden.
                    </small>
                </div>
                <button type="submit" class="btn-action btn-accent mt-15">Daten Speichern</button>
            </form>
        </section>

        <section class="modern-card">
            <div class="card-header-flex">
                <div class="icon-box">🔒</div>
                <h2>Passwort ändern</h2>
            </div>

            <form method="post" asp-page-handler="ChangePassword" class="form-col-flex">

                <div class="form-group">
                    <label for="OldPassword">Altes Passwort</label>
                    <input id="OldPassword" name="oldPassword" type="password" required class="form-input">
                </div>

                <div class="form-group">
                    <label for="NewPassword">Neues Passwort</label>
                    <input id="NewPassword" name="newPassword" type="password" required class="form-input">
                </div>

                <div class="form-group mb-30">
                    <label for="NewPasswordRepeat">Neues Passwort wiederholen</label>
                    <input id="NewPasswordRepeat" name="newPasswordRepeat" type="password" required class="form-input">
                </div>
                <button type="submit" class="btn-action">Passwort aktualisieren</button>
            </form>
        </section>

        <section class="modern-card">
            <div class="card-header-flex">
                <div class="icon-box">📧</div>
                <h2>E-Mail Benachrichtigungen</h2>
            </div>

            <form method="post" asp-page-handler="SaveNotificationSettings" class="form-col-flex">
                <p class="form-help-text mb-30" style="line-height:1.4;">
                    Wähle aus, bei welchen Ereignissen du per E-Mail informiert werden möchtest.
                </p>

                <div class="notification-item">
                    <div class="notification-info">
                        <span class="notification-title">K.O. Gegner bekannt</span>
                        <span class="notification-desc">Sobald dein nächster Genger in der Vereinsmeisterschaft feststeht.</span>
                    </div>
                    <label class="switch">
                        <input type="checkbox" asp-for="CurrentPlayer.NotificationSettings.EmailOnOpponentAssigned"/>
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="notification-item">
                    <div class="notification-info">
                        <span class="notification-title">Spielpartner-Suche vollständig</span>
                        <span class="notification-desc">Wenn dein Spielersuche-Eintrag vollzählig besetzt ist.</span>
                    </div>
                    <label class="switch">
                        <input type="checkbox" asp-for="CurrentPlayer.NotificationSettings.EmailOnSlotFull"/>
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="notification-item">
                    <div class="notification-info">
                        <span class="notification-title">Spielpartner-Suche gelöscht</span>
                        <span class="notification-desc">Wenn ein Börsenspiel, bei dem du dich eingetragen hast, abgesagt wird.</span>
                    </div>
                    <label class="switch">
                        <input type="checkbox" asp-for="CurrentPlayer.NotificationSettings.EmailOnSlotCancelled"/>
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="notification-item">
                    <div class="notification-info">
                        <span class="notification-title">Spielpartner-Suche Teilnahme</span>
                        <span class="notification-desc">Wenn sich ein Spieler für deine Spielersuche anmeldet.</span>
                    </div>
                    <label class="switch">
                        <input type="checkbox" asp-for="CurrentPlayer.NotificationSettings.EmailOnSlotJoined"/>
                        <span class="slider"></span>
                    </label>
                </div>

                <div class="notification-item mb-30">
                    <div class="notification-info">
                        <span class="notification-title">Pyramide-Forderung erhalten</span>
                        <span class="notification-desc">Sobald dich ein anderer Spieler in der Pyramide herausfordert.</span>
                    </div>
                    <label class="switch">
                        <input type="checkbox" asp-for="CurrentPlayer.NotificationSettings.EmailOnPyramidChallenge"/>
                        <span class="slider"></span>
                    </label>
                </div>

                <button type="submit" class="btn-action btn-accent">Einstellungen Speichern</button>
            </form>
        </section>

        <section class="modern-card">
            <div class="card-header-flex">
                <div class="icon-box" style="background:#e0e7ff;color:#4f46e5;">🔔</div>
                <h2>Push-Benachrichtigungen (PWA & Desktop)</h2>
            </div>

            <p class="form-help-text" style="display:block;margin-bottom:15px;line-height:1.4;">
                Erhalte direkte Benachrichtigungen auf dein Smartphone oder deinen PC (z.B. bei neuen Pyramiden-Forderungen, PartnerBoard-Matches oder Vereinsmeisterschafts-Gegnern).
            </p>

            <div id="push-status-container" style="display:flex;align-items:center;justify-content:space-between;padding:12px 16px;background:#f8fafc;border:1px solid #e2e8f0;border-radius:var(--border-radius-sm, 8px);margin-bottom:18px;">
                <span style="font-weight:600;font-size:0.95rem;">Status auf diesem Gerät:</span>
                <span id="push-status-badge" style="font-size:0.85rem;font-weight:700;padding:4px 10px;border-radius:12px;background:#e2e8f0;color:#64748b;">
                    Wird geprüft...
                </span>
            </div>

            <div id="push-alert" style="display:none;padding:10px 14px;border-radius:8px;margin-bottom:15px;font-size:0.9rem;"></div>

            <div style="display:flex;gap:10px;flex-wrap:wrap;">
                <button type="button" id="btn-enable-push" class="btn-action btn-accent" style="flex:1;min-width:180px;">
                    🔔 Auf diesem Gerät aktivieren
                </button>
                <button type="button" id="btn-test-push" class="btn-action" style="background:#0f172a;color:white;flex:1;min-width:180px;display:none;">
                    🎾 Test-Push senden
                </button>
                <button type="button" id="btn-disable-push" class="btn-action" style="background:#fee2e2;color:#ef4444;border:1px solid #fecaca;display:none;">
                    Deaktivieren
                </button>
            </div>
            <small class="form-help-text mt-15" style="display:block;color:#94a3b8;">
                Hinweis für iPhone/iPad: Öffne die Website im Safari und wähle "Zum Home-Bildschirm", um Push-Mitteilungen wie eine App zu empfangen.
            </small>
        </section>

        <section class="modern-card" style="border-left: 4px solid var(--danger-color, #ef4444);">
            <div class="card-header-flex">
                <div class="icon-box" style="background:#fee2e2;color:#ef4444;">⚠️</div>
                <h2 style="color: var(--danger-color, #ef4444);">Profil löschen</h2>
            </div>

            <p class="form-help-text" style="display:block;margin-bottom:15px;line-height:1.4;">
                Hier kannst du dein Profil löschen.
            </p>

            <form method="post" asp-page-handler="DeleteProfile" class="form-col-flex" style="margin-top:auto;">
                <button type="submit" class="btn-action"
                        style="background-color:var(--danger-color, #ef4444); color:white; width: 100%; transition: opacity 0.2s;"
                        onmouseover="this.style.opacity=0.8" onmouseout="this.style.opacity=1"
                        onclick="return confirm('Möchtest du dein Profil wirklich löschen? Du wirst sofort abgemeldet und dies ist endgültig!');">
                    Mein Profil löschen
                </button>
            </form>
        </section>

    </div>
</main>

<script src="~/js/pushNotifications.js" asp-append-version="true"></script>
<script>
    document.addEventListener('DOMContentLoaded', async () => {
        const badge = document.getElementById('push-status-badge');
        const btnEnable = document.getElementById('btn-enable-push');
        const btnTest = document.getElementById('btn-test-push');
        const btnDisable = document.getElementById('btn-disable-push');
        const alertBox = document.getElementById('push-alert');

        function showAlert(msg, isSuccess) {
            alertBox.style.display = 'block';
            alertBox.style.background = isSuccess ? '#ecfdf5' : '#fef2f2';
            alertBox.style.color = isSuccess ? '#065f46' : '#991b1b';
            alertBox.style.border = isSuccess ? '1px solid #a7f3d0' : '1px solid #fecaca';
            alertBox.innerText = msg;
        }

        async function updateStatus() {
            if (!window.TennisPush) return;
            const support = window.TennisPush.getSupportDetails ? window.TennisPush.getSupportDetails() : { supported: window.TennisPush.isSupported() };

            if (!support.supported) {
                badge.innerText = support.isIOSNonStandalone ? 'Home-Bildschirm nötig' : 'Nicht unterstützt';
                badge.style.background = '#fef3c7';
                badge.style.color = '#92400e';
                showAlert(support.reason, false);
                btnEnable.disabled = false;
                return;
            }

            if (Notification.permission === 'denied') {
                badge.innerText = 'Im Browser blockiert';
                badge.style.background = '#fee2e2';
                badge.style.color = '#ef4444';
                btnEnable.style.display = 'none';
                btnTest.style.display = 'none';
                btnDisable.style.display = 'none';
                showAlert("Benachrichtigungen sind für diese Website im Browser blockiert. Bitte erlaube Benachrichtigungen in den Website-Einstellungen deines Browsers.", false);
                return;
            }

            try {
                const sub = await window.TennisPush.getSubscription();
                if (sub) {
                    badge.innerText = 'Aktiviert ✓';
                    badge.style.background = '#dcfce7';
                    badge.style.color = '#15803d';
                    btnEnable.style.display = 'none';
                    btnTest.style.display = 'inline-block';
                    btnDisable.style.display = 'inline-block';
                } else {
                    badge.innerText = 'Nicht aktiv';
                    badge.style.background = '#f1f5f9';
                    badge.style.color = '#64748b';
                    btnEnable.style.display = 'inline-block';
                    btnTest.style.display = 'none';
                    btnDisable.style.display = 'none';
                }
            } catch (e) {
                console.error('Push status error:', e);
            }
        }

        btnEnable.addEventListener('click', async () => {
            btnEnable.disabled = true;
            btnEnable.innerText = 'Wird aktiviert...';
            try {
                await window.TennisPush.subscribe();
                showAlert('Push-Benachrichtigungen wurden erfolgreich auf diesem Gerät aktiviert!', true);
                await updateStatus();
            } catch (err) {
                showAlert(err.message || 'Fehler beim Aktivieren von Push-Benachrichtigungen.', false);
                btnEnable.disabled = false;
                btnEnable.innerText = '🔔 Auf diesem Gerät aktivieren';
            }
        });

        btnDisable.addEventListener('click', async () => {
            try {
                await window.TennisPush.unsubscribe();
                showAlert('Push-Benachrichtigungen wurden auf diesem Gerät deaktiviert.', true);
                await updateStatus();
            } catch (err) {
                showAlert('Fehler beim Deaktivieren.', false);
            }
        });

        btnTest.addEventListener('click', async () => {
            btnTest.disabled = true;
            btnTest.innerText = 'Wird gesendet...';
            try {
                const ok = await window.TennisPush.sendTestNotification();
                if (ok) {
                    showAlert('Test-Benachrichtigung wurde versendet! Prüfe dein Benachrichtigungscenter.', true);
                } else {
                    showAlert('Konnte keine Benachrichtigung zustellen (kein aktives Gerät gefunden).', false);
                }
            } catch (err) {
                showAlert(err.message, false);
            } finally {
                btnTest.disabled = false;
                btnTest.innerText = '🎾 Test-Push senden';
            }
        });

        await updateStatus();
    });
</script>
</body>
</html>