@page
@model TennisBruck.Pages.Settings

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Einstellungen | TennisBruck</title>

    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/css/settings.css" asp-append-version="true">
</head>
<body>

<header class="app-header">
    <div class="header-top-bar">
        <form method="post" style="margin: 0;">
            <button type="submit" asp-page-handler="Back" class="btn-back-header">
                ← Übersicht
            </button>
        </form>
    </div>

    <h1 class="app-title">⚙️ Einstellungen</h1>
    <p style="color: var(--text-muted); margin-top: 10px;">Verwalte deine persönlichen Daten und
        Sicherheitseinstellungen</p>
</header>

<main class="main-container">

    @if (!string.IsNullOrEmpty(Model.InfoText))
    {
        <div class="alert-info">
            @Model.InfoText
        </div>
    }

    <div class="settings-grid">

        <section class="modern-card">
            <div class="card-header-flex">
                <div class="icon-box">👤</div>
                <h2>Persönliche Daten</h2>
            </div>

            <form method="post" asp-page-handler="ChangeSettings"
                  style="display: flex; flex-direction: column; flex-grow: 1;">

                <div class="form-row">
                    <div class="form-group" style="margin-bottom: 0;">
                        <label for="Firstname">Vorname</label>
                        <input type="text" id="Firstname" name="Firstname" value="@Model.CurrentPlayer.Firstname" required
                               class="form-input">
                    </div>
                    <div class="form-group" style="margin-bottom: 0;">
                        <label for="Lastname">Nachname</label>
                        <input type="text" id="Lastname" name="Lastname" value="@Model.CurrentPlayer.Lastname" required
                               class="form-input">
                    </div>
                </div>

                <div class="form-group">
                    <label for="EmailOrPhone">E-Mail Adresse</label>
                    <input type="email" id="EmailOrPhone" name="EmailOrPhone" value="@Model.CurrentPlayer.IdentityUser?.Email"
                           required class="form-input">
                </div>

                <div class="form-group" style="margin-bottom: 30px;">
                    <label for="Username">Benutzername</label>
                    <input type="text" id="Username" name="Username" value="@Model.CurrentPlayer.Username" required
                           class="form-input">
                </div>

                <button type="submit" class="btn-action btn-accent">Daten Speichern</button>
            </form>
        </section>

        <section class="modern-card">
            <div class="card-header-flex">
                <div class="icon-box">🔒</div>
                <h2>Passwort ändern</h2>
            </div>

            <form method="post" asp-page-handler="ChangePassword"
                  style="display: flex; flex-direction: column; flex-grow: 1;">

                <div class="form-group">
                    <label for="OldPassword">Altes Passwort</label>
                    <input id="OldPassword" name="oldPassword" type="password" required class="form-input">
                </div>

                <div class="form-group">
                    <label for="NewPassword">Neues Passwort</label>
                    <input id="NewPassword" name="newPassword" type="password" required class="form-input">
                </div>

                <div class="form-group" style="margin-bottom: 30px;">
                    <label for="NewPasswordRepeat">Neues Passwort wiederholen</label>
                    <input id="NewPasswordRepeat" name="newPasswordRepeat" type="password" required class="form-input">
                </div>

                <button type="submit" class="btn-action">Passwort aktualisieren</button>
            </form>
        </section>

    </div>
</main>

</body>
</html>