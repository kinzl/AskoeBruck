<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TennisBruck</title>

    <partial name="_PwaHeaders"/>
    <link rel="stylesheet" href="~/css/layout.css" asp-append-version="true" />
</head>
<body class="d-flex flex-column min-vh-100">

<main role="main" class="pb-3 flex-grow-1">
    @RenderBody()
</main>

<partial name="_PwaScripts"/>
@await RenderSectionAsync("Scripts", required: false)

<footer class="site-footer">
    <div class="container">
        <p class="footer-copy">&copy; 2026 Tennis Club ASKÖ Bruck-Peuerbach. Alle Rechte vorbehalten.</p>

        <div class="flex-center-gap footer-links">
            <a asp-page="/Impressum">Impressum</a>
            <span>|</span>
            <a asp-page="/DataProtection">Datenschutz</a>
            <span>|</span>
            <a asp-page="/AGB">Platzordnung / AGB</a>
        </div>
    </div>
</footer>
</body>
</html>