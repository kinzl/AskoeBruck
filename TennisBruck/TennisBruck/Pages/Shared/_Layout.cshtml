<!DOCTYPE html>
<html lang="de">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - TennisBruck</title>

    <partial name="_PwaHeaders"/>
</head>
<body class="d-flex flex-column min-vh-100">

<main role="main" class="pb-3 flex-grow-1">
    @RenderBody()
</main>

<partial name="_PwaScripts"/>
@await RenderSectionAsync("Scripts", required: false)

<footer class="site-footer">
    <div class="container">
        <p style="margin-bottom: 8px;">&copy; 2026 Tennis Club ASKÖ Bruck-Peuerbach. Alle Rechte vorbehalten.</p>

        <div class="flex-center-gap" style="justify-content: center;">
            <a asp-page="/Impressum">Impressum</a>
            <span>|</span>
            <a asp-page="/DataProtection">Datenschutz</a>
            <span>|</span>
            <a asp-page="/AGB">Platzordnung / AGB</a>
        </div>
    </div>
</footer>
</body>
</html>
<style>
    .site-footer {
        text-align: center;
        padding: 1.5rem 0;
        width: 100%;
        margin-top: auto;
        font-size: 0.875rem;
        color: #6c757d; /* Ein schönes, dezentes Grau */
    }

    .site-footer a {
        color: #6c757d;
        text-decoration: none;
    }

    .site-footer a:hover {
        color: #212529; /* Wird beim Drüberfahren dunkel */
        text-decoration: underline;
    }
</style>