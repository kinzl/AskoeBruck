{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "NeonDb": "Host=neonDbHost; Database=myDatabase; Username=neonDbUsername; Password=neonDbPassword; SSL Mode=VerifyFull; Channel Binding=Require;",
    "TennisDbSqlite": "data source=|DataDirectory|\\TennisDb.sqlite",
    "PostgresSql": "Host=localhost;Port=5432;Database=myDatabase;Username=myUsername;Password=myPassword;Pooling=true;",
    "ApplicationDbContextConnection": "Server=(localdb)\\mssqllocaldb;Database=TennisBruck;Trusted_Connection=True;MultipleActiveResultSets=true",
    "TennisContextConnection": "Server=(localdb)\\mssqllocaldb;Database=TennisBruck;Trusted_Connection=True;MultipleActiveResultSets=true"
  }
}